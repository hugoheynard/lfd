{
  "name": "lafoliedouce-monorepo",
  "version": "1.0.0",
  "author": "Hugo Heynard",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true; node dev-toolbox/graphify/install-graphify.mjs || true",
    "dev": "turbo run dev",
    "dev:apps": "bash dev-toolbox/dev-stack.sh --filter=lfc-ecommerce-frontend... --filter=lfd-backoffice-frontend... --filter=lfd-api...",
    "dev:infra": "node dev-toolbox/ensure-docker.mjs && node dev-toolbox/ensure-map-data.mjs && docker compose --env-file apps/lfd-route-planner/osrm-version.env -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose --env-file apps/lfd-route-planner/osrm-version.env -f docker-compose.dev.yml down",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:gates": "node lint/run.mjs all",
    "lint:watch": "node lint/run.mjs watch",
    "gate": "node lint/run.mjs gate",
    "tool": "node lint/run.mjs tool",
    "docs": "node dev-toolbox/obsidian/open-docs.mjs"
  },
  "devDependencies": {
    "@lfd/endpoints": "workspace:*",
    "jsdom": "catalog:",
    "lint-staged": "^17.3.0",
    "mermaid": "^11.12.0",
    "prettier": "catalog:",
    "turbo": "^2.5.0",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  }
}
