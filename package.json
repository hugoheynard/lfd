{
  "name": "lafoliedouce-monorepo",
  "version": "1.0.0",
  "author": "Hugo Heynard",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "turbo run build",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:nuke": "docker compose -f docker-compose.dev.yml down -v",
    "dev": "turbo run dev",
    "suite:dev": "turbo run dev --filter=lfc-suite-shell --filter=lfc-pim-frontend",
    "suite:dev:full": "pnpm dev:infra && turbo run dev --filter=lfc-suite-shell --filter=lfc-pim-frontend --filter=lfc-pim-backend --filter=lfc-b2b-platform-frontend --filter=lfc-b2b-platform-backend",
    "suite:status": "node dev-toolbox/suite-status.mjs",
    "lfc-suite:dev:watch": "turbo run dev --filter=lfc-pim-frontend --filter=lfc-pim-backend",
    "lint": "turbo run lint",
    "lint:no-direct-env": "node dev-toolbox/gates/no-direct-env.mjs",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@lfd/endpoints": "workspace:*",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3"
  }
}
