{
  "name": "lafoliedouce-monorepo",
  "version": "1.0.0",
  "author": "Hugo Heynard",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "setup:hooks": "git config core.hooksPath .githooks",
    "build": "turbo run build",
    "dev:infra": "node dev-toolbox/ensure-docker.mjs && docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:nuke": "docker compose -f docker-compose.dev.yml down -v",
    "db:dev:sync": "node dev-toolbox/migrate-dev-db.mjs",
    "dev": "turbo run dev",
    "dev:apps": "node dev-toolbox/fresh-vite-deps.mjs && pnpm dev:infra && pnpm db:dev:sync && (node dev-toolbox/suite-ready.mjs &) && (node dev-toolbox/restart-api-on-package-build.mjs &) && turbo run dev dev:watch --output-logs=new-only --concurrency=20 --filter=lfc-b2b-platform-frontend... --filter=lfc-b2b-admin-frontend... --filter=lfd-api...",
    "dev:gateway": "node dev-toolbox/fresh-vite-deps.mjs && pnpm dev:infra && pnpm db:dev:sync && (SUITE_URL=http://b2b-admin.localhost:8787 node dev-toolbox/suite-ready.mjs &) && (node dev-toolbox/restart-api-on-package-build.mjs &) && turbo run dev dev:watch --output-logs=new-only --concurrency=20 --filter=lfd-gateway... --filter=lfc-b2b-platform-frontend... --filter=lfd-api... --filter=lfc-b2b-admin-frontend...",
    "dev:status": "node dev-toolbox/suite-status.mjs",
    "dev:watch": "turbo run dev --filter=lfc-b2b-admin-frontend --filter=lfd-api",
    "lint": "turbo run lint",
    "lint:no-direct-env": "node dev-toolbox/gates/no-direct-env.mjs",
    "lint:events-tracked": "node dev-toolbox/gates/events-tracked.mjs",
    "lint:fold-tokens": "node dev-toolbox/gates/fold-tokens.mjs",
    "lint:router-links": "node dev-toolbox/gates/router-links.mjs",
    "lint:pim-data-neutral": "node dev-toolbox/gates/pim-data-neutral.mjs",
    "lint:import-cycles": "node dev-toolbox/gates/import-cycles.mjs",
    "lint:journal-tracked": "node dev-toolbox/gates/journal-tracked.mjs",
    "lint:context-boundaries": "node dev-toolbox/gates/context-boundaries.mjs",
    "lint:cross-schema-join": "node dev-toolbox/gates/cross-schema-join.mjs",
    "lint:code-language": "node dev-toolbox/gates/code-language.mjs",
    "lint:catalog-shared-deps": "node dev-toolbox/gates/catalog-shared-deps.mjs",
    "lint:deployed-app-files": "node dev-toolbox/gates/deployed-app-files.mjs",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "lint:test-dates": "node dev-toolbox/gates/test-dates.mjs",
    "lint:fold-typography": "node dev-toolbox/gates/fold-typography.mjs"
  },
  "devDependencies": {
    "@lfd/endpoints": "workspace:*",
    "lint-staged": "^17.3.0",
    "prettier": "catalog:",
    "turbo": "^2.5.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  }
}
