  "devDependencies": {
    "@angular/common": "catalog:",
    "@angular/core": "catalog:",
    "@eslint/js": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
