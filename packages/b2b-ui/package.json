{
  "name": "@lfd/b2b-ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    "./flags": {
      "types": "./src/flags.ts",
      "default": "./src/flags.ts"
    },
    "./appointment": {
      "types": "./src/appointment/index.ts",
      "default": "./src/appointment/index.ts"
    },
    "./company": {
      "types": "./src/company/index.ts",
      "default": "./src/company/index.ts"
    },
    "./order": {
      "types": "./src/order/index.ts",
      "default": "./src/order/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog/index.ts",
      "default": "./src/catalog/index.ts"
    },
    "./cart": {
      "types": "./src/cart/index.ts",
      "default": "./src/cart/index.ts"
    },
    "./subscription": {
      "types": "./src/subscription/index.ts",
      "default": "./src/subscription/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
