  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "eslint": "^9.28.0",
    "eslint-plugin-prettier": "^5.4.1",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.34.0"
  }
