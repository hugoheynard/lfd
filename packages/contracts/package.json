{
  "name": "@lfd/contracts",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./content-values": {
      "types": "./src/platform-content.defaults.ts",
      "import": "./dist/platform-content.defaults.js",
      "require": "./dist/platform-content.defaults.js"
    },
    "./feature-access-levels": {
      "types": "./src/feature-access.levels.ts",
      "import": "./dist/feature-access.levels.js",
      "require": "./dist/feature-access.levels.js"
    },
    "./workspace": {
      "types": "./src/workspace.ts",
      "import": "./dist/workspace.js",
      "require": "./dist/workspace.js"
    },
    "./shop-values": {
      "types": "./src/shop-values.ts",
      "import": "./dist/shop-values.js",
      "require": "./dist/shop-values.js"
    },
    "./journal-facts": {
      "types": "./src/journal-facts/index.ts",
      "import": "./dist/journal-facts/index.js",
      "require": "./dist/journal-facts/index.js"
    }
  },
  "private": true,
  "scripts": {
    "dev:watch": "tsc -b tsconfig.json --watch",
    "build": "tsc -b tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint src",
    "lint:ci": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "catalog:",
    "prettier": "catalog:",
    "ts-jest": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
