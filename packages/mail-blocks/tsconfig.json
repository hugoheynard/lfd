{
  // Le contrat de l'éditeur d'e-mails par blocs (plan
  // `documentation/mail/plan-editeur-par-blocs.md`, S4a) — pur,
  // sans dépendance : importé par l'API et le back-office SEULEMENT, jamais par
  // `@lfd/contracts`, que la boutique charge. Feuille du graphe.
  "extends": "../../tsconfig/tsflags.backend.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.spec.ts", "**/__tests__/**"]
}
