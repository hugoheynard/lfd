#!/bin/sh
# Ce qui doit être vrai AVANT un push — et davantage avant une promotion.
#
# ── Pourquoi ici et pas au commit ───────────────────────────────────────────
# Le `pre-commit` d'à côté ne fait que formater, et son commentaire dit
# pourquoi : un commit qui prend trente secondes finit contourné au
# `--no-verify`. Un push est cent fois plus rare, et c'est lui qui engage.
#
# ── Deux niveaux, parce qu'il y a deux gestes ───────────────────────────────
# `dev` ne déploie RIEN : la CI y tourne, et c'est elle qui juge. Le hook n'y
# fait que les portes du dépôt (`pnpm lint:gates`) et les typechecks de ce qui
# a changé — ce qui casse le plus souvent la CI, pour quelques dizaines de
# secondes.
#
# `main` DÉPLOIE. Une promotion vers `main` (`git push origin dev:main`) pousse
# exactement le `dev` publié ; le hook vérifie que c'est bien lui, et lit ce
# que la CI a dit de ce commit. Il ne relance rien sur le disque (voir plus bas).

# ── Ce qui reste en CI ──────────────────────────────────────────────────────
# Le typecheck et l'ESLint type-aware de `lfd-api` coûtent près d'une minute, et
# les tests bien davantage. Les mettre ici ferait ce que le `pre-commit` refuse.
#
# Contourner reste possible — `git push --no-verify` — et c'est voulu : un
# garde-fou qu'on ne peut pas franchir devient un obstacle qu'on démonte.
#
# S'installe seul au `pnpm install` (script `prepare`).
set -e

# ── Les typechecks, SUR CE QUI A CHANGÉ ─────────────────────────────────────
#
# Mesurés sur une machine de dev : 5,9 s pour l'app backend, 2,4 s pour ses
# specs, 3,5 s et 2,2 s pour les deux fronts. Une dizaine de secondes en tout,
# et c'est la classe d'échec qui a le plus cassé la CI — le 2026-08-29, le
# typecheck des SPECS de `lfd-api` l'a mise au rouge sur un `execute()` appelé
# avec un argument de trop. Les specs ont leur PROPRE tsconfig, donc un
# `tsc --noEmit` ordinaire ne les lit pas : exactement le trou qu'une porte doit
# couvrir.
#
# ⚠️ Pas d'ESLint ici, et c'est un choix MESURÉ, pas une omission : 22 s à lui
# seul sur `lfd-api`, et aucun échec de CI à son actif dans la journée qui a
# motivé ce hook. Le formatage — l'autre casseur historique — est déjà pris au
# `pre-commit`. On paie pour ce qui casse, pas pour ce qui pourrait casser.
changed_files() {
  # Le sha distant vaut quarante zéros quand la branche n'existe pas encore en
  # face : on compare alors à `origin/main`, la seule base commune sûre.
  case "$1" in
    0000000000000000000000000000000000000000 | "") git diff --name-only origin/main "$2" ;;
    *) git diff --name-only "$1" "$2" ;;
  esac
}

typecheck_if_touched() {
  # $1 = préfixe de chemin · $2 = libellé · $3.. = commande
  prefix="$1"
  label="$2"
  shift 2
  # `packages/` déclenche TOUS les typechecks : un contrat partagé qui change
  # casse ses consommateurs, et c'est précisément là que le compilateur sert. Le
  # dépôt a déjà payé cette leçon — vert côté paquet, rouge côté app, découvert
  # après le push.
  if printf '%s\n' "$CHANGED" | grep -q -e "^$prefix" -e "^packages/"; then
    echo "→ typecheck $label…"
    "$@"
  fi
}

# Git donne sur stdin, une ligne par ref poussée :
#   <ref locale> <sha local> <ref distante> <sha distant>
# On ne lit QUE la ref distante : c'est elle qui dit où ça atterrit. Pousser
# `dev:main` promeut, pousser `dev` ne promeut pas — la ref locale mentirait.
promotion=""
pushes_other_than_main=""
last_local_sha=""
run_typechecks=""
CHANGED=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  CHANGED="$CHANGED
$(changed_files "$remote_sha" "$local_sha")"
  case "$remote_ref" in
    refs/heads/main) promotion="$local_sha" ;;
    *)
      pushes_other_than_main=1
      last_local_sha="$local_sha"
      ;;
  esac
done

# ── Ce que les portes lisent : le DISQUE, pas le commit poussé ──────────────
# Les portes et les typechecks lisent les fichiers de l'arbre de travail. Ils
# ne jugent donc le commit qui part que si l'arbre lui est identique. Les lancer
# sur le commit lui-même, dans un arbre à part, a été mesuré le 2026-11-14 :
# plus de deux minutes et demie (installation, client Prisma, paquets, recueils
# générés), et des portes rouges faute de fichiers générés. Trop cher pour
# chaque push.
#
# D'où deux règles :
#   - une PROMOTION seule (vers `main`) ne relance rien sur le disque : elle
#     pousse exactement le `dev` publié, que la CI a jugé SHA pour SHA, et c'est
#     ce verdict qu'on lit plus bas. Relancer les portes sur l'arbre local la
#     refusait à tort dès qu'un travail local non poussé cassait une porte ;
#   - un push vers `dev` les lance sur le disque, et DIT quand le disque diffère
#     du commit poussé : un refus peut alors venir d'un fichier qui ne part pas,
#     et un passage ne prouve rien du commit — la CI tranche.
if [ -n "$promotion" ] && [ "$pushes_other_than_main" = "" ]; then
  echo "→ promotion seule : la CI du commit fait foi, rien à relancer sur le disque."
else
  if [ -n "$(git status --porcelain --untracked-files=normal)" ] || [ "$(git rev-parse HEAD)" != "$last_local_sha" ]; then
    echo "⚠️  l'arbre local diffère du commit poussé : les portes jugent le disque." >&2
    echo "   Un refus peut venir d'un fichier qui ne part pas ; un passage ne prouve" >&2
    echo "   rien du commit. La CI de dev, elle, juge le commit." >&2
  fi
  echo "→ portes du dépôt…"
  pnpm lint:gates
  run_typechecks=1
fi

if [ -n "$run_typechecks" ]; then
typecheck_if_touched "apps/lfd-api/" "backend (app)" \
  pnpm --filter lfd-api exec tsc --noEmit
typecheck_if_touched "apps/lfd-api/" "backend (specs)" \
  pnpm --filter lfd-api exec tsc --noEmit -p tsconfig.test.json
typecheck_if_touched "apps/lfd-backoffice-frontend/" "front admin" \
  pnpm --filter lfd-backoffice-frontend exec tsc -p tsconfig.app.json --noEmit
typecheck_if_touched "apps/lfc-ecommerce-frontend/" "front boutique" \
  pnpm --filter lfc-ecommerce-frontend exec tsc -p tsconfig.app.json --noEmit
fi

if [ -z "$promotion" ]; then
  exit 0
fi

# `git` donne le sha COMPLET sur stdin, et `gh run list --commit` l'exige :
# abrégé, il ne trouve rien et rend « null », qu'on lirait comme « pas encore
# de CI » alors qu'elle est peut-être rouge.
echo "→ promotion vers main : que dit la CI de $(echo "$promotion" | cut -c1-8) ?"

# 🔴 Une promotion pousse EXACTEMENT le `dev` publié (2026-09-25). La CI ne
# tourne plus sur `main` : le déploiement retrouve le run de `dev` par SHA. Un
# commit fabriqué localement (une fusion, un correctif posé sur `main`) n'en a
# aucun, et le déploiement s'arrêterait après coup. On le refuse ici, avant.
git fetch --quiet origin dev 2>/dev/null || true
published_dev=$(git rev-parse --verify --quiet origin/dev || echo "")
if [ "$promotion" != "$published_dev" ]; then
  echo "" >&2
  echo "✖ Une promotion pousse le dev publié, et lui seul." >&2
  echo "  poussé : $(echo "$promotion" | cut -c1-8) · origin/dev : $(echo "$published_dev" | cut -c1-8)" >&2
  echo "" >&2
  echo "  1. git push origin dev        (et attendre la CI)" >&2
  echo "  2. git push origin dev:main   (une avance rapide, sans fusion)" >&2
  echo "" >&2
  echo "  Si main porte un commit que dev n'a pas : git merge --ff-only origin/main" >&2
  echo "  sur dev d'abord — sinon l'avance rapide est impossible." >&2
  exit 1
fi

if ! command -v gh > /dev/null 2>&1; then
  echo "  gh absent — impossible de vérifier. On laisse passer." >&2
  exit 0
fi

verdict=$(gh run list --workflow ci.yml --commit "$promotion" --limit 1 \
  --json conclusion,status --jq '.[0] | "\(.status)|\(.conclusion)"' 2>/dev/null || echo "")

case "$verdict" in
  completed\|success)
    echo "  CI verte."
    ;;
  completed\|*)
    echo "" >&2
    echo "✖ La CI n'est PAS verte sur ce commit (${verdict#*|})." >&2
    echo "  Promouvoir maintenant, c'est déployer du rouge — ou plus" >&2
    echo "  probablement ne rien déployer du tout, les workflows de" >&2
    echo "  déploiement attendant son verdict." >&2
    echo "" >&2
    echo "  Corriger, ou forcer : git push --no-verify" >&2
    exit 1
    ;;
  ""|"null|null")
    # Aucun run sur le dev publié : la CI n'est pas encore créée (quelques
    # secondes après le push). Le déploiement l'attendra ; on avertit.
    echo "  ⚠️  aucune CI encore sur ce commit — le déploiement l'attendra." >&2
    ;;
  *)
    echo "  ⚠️  CI en cours (${verdict%%|*}) — le déploiement l'attendra." >&2
    ;;
esac
