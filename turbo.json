{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:watch": {
      // `build` (du MÊME package), pas `^build` : turbo lance le build une seule
      // fois (partagé avec le `^build` des apps), le termine, PUIS démarre le
      // `tsc -b --watch`. Sans ça, build et watch tournent en concurrence sur le
      // même `.tsbuildinfo` et se bloquent.
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false,
      "outputs": []
    }
  }
}
