# Chevallot PIM backend — variables d'environnement (template versionné).
# Copier en `.env` (gitignoré) et adapter.

# --- Dev local : Postgres dans Docker ---
# Démarrer d'abord l'infra : `pnpm dev:infra` (docker-compose.dev.yml, port hôte 5433)
DATABASE_URL="postgresql://chevallot:chevallot@localhost:5433/chevallot_pim?schema=public"

# --- Prod / staging : Neon (Postgres managé, ADR-09) ---
# Même contrat, seule l'URL change :
# DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/chevallot?sslmode=require"

# --- Auth0 (OIDC) ---
# À créer dans le dashboard Auth0 : une "API" (son Identifier = l'audience).
# AUTH0_DOMAIN  : le tenant, sans https:// ni slash — ex. chevallot.eu.auth0.com
# AUTH0_AUDIENCE: l'Identifier de l'API — ex. https://api.chevallot.fr
# L'API refuse de démarrer si l'une des deux manque (auth mal configurée = risque).
AUTH0_DOMAIN="votre-tenant.eu.auth0.com"
AUTH0_AUDIENCE="https://api.chevallot.fr"

# Port de l'API (défaut 3100 si absent).
# PORT=3100

# --- Canal Shopify (optionnel) ---------------------------------------------
# SECRET : jamais en base, jamais affiché dans l'admin. Sans lui, l'intégration
# reste en simulation même activée depuis l'écran Réglages.
SHOPIFY_ADMIN_TOKEN=
