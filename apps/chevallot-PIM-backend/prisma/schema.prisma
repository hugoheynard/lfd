// Schéma du socle catalogue.
// Modèle de référence : documentation/chevallot/data-model/02-catalogue-items.md
//
// Conventions appliquées :
// - identifiants assignés par la COMMANDE (R1) → aucun `@default(uuid())`, jamais de séquence ;
// - aucun DELETE physique (R3) → archivage par drapeau ;
// - `created_at` / `updated_at` / `updated_by` sont des colonnes SYSTÈME, hors-domaine :
//   jamais lues par une règle métier, jamais exposées en DTO (doc 00 §6) ;
// - textes traduisibles = `Json` `{ fr, en? }` (LocalizedText, `fr` obligatoire).

generator client {
  provider            = "prisma-client"
  output              = "../src/infra/database/client"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum ProductKind {
  daily
  made_to_order
  resale
}

enum ProductStatus {
  draft
  published
  archived
}

enum SkuOwnerType {
  product
  variant
}

/// Registre des références — garantit l'unicité du SKU dans un espace de noms
/// GLOBAL (produits et déclinaisons confondus, doc 06 invariant 1).
/// Une contrainte d'unicité ne pouvant pas s'étendre à deux tables, c'est ce
/// registre qui porte la garantie : la violation de sa clé primaire est le
/// `23505` traduit en `SkuAlreadyUsedError` par l'adaptateur de dépôt.
model SkuRegistry {
  value     String       @id
  ownerType SkuOwnerType @map("owner_type")
  ownerId   String       @map("owner_id")

  @@index([ownerId])
  @@map("sku_registry")
}

model Category {
  id         String     @id
  name       Json
  slug       Json
  parentId   String?    @map("parent_id")
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  position   Int        @default(0)
  isArchived Boolean    @default(false) @map("is_archived")
  products   Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([parentId])
  @@map("category")
}

model Product {
  id         String           @id
  sku        String           @unique
  slug       Json
  kind       ProductKind
  name       Json
  categoryId String           @map("category_id")
  category   Category         @relation(fields: [categoryId], references: [id])
  status     ProductStatus    @default(draft)
  attributes Json             @default("{}")
  variants   ProductVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([categoryId])
  @@map("product")
}

model ProductVariant {
  id             String  @id
  productId      String  @map("product_id")
  product        Product @relation(fields: [productId], references: [id])
  sku            String  @unique
  name           Json
  options        Json    @default("{}")
  isDefault      Boolean @default(false) @map("is_default")
  isDiscontinued Boolean @default(false) @map("is_discontinued")
  position       Int     @default(0)
  attributes     Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([productId])
  @@map("product_variant")
}
