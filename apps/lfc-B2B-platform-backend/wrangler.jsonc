{
  // Backend B2B (NestJS) en Cloudflare Container, piloté par un Worker d'entrée.
  // Consommé par .github/workflows/deploy_b2b_backend.yml (wrangler deploy).
  "name": "lfc-b2b-backend",
  "main": "container/worker.ts",
  "compatibility_date": "2025-06-01",

  // L'image NestJS tourne dans un container ; le Worker ne fait que router.
  "containers": [
    {
      "class_name": "Backend",
      // Image pré-poussée sur le registre Cloudflare (build+push en CI depuis la
      // RACINE du monorepo). Deux placeholders, tous deux remplacés au deploy :
      // `__CF_ACCOUNT_ID__` par le secret CLOUDFLARE_ACCOUNT_ID (jamais commité)
      // et `__IMAGE_TAG__` par le SHA du commit.
      //
      // ⚠️ PAS de tag `latest` : Cloudflare Containers le REFUSE
      // (« Invalid image. Latest tags are not allowed on images. »), constaté au
      // 1er déploiement réel. Un tag mouvant rendrait d'ailleurs un déploiement
      // non reproductible — on ne saurait plus quelle image tourne.
      "image": "registry.cloudflare.com/__CF_ACCOUNT_ID__/lfc-b2b-backend:__IMAGE_TAG__",
      // UNE instance, tenue chaude par le cron `*/5` (cf. `triggers.crons`).
      //
      // Ce n'est pas un plafond de capacité mais un choix de routage : Cloudflare
      // n'offre aujourd'hui aucun routage sensible à la charge, seulement
      // `getRandom` — un tirage au sort. À trafic faible, deux instances tirées
      // aux dés donnent deux machines tièdes et une requête sur deux qui démarre
      // à froid ; une seule instance chaude fait strictement mieux.
      //
      // L'ordre des leviers quand ça serrera, chacun sur une MESURE (latence en
      // hausse, CPU au plafond) et pas par anticipation :
      //   1. `instance_type: "standard-1"` — grossir avant de multiplier : un
      //      seul process Node profite mieux d'un demi-vCPU que d'un deuxième
      //      container qu'il faut apprendre à router.
      //   2. `max_instances: 2` + routage par compteur de requêtes en vol tenu
      //      dans le DO primaire (le seul point qui connaisse sa charge).
      "max_instances": 1,
      // lite (1/16 vCPU,256Mi) trop petit pour Node+Nest → basic (1/4 vCPU,1Gi).
      // Monter à "standard-1" (1/2 vCPU,4Gi) si la RAM serre.
      "instance_type": "basic",
      // PLACEMENT — le container tourne en Europe de l'Ouest, point.
      //
      // Par défaut Cloudflare place le container « au plus près de la requête qui
      // le démarre, parmi les emplacements ayant déjà l'image ». Ce qui le démarre
      // ici n'est pas un client français mais le cron de rafraîchissement, qui
      // s'exécute où Cloudflare veut : le 2026-08-13, l'instance vivait à
      // **Dallas-Fort Worth**, soit un aller-retour transatlantique sur CHAQUE
      // appel d'API pour des clients tous français. Le défaut « au plus près »
      // n'est un bon défaut que pour un service dont le trafic est mondial.
      //
      // `constraints` n'est pas un vœu, contrairement au `locationHint` des
      // Durable Objects : c'est une contrainte d'ordonnancement. WEUR seul suffit
      // (ni ME/OC/AFR, qui interdisent d'être utilisées seules).
      //
      // Non ajouté volontairement : `"jurisdiction": "eu"`. Ce serait une
      // garantie de CONFORMITÉ (frontière de traitement des données), pas de
      // latence, et une décision distincte — WEUR inclut des emplacements hors UE.
      "constraints": { "regions": ["WEUR"] },
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],

  // PLUS AUCUNE ADRESSE PUBLIQUE. Ce Worker n'est joignable que par le service
  // binding de la passerelle (`gateway/wrangler.toml`) : c'est ce qui fait d'elle
  // une vraie frontière et non une décoration. Tant que `…workers.dev` répondait
  // au monde, la contourner suffisait à ignorer tout ce qu'elle applique.
  //
  // Ce qui continue de fonctionner sans adresse publique : les Cron Triggers
  // (attachés au Worker, pas à une URL) et l'accès au container par son binding
  // Durable Object. Ce qui cesse : tout appel entrant direct, y compris le nôtre.
  //
  // Vérifié avant de fermer — aucun tiers ne dépendait de cette adresse : le PIM
  // n'expose aucun webhook (zéro occurrence dans son code), et la cible du
  // webhook Stripe (`api-b2b.lafoliedouce.eu`) ne résout pas en DNS, donc elle
  // était déjà morte.
  //
  // ⚠️ Pour rouvrir en urgence : repasser à `true` et redéployer. La passerelle
  // reste le chemin normal ; ceci n'est qu'un interrupteur de secours.
  "workers_dev": false,

  // Rate limiting à l'edge (par IP cliente) : le Worker rejette en 429 AVANT de
  // réveiller le container. `period` n'accepte que 10 ou 60 (secondes). 300/min
  // = large pour un SPA connecté, mais coupe le flood d'une IP unique. La
  // protection volumétrique/distribuée reste l'anti-DDoS automatique Cloudflare.
  //
  // ⚠️ Champ de PREMIER NIVEAU `ratelimits`, et non `unsafe.bindings`. Sous
  // l'ancienne forme, le binding existait assez pour ne pas faire planter le
  // Worker — mais sa configuration n'était pas appliquée et `limit()` rendait
  // toujours `success: true`. Mesuré le 2026-08-13 en production : 500 requêtes
  // d'une même IP en rafale, **zéro 429**, toutes arrivées au container. Une
  // protection qu'on croit avoir et qu'on n'a pas est pire que pas de
  // protection : on ne la surveille plus.
  //
  // Le compteur est LOCAL au datacentre Cloudflare qui exécute le Worker, et
  // volontairement approximatif — c'est un coupe-flood, pas une comptabilité.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 300, "period": 60 },
    },
  ],

  // Cron Triggers : réveillent le Worker (handler `scheduled`), qui départage les
  // deux rythmes sur l'expression exacte du cron. ⚠️ `*/5 * * * *` est recopié
  // dans `KEEP_WARM_CRON` (worker.ts) — les deux chaînes doivent rester
  // identiques, sinon le ping partirait en recompute.
  //
  // 1. `*/5` — RAFRAÎCHISSEMENT. Frappe `/health` sur l'instance nommée toutes
  //    les 5 min, donc bien plus souvent que son `sleepAfter = "1h"` : elle ne
  //    s'endort jamais et personne ne paie de démarrage à froid. Sans ce cron,
  //    une nuit ou un dimanche suffisent à endormir le backend, et le premier
  //    visiteur du matin attend le boot de Node. Coût : ~8 600 requêtes Worker
  //    par mois, invisible dans le forfait.
  //
  // 2. `0 3|11|19` — RECOMPUTE du read-model `lead_score` (POST /admin/recompute
  //    vers le container, jeton RECOMPUTE_TOKEN), 3×/jour aux HEURES CREUSES,
  //    hors des pics de commande (atelier + services chefs).
  //
  // ⚠️ Les crons Cloudflare sont en **UTC**. On vise ~04h/12h/20h Europe/Paris ;
  // avec le décalage saisonnier (UTC+1 hiver / UTC+2 été), 03/11/19 UTC tombe à
  // 04/12/20 en hiver et 05/13/21 en été — une dérive d'une heure sans importance
  // pour un batch dont la fraîcheur assumée est ≤ ~8 h. Le jeton se pose par
  // `wrangler secret put RECOMPUTE_TOKEN` (jamais commité).
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *", "0 11 * * *", "0 19 * * *"],
  },
}
