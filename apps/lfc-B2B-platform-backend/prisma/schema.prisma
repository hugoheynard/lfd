// Schéma de la db B2B COMMERCE (la « B2B platform »).
// Contexte : clients pros (customers) qui commandent à La Folie Coffee.
// Doc d'archi : documentation/architecture-identite-auth-tenancy.md
//              documentation/architecture-flux-commande-prod.md
//
// Conventions (alignées sur le PIM) :
// - `User` ICI = une PERSONNE côté client (customer), avec son profil : nom,
//   prénom, e-mail, téléphone. Le staff/back-office vit dans une db SÉPARÉE
//   (bounded context distinct) ; pas de table staff ici.
// - Une personne et une société sont deux choses : le rattachement passe par
//   `memberships` (0..N sociétés par personne, cf. le modèle Membership).
// - Tenancy : chaque table possédée par un client porte `company_id` (le « mur »).
//   On filtre TOUJOURS par ce company_id ; il ne se déduit PLUS du jeton, il est
//   choisi par la requête et vérifié contre les memberships du demandeur.
//   Le staff (autre db) n'est pas muré.
// - Auth : aucune credential stockée. Auth0 possède l'auth ; on ne garde que
//   `auth0_sub` (clé stable) + `email` (clé humaine / secours migration).
// - Pas de DELETE physique : archivage par drapeau (`archived_at`) ou statut.
// - `created_at` / `updated_at` = colonnes SYSTÈME, hors-domaine.
// - Argent : entiers en CENTIMES (`*_cents`), jamais de float. Devise = EUR.
//
// ⚠️ Décisions à confirmer :
// - IDs : `@default(cuid())` ici pour démarrer vite. Le PIM assigne les IDs par la
//   commande (préfixés, sans default). À aligner si tu veux la parité monorepo.
// - `runtime = "nodejs"` : à passer en driver-adapter si le back devient Workers (Hono).

generator client {
  provider            = "prisma-client"
  output              = "../src/infra/database/client"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

// Prisma 7 : plus d'`url` ici. La connexion (db distincte du PIM/admin) est
// fournie par `prisma.config.ts` (Migrate) + l'adapter au constructeur de
// PrismaClient (runtime), comme le PIM.
datasource db {
  provider = "postgresql"
  schemas  = ["public", "growth"]
}

// ─────────────────────────────────────────────────────────────────────────────
// Énumérations
// ─────────────────────────────────────────────────────────────────────────────

/// Conditions de paiement accordées au client (échéance de règlement).
/// Valeurs alignées sur le front (`PaymentTerm` dans profil.model.ts).
enum PaymentTerm {
  per_order
  monthly
  net60
  net90

  @@schema("public")
}

/// Cycle de vie d'un compte client (établissement).
///
/// `pending` = société déclarée par le client depuis « Mes entreprises », pas
/// encore validée commercialement (défaut à la création). L'activation reste
/// **manuelle côté commercial** — décision verrouillée dans
/// `documentation/architecture-onboarding-provisioning-b2b.md`.
///
/// `suspended` ≠ `terminated` : `suspended` coupe l'accès **temporairement**
/// (impayé, litige) et se lève ; `terminated` acte la **fin de la relation
/// commerciale** — définitif du point de vue métier, l'historique est conservé.
enum CompanyStatus {
  pending
  active
  suspended
  terminated

  @@schema("public")
}

/// Rôle d'une personne AU SEIN d'une société donnée — porté par le `Membership`,
/// donc variable d'une société à l'autre pour la même personne.
/// `company_admin` = gère les users/commandes de cette société (le
/// « gestionnaire », rôle du créateur) ; `member` = passe des commandes.
enum CustomerRole {
  company_admin
  member

  @@schema("public")
}

/// Cycle de vie d'une identité customer (provisioning → actif).
enum UserStatus {
  invited
  active
  disabled

  @@schema("public")
}

/// À quoi sert une adresse (aligné sur `AdresseKind` du front).
enum AddressKind {
  facturation
  livraison

  @@schema("public")
}

/// Mode d'une **pièce d'activation** dans la configuration globale (Réglages).
/// `hidden` = la pièce n'existe pas encore (ex. livraison sans service) → masquée
/// client + admin, jamais exigée. `optional` = visible mais ne gate pas
/// l'activation. `required` = exigée pour activer. Cf.
/// `documentation/architecture-activation-configuration-b2b.md`.
enum PieceMode {
  hidden
  optional
  required

  @@schema("public")
}

/// Mode d'**acheminement** d'une commande. `delivery` = livraison à une adresse ;
/// `pickup` = retrait au point de retrait (labo), fallback tant que la livraison
/// n'existe pas. Cf. `documentation/architecture-activation-configuration-b2b.md`.
enum FulfillmentMethod {
  delivery
  pickup

  @@schema("public")
}

/// Mode d'un **ajustement de panier** (remise d'un point de retrait, frais d'une
/// zone de livraison) : `percent` → la valeur est en points de base (2000 = 20 %) ;
/// `amount` → la valeur est en centimes (2000 = 20 €).
enum CartAdjustmentMode {
  percent
  amount

  @@schema("public")
}

/// Cycle de vie d'une commande.
enum OrderStatus {
  draft
  placed
  confirmed
  in_production
  fulfilled
  cancelled

  @@schema("public")
}

/// État du **règlement** d'une commande. Découplé de `OrderStatus` (l'avancement
/// de production) : une commande peut être `placed` et déjà `paid`, ou `placed`
/// et `not_required` (facturée sur terme). Décidé par le `paymentTerm` de la
/// société : `per_order` → `pending` puis `paid` (carte Stripe) ; les termes
/// différés (`monthly`/`net60`/`net90`) → `not_required` (encaissée hors ligne).
enum PaymentStatus {
  not_required
  pending
  paid
  failed
  refunded

  @@schema("public")
}

/// **Périmètre** d'un utilisateur staff — les domaines du back-office auxquels il
/// a accès. Stocké pour l'instant (l'annuaire) ; l'enforcement (masquer les
/// sections) viendra quand le login staff sera branché sur Auth0.
enum StaffScope {
  commercial
  comptabilite
  admin

  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Company — le TENANT (établissement client pro)
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id String @id @default(cuid())

  // Référence humaine courte (`C-XXXXXX`), lisible et dictable au téléphone —
  // pour que le client donne sa référence en cas de panne de service. Générée à
  // la création, jamais l'`id` technique (cuid, imprononçable).
  reference String @unique

  // Identité légale (cf. Etablissement, front)
  raisonSociale  String @map("raison_sociale")
  enseigne       String @default("") // nom commercial si différent
  formeJuridique String @map("forme_juridique") // SAS, SARL, EI…
  siret          String
  tvaIntracom    String @default("") @map("tva_intracom")

  // Code NAF (activité principale) résolu depuis le SIRET via l'API entreprises —
  // vide tant qu'inconnu. Dimension d'analyse commerciale (segmenter l'acquisition
  // par secteur) : cf. documentation/commercial-data-analytics.md.
  nafCode String @default("") @map("naf_code")

  // Contact PRINCIPAL de l'entreprise (value object aplati). Semé du profil du
  // créateur ; c'est la carte « Admin du compte entreprise ». Contact unique et
  // obligatoire — les autres interlocuteurs sont des `CompanyContact` (0..N).
  contactPrenom    String @map("contact_prenom")
  contactNom       String @map("contact_nom")
  contactFonction  String @default("") @map("contact_fonction")
  contactEmail     String @map("contact_email")
  contactTelephone String @default("") @map("contact_telephone")

  // Facturation (un seul champ pour l'instant → sur Company ; extraire un
  // BillingProfile le jour où ça grossit : plafond crédit, email de facturation…).
  //
  // `paymentTerm` = le terme **convenu** (celui qui s'applique). Écrit
  // **uniquement par le staff** : le client ne le mute jamais en direct. Une
  // évolution souhaitée par le client atterrit dans `requestedPaymentTerm` (une
  // demande, promue plus tard par le commercial), `null` = aucune demande en
  // cours. Deux colonnes pour ne pas confondre « souhaité » et « convenu ».
  paymentTerm          PaymentTerm  @default(per_order) @map("payment_term")
  requestedPaymentTerm PaymentTerm? @map("requested_payment_term")

  // Défaut `pending` : une société n'est jamais cliente parce qu'elle a été
  // saisie — elle le devient par une activation commerciale explicite.
  status CompanyStatus @default(pending)

  // KBIS — l'extrait déposé par le client, demandé pour la validation. Le fichier
  // vit dans le stockage objet (R2) ; on ne garde ici que ses métadonnées et sa
  // CLÉ de stockage. Tous null = aucun KBIS déposé. La **certification** est
  // propre au fichier : `kbisCertifiedAt` est posé par le staff quand l'extrait
  // est validé, et **remis à null à chaque (re)dépôt** — remplacer le KBIS
  // invalide la certification précédente. Découplé de `status` : un fichier
  // remplacé sur une société active ne reste pas « certifié » à tort.
  kbisStorageKey  String?   @map("kbis_storage_key")
  kbisFileName    String?   @map("kbis_file_name")
  kbisContentType String?   @map("kbis_content_type")
  kbisSize        Int?      @map("kbis_size")
  kbisUploadedAt  DateTime? @map("kbis_uploaded_at")
  kbisCertifiedAt DateTime? @map("kbis_certified_at")

  // Posé au passage `pending → active` par l'activation commerciale explicite
  // (ancre d'ancienneté commerciale, distincte de `createdAt`). `null` = jamais activé.
  activatedAt DateTime? @map("activated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  contacts        CompanyContact[]
  addresses       Address[]
  orders          Order[]
  supportRequests SupportRequest[]

  @@index([siret])
  @@map("companies")
  @@schema("public")

  /// Dérogations de ce compte aux règles d'alerte globales (cf. alerts/).
  alertOverrides AccountAlertOverride[]

  /// Alertes déclenchées sur ce compte (cf. alerts/).
  alerts AccountAlert[]
}

// ─────────────────────────────────────────────────────────────────────────────
// User — la PERSONNE qui possède le compte (son profil), sans société propre
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(cuid())

  // Identité Auth0 (aucun mot de passe stocké ici). `email` est la clé humaine ;
  // Auth0 en reste propriétaire, on le synchronise (cf. CustomerIdentityPort).
  auth0Sub String @unique @map("auth0_sub")
  email    String

  // Profil de la personne — DISTINCT du contact de la société. Chaîne vide et
  // non `null` pour l'absence, comme partout ailleurs dans ce schéma.
  firstName String @default("") @map("first_name")
  lastName  String @default("") @map("last_name")
  phone     String @default("")

  status UserStatus @default(invited)

  // Préférences de navigation/affichage de la personne (bag JSON, extensible).
  // Aujourd'hui : `catalogueView` (grille/rayons/liste). Absent = pas de choix
  // explicite → le front applique son défaut. Sac plutôt qu'une colonne par
  // préf : ces réglages purement UI n'ont pas d'invariant et grossiront.
  navPrefs Json? @map("nav_prefs")

  // Traçabilité : id du STAFF (autre db) qui a provisionné ce client.
  // Pas de FK cross-db → simple identifiant.
  invitedBy String? @map("invited_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  ordersPlaced    Order[]
  subscriptions   Subscription[]
  supportRequests SupportRequest[]

  @@map("users")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// SupportRequest — une demande de rappel/contact à l'activation
// ─────────────────────────────────────────────────────────────────────────────

/// Canal de contact souhaité (aligné sur `SupportChannel`, front).
enum SupportChannel {
  phone
  email

  @@schema("public")
}

/// Demi-journée d'un créneau de rappel.
enum SupportSlot {
  morning
  afternoon

  @@schema("public")
}

/// Une demande de support à l'activation : le client veut être contacté par
/// l'équipe commerciale. Wallée par `company_id`. Lue par le commercial (la
/// notification e-mail viendra avec l'infra mailer) ; `handled_at` marque le
/// traitement.
model SupportRequest {
  id String @id @default(cuid())

  /// Société concernée, ou NULL : un prospect sans entreprise déclarée doit
  /// pouvoir demander un rappel — la demande porte alors sur la personne.
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestedByUserId String @map("requested_by_user_id")
  requestedBy       User   @relation(fields: [requestedByUserId], references: [id])

  channel     SupportChannel
  /// Motif — même vocabulaire que les rendez-vous ; objet du mail si `channel = email`.
  purpose     String         @default("other")
  phoneNumber String         @default("") @map("phone_number")
  asap        Boolean        @default(true)

  // Créneau daté si `asap = false`.
  scheduledDate DateTime?    @map("scheduled_date") @db.Date
  slot          SupportSlot?

  message String @default("")

  handledAt DateTime? @map("handled_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([requestedByUserId])
  @@map("support_requests")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Membership — le RATTACHEMENT d'une personne à une société cliente
// ─────────────────────────────────────────────────────────────────────────────

/// Une personne peut n'appartenir à aucune société (elle vient de créer son
/// compte : « Mes entreprises » est vide et propose d'en créer une), à une, ou à
/// plusieurs. C'est pourquoi le rattachement est une table à part et non une
/// colonne `company_id` sur `users` : cette colonne imposait exactement une
/// société, et rendait l'état « aucune » impossible à représenter.
///
/// Le `role` vit ICI, pas sur `users` : on peut être gestionnaire d'une société
/// et simple membre d'une autre.
///
/// ⚠️ Tenancy : le mur reste `company_id`, mais la société d'une requête ne se
/// déduit plus de l'utilisateur — elle doit être **choisie explicitement** et
/// vérifiée contre les memberships du demandeur. Aucun endpoint métier n'est
/// encore muré ; le premier (commandes, adresses) devra porter ce choix.
model Membership {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  role CustomerRole @default(member)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Une personne n'est rattachée qu'une fois à une société donnée.
  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// CompanyContact — un interlocuteur ADDITIONNEL de l'entreprise
// ─────────────────────────────────────────────────────────────────────────────

/// Les contacts en plus du contact principal (qui, lui, vit aplati sur `Company`
/// et n'est jamais supprimable). Carnet d'adresses de l'entreprise : ce sont des
/// personnes à joindre, PAS des utilisateurs du logiciel — aucun `auth0_sub`,
/// aucun accès. Inviter un collègue à se connecter est un autre flux (membership).
///
/// Wallé par `company_id` comme tout ce qui appartient à un client.
model CompanyContact {
  id String @id @default(cuid())

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  prenom    String
  nom       String
  fonction  String @default("")
  email     String
  telephone String @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("company_contacts")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Address — 1 facturation + N livraison, 1 livraison par défaut
// ─────────────────────────────────────────────────────────────────────────────

model Address {
  id String @id @default(cuid())

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  kind  AddressKind
  label String // « Siège », « Boutique Bastille »…

  ligne1     String
  ligne2     String @default("")
  codePostal String @map("code_postal")
  ville      String
  pays       String

  // Adresse de livraison par défaut. Invariant (appliqué en applicatif) :
  // au plus une `livraison` à `true` par company ; exactement une `facturation`.
  isDefault Boolean @default(false) @map("is_default")

  // Consignes de LIVRAISON (note livreurs, créneaux préférés, contact sur place,
  // point GPS) — la forme est le `DeliverySpecs` de `@lfd/contracts`, stockée en
  // JSON car on ne requête jamais par créneau. `null` sur une facturation, et sur
  // une livraison tant qu'aucune consigne n'a été saisie.
  deliverySpecs Json? @map("delivery_specs")

  // Pas de DELETE physique : on archive.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveredOrders Order[] @relation("OrderDeliveryAddress")

  @@index([companyId, kind])
  @@map("addresses")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Order — une commande, tenant-scoped
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @map("order_number") // référence humaine

  // Tenancy. `companyId` est OPTIONNEL : une commande « zéro friction » n'appartient
  // qu'au client connecté (`placedByUserId` = LE mur sans entreprise). Elle se
  // rattache à une société plus tard (rapatriement — cf. doc flux commande).
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  // Qui a passé la commande (le client connecté).
  placedByUserId String @map("placed_by_user_id")
  placedBy       User   @relation(fields: [placedByUserId], references: [id])

  status OrderStatus @default(placed)

  // Alimente le plan de prod (« à produire pour demain »).
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date

  // Acheminement. `delivery` = **coursier** : `deliveryZoneId` (zone tarifée) +
  // `deliveryAddressSnapshot` (adresse libre FIGÉE, comme les prix). `pickup` =
  // **retrait** : `pickupAddress` (snapshot des champs postaux du labo). La relation
  // `deliveryAddress` (adresse d'entreprise) reste pour l'héritage / le rapatriement.
  fulfillmentMethod FulfillmentMethod @default(delivery) @map("fulfillment_method")

  deliveryZoneId String? @map("delivery_zone_id")

  deliveryAddressId String?  @map("delivery_address_id")
  deliveryAddress   Address? @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id])

  // Adresse de livraison LIBRE figée (coursier sans carnet d'entreprise).
  deliveryAddressSnapshot Json? @map("delivery_address_snapshot")

  pickupAddress Json? @map("pickup_address")

  // Argent en centimes (snapshot au moment de la commande). Prix marchandises
  // **HT** ; `total` est le **TTC** encaissé = `max(0, subtotal − discount) +
  // deliveryFee + vat`. Remise = point de retrait ; frais = zone ; TVA par taux
  // (5,5 % alimentaire, 20 % livraison).
  subtotalCents    Int    @map("subtotal_cents")
  discountCents    Int    @default(0) @map("discount_cents")
  // L'ajustement (%, ou € fixe) qui a PRODUIT `discountCents`, figé comme les
  // prix : sans lui un document ne peut nommer la remise, seulement la chiffrer.
  discountAdjustment Json? @map("discount_adjustment")
  deliveryFeeCents Int    @default(0) @map("delivery_fee_cents")
  vatCents         Int    @default(0) @map("vat_cents")
  totalCents       Int    @map("total_cents")
  currency         String @default("EUR")

  // Règlement. `paymentStatus` est fixé à la passation d'après le terme de la
  // société (cf. enum PaymentStatus). `stripePaymentIntentId` relie la commande
  // à l'intention de paiement Stripe (per_order) — clé de rapprochement du
  // webhook, `@unique` pour l'idempotence. `paidAt` = horodatage d'encaissement.
  paymentStatus         PaymentStatus @default(not_required) @map("payment_status")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  paidAt                DateTime?     @map("paid_at")

  note String @default("")

  // Origine récurrente : l'abonnement qui a produit cette commande (« récurrent »)
  // et l'écart vs son gabarit pour cette échéance ({ added, removed } — pills +/−).
  // Nuls tant que le planificateur ne génère pas de commandes depuis un abonnement.
  fromSubscriptionId String? @map("from_subscription_id")
  recurringDeltas    Json?   @map("recurring_deltas")

  // Remise en main propre (retrait au labo). `handoverToken` est un secret
  // ALÉATOIRE, pas le numéro de commande : celui-ci est imprimé sur le bon de
  // livraison, donc public, donc sans valeur de preuve. Émis à la passation pour
  // les seules commandes `pickup`. `@unique` = c'est la clé de lecture du scan.
  // Les deux autres colonnes SONT l'attestation : quand, et par qui (le claim
  // `sub` du jeton staff, figé — un annuaire réécrit ne doit pas réécrire une
  // preuve, et le `sub` reste résolvable même après un changement de nom).
  handoverToken String?   @unique @map("handover_token")
  handedOverAt  DateTime? @map("handed_over_at")
  handedOverBy  String?   @map("handed_over_by")

  createdAt DateTime @default(now()) @map("created_at") // = passée le
  updatedAt DateTime @updatedAt @map("updated_at")

  lines OrderLine[]

  @@index([companyId])
  @@index([placedByUserId])
  @@index([requestedDeliveryDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([fromSubscriptionId])
  @@map("orders")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// OrderLine — réfère le SKU du PIM (cross-context), snapshot prix/nom/TVA
// ─────────────────────────────────────────────────────────────────────────────

model OrderLine {
  id String @id @default(cuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Référence au catalogue PIM. String, PAS une FK (autre db / bounded context).
  sku String

  // Snapshots au moment de la commande : le prix/nom/TVA du PIM peut changer,
  // la commande garde ce qu'elle a facturé.
  productNameSnapshot String  @map("product_name_snapshot")
  unitPriceCents      Int     @map("unit_price_cents")
  vatRate             Decimal @default(0) @map("vat_rate") @db.Decimal(5, 2) // %, ex. 5.50

  quantity       Int
  lineTotalCents Int @map("line_total_cents")

  // Un SKU n'apparaît qu'UNE fois par commande. `place-order` fusionne déjà les
  // quantités du panier ; la contrainte rend la règle structurelle plutôt que
  // conventionnelle. C'est aussi ce qui rend une moyenne par SKU calculable sans
  // question : deux lignes du même produit dans une commande, et « la quantité
  // commandée » n'aurait plus de définition unique.
  @@unique([orderId, sku])
  @@index([orderId])
  @@index([sku]) // agrégation par SKU pour le plan de prod
  @@map("order_lines")
  @@schema("public")
}

// Panier récurrent (abonnement) : un GABARIT de commande qui se répète. Ne
// déclenche pas encore de commande (planificateur différé) ; on capture
// l'intention. Mur = `placed_by_user_id` (comme les commandes perso zéro friction).
// `recurrence`/`status` en String (union validée au bord par zod), dates en Date.
model Subscription {
  id String @id @default(cuid())

  placedByUserId String @map("placed_by_user_id")
  placedBy       User   @relation(fields: [placedByUserId], references: [id])

  // Traçabilité : commande d'origine (celle « transformée en panier récurrent »).
  fromOrderId String? @map("from_order_id")

  recurrence String // weekly | biweekly | monthly
  status     String @default("active") // active | paused

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date // null = sans fin

  // Acheminement figé (comme les commandes) : livraison = adresse libre snapshot ;
  // retrait = id du point (ou null = défaut).
  fulfillmentMethod       FulfillmentMethod @map("fulfillment_method")
  deliveryAddressSnapshot Json?             @map("delivery_address_snapshot")
  pickupAddressId         String?           @map("pickup_address_id")

  note String @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines       SubscriptionLine[]
  occurrences SubscriptionOccurrence[]

  @@index([placedByUserId])
  @@map("subscriptions")
  @@schema("public")
}

model SubscriptionOccurrence {
  id String @id @default(cuid())

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // L'échéance visée (« modifier cette commande uniquement »).
  occurrenceDate DateTime @map("occurrence_date") @db.Date

  // Soit on saute l'échéance, soit on remplace ses lignes pour cette date-là.
  skipped Boolean @default(false)
  lines   Json // [{ sku, quantity }] — remplacement (vide si sautée).
  note    String  @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subscriptionId, occurrenceDate])
  @@index([subscriptionId])
  @@map("subscription_occurrences")
  @@schema("public")
}

model SubscriptionLine {
  id String @id @default(cuid())

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Référence catalogue PIM (String, pas une FK). Le prix est ré-résolu à l'échéance.
  sku      String
  quantity Int

  @@index([subscriptionId])
  @@map("subscription_lines")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// PlatformSettings — configuration GLOBALE (une seule ligne)
// ─────────────────────────────────────────────────────────────────────────────

/// Réglages globaux de la plateforme B2B — **une seule ligne** (singleton, `id`
/// fixe). Pilote les **pièces d'activation** : quelles sont cachées / optionnelles
/// / requises. Global à LFC (pas par société — « la livraison n'existe pas » est
/// une réalité business). Édité depuis la page Réglages admin. Cf.
/// `documentation/architecture-activation-configuration-b2b.md`.
model PlatformSettings {
  // Singleton : une constante fixe (`SINGLETON`) garantit l'unicité de la ligne.
  id String @id

  // Mode de chaque pièce d'activation. Défauts au lancement : la livraison est
  // cachée (service absent), le KBIS optionnel (vérification pas encore en place),
  // TVA et facturation requises.
  tvaMode      PieceMode @default(required) @map("tva_mode")
  kbisMode     PieceMode @default(optional) @map("kbis_mode")
  billingMode  PieceMode @default(required) @map("billing_mode")
  deliveryMode PieceMode @default(hidden) @map("delivery_mode")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("b2b_platform_settings")
  @@schema("public")
}

/// Un **point de retrait** (laboratoire) — adresse **globale** (pas par entreprise),
/// fallback d'acheminement tant que la livraison n'existe pas. Plusieurs points
/// possibles, un seul `isDefault`. Une commande en retrait fige un snapshot de
/// l'adresse choisie. Cf. `documentation/architecture-activation-configuration-b2b.md`.
model PickupAddress {
  id String @id @default(cuid())

  label      String
  ligne1     String
  ligne2     String @default("")
  codePostal String @map("code_postal")
  ville      String
  pays       String

  // Un seul point par défaut (le préselectionné au checkout). L'invariant « au
  // moins un point » et « un seul défaut » est tenu par le repository.
  isDefault Boolean @default(false) @map("is_default")

  // Remise appliquée au panier en cas de retrait ici. `discountMode` null =
  // aucune remise ; sinon `discountValue` = bp (percent) ou centimes (amount).
  discountMode  CartAdjustmentMode? @map("discount_mode")
  discountValue Int?                @map("discount_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("pickup_addresses")
  @@schema("public")
}

/// **Heure limite de commande** — une RÈGLE par ligne, jamais une colonne de
/// réglage. Ouvrir un second labo ou décaler le dimanche doit être de la saisie,
/// pas une migration.
///
/// `pickupAddressId` null = règle par défaut de la plateforme ; `weekday` null =
/// tous les jours. La plus spécifique gagne (`resolveOrderCutoff`, côté contrat).
/// La limite se compte en `daysBefore` + `time` depuis la date d'ACHEMINEMENT
/// demandée : « 18 h » seul serait ambigu.
model OrderCutoff {
  id String @id @default(cuid())

  pickupAddressId String? @map("pickup_address_id")

  /// `mon`…`sun` — le même {@link Weekday} que les créneaux de livraison. Deux
  /// représentations du jour dans un seul contrat finiraient décalées d'une unité.
  /// Null = tous les jours.
  weekday String?

  daysBefore Int    @default(1) @map("days_before")
  /// `HH:MM` en heure LOCALE du laboratoire, pas un instant UTC.
  time       String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Une seule règle par couple (point, jour) : deux règles concurrentes rendraient
  // la résolution dépendante de l'ordre de lecture. Postgres traite chaque NULL
  // comme distinct, d'où les index partiels ci-dessous pour couvrir les défauts.
  @@unique([pickupAddressId, weekday])
  @@index([pickupAddressId])
  @@map("order_cutoffs")
  @@schema("public")
}

/// **Zone de livraison** — un secteur de codes postaux (stations éloignées)
/// portant un frais de livraison HT ajouté au panier quand la commande est livrée
/// vers ce secteur. `postalPrefixes` = préfixes couverts (`73150` exact, `731` =
/// secteur) ; le plus long gagne. Config globale. `feeValue` = bp (percent) ou
/// centimes (amount) selon `feeMode`.
model DeliveryZone {
  id             String   @id @default(cuid())
  postalPrefixes String[] @map("postal_prefixes")
  label          String   @default("")

  feeMode  CartAdjustmentMode @map("fee_mode")
  feeValue Int                @map("fee_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_zones")
  @@schema("public")
}

/// Utilisateur **staff** (back-office) — l'annuaire des personnes qui opèrent la
/// suite : prénom, nom, e-mail (clé humaine + futur lien de connexion) et un
/// **périmètre** (ensemble de `StaffScope`). Source de vérité **locale** : on ne
/// dépend pas d'Auth0 pour administrer sa propre suite. Le provisioning de
/// connexion (Auth0) est différé ; `auth0Id` reste nul jusque-là.
model StaffUser {
  id String @id @default(cuid())

  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String @unique

  /// Le périmètre : quels domaines du back-office. Vide = aucun accès (annuaire
  /// seul). Premier tableau scalaire du schéma (Postgres enum array).
  scopes StaffScope[]

  /// Identité Auth0, si/quand un compte de connexion est provisionné. Nul tant
  /// que le login staff n'est pas branché.
  auth0Id String? @unique @map("auth0_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staff_users")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// ActivityEvent — le JOURNAL d'événements (schéma `growth`, isolé)
// ─────────────────────────────────────────────────────────────────────────────

/// Journal **append-only** du module croissance : une ligne = un fait métier
/// observé (`order.placed`, `company.declared`…). C'est de l'**event streaming**
/// (projection analytique/audit), **PAS de l'event sourcing** : la vérité métier
/// reste transactionnelle (schéma `public`), on ne reconstruit JAMAIS l'état
/// depuis ce journal. Ce n'est **pas un agrégat** — de l'infrastructure, un seul
/// invariant : l'immuabilité (jamais d'UPDATE/DELETE).
///
/// Volontairement dans son **propre schéma Postgres `growth`** dès maintenant :
/// le déménagement vers un store dédié (trip-wire (b) du design) est ainsi
/// trivial, et `growth/` ne touche jamais les tables de `public` — il ne consomme
/// que ce contrat d'événements. Partitionnement mensuel + rétention = affaire
/// d'une migration SQL brute ultérieure (non exprimable en Prisma déclaratif).
model ActivityEvent {
  /// ULID (fourni par l'`IdGenerator`, pas de `@default`) : triable par le temps
  /// → pagination stable sur un flux append-only.
  id String @id

  /// Type de l'événement, ex. `order.placed`. Le `payload` en dépend.
  type String

  /// Le `payload` évolue → on le versionne pour lire les vieilles lignes.
  schemaVersion Int @default(1) @map("schema_version")

  /// Temps de l'ÉVÉNEMENT (métier, autorité = `Clock` backend).
  occurredAt DateTime @map("occurred_at")

  /// Temps d'INGESTION (écriture au journal) — ≠ `occurredAt` si tardif/rejoué.
  recordedAt DateTime @default(now()) @map("recorded_at")

  /// Sujet de l'événement : `user` | `company` | `lead`.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  /// Établissement rattaché — posé maintenant (nullable), rempli plus tard par
  /// l'identity resolution (Phase 3). Indexé dès aujourd'hui.
  establishmentId String? @map("establishment_id")

  /// Nature de l'acteur : `customer` | `staff` | `system` (lu du RequestContext).
  actorType String @map("actor_type")

  /// Corrélation bout-en-bout (le `traceId` W3C de la requête).
  traceId String @map("trace_id")

  /// Anti double-comptage : une émission rejouée porte la même clé → refusée.
  idempotencyKey String @unique @map("idempotency_key")

  /// Charge utile typée par `type` (montants en CENTIMES entiers, jamais de float).
  payload Json

  @@index([subjectType, subjectId, occurredAt])
  @@index([type, occurredAt])
  @@index([establishmentId, occurredAt])
  @@map("activity_events")
  @@schema("growth")
}

// ─────────────────────────────────────────────────────────────────────────────
// LeadScore — le READ-MODEL matérialisé du cockpit (schéma `growth`)
// ─────────────────────────────────────────────────────────────────────────────

/// Read-model **matérialisé** de la queue « 5 meilleurs coups du jour » : un lead
/// scoré (0..100) et typé par play. **Dérivé du journal** par un `derive*` pur,
/// **recalculé par cron 3×/jour** (04h/12h/20h, heures creuses) via
/// `POST /admin/recompute` — **jamais** temps réel, **jamais** on-read (rejouer
/// tout le journal à chaque affichage = fondu). Le cockpit **lit ce read-model**,
/// jamais le journal brut.
///
/// Ce n'est **pas un agrégat** (zéro invariant réfutable) : une **projection**
/// intégralement remplacée à chaque recompute (`replaceAll` = wipe + insert). La
/// clé métier est le couple (sujet-type, sujet-id) → une seule ligne par lead.
model LeadScore {
  /// Sujet du lead : `user` (personne) | `company` (dossier d'activation).
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  /// Libellé lisible figé au recompute (e-mail connu, sinon l'identifiant).
  label String

  /// Play recommandée : `lock_in` | `rescue` | `upgrade` | `win_back`.
  play String

  /// Score de priorité, entier 0..100 (fonction pure auditable).
  score Int

  /// Justification courte du score/play, rendue telle quelle au commercial.
  reason String

  /// Trajectoire du rythme si connue (`null` pour un dossier société).
  momentum String?

  /// Total commandé rattaché au lead, en centimes.
  monetaryCents Int @map("monetary_cents")

  /// Jours depuis la dernière activité.
  recencyDays Int @map("recency_days")

  /// Instant du recompute qui a produit cette ligne (fraîcheur de la reco).
  computedAt DateTime @map("computed_at")

  @@id([subjectType, subjectId])
  @@index([score(sort: Desc)])
  @@map("lead_scores")
  @@schema("growth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lead — l'AGRÉGAT de démarchage (cold), schéma `growth`
// ─────────────────────────────────────────────────────────────────────────────

/// Lead **cold** : un prospect **saisi** par un commercial (sortant), avec un
/// **état de suivi**. Contrairement à hot/mid (projections du journal, zéro
/// invariant), le cold est un **agrégat** : le `status` suit un pipeline explicite
/// qui **ne recule jamais** (converted/lost terminaux). Vit dans le schéma `growth`
/// (donnée owned par le module croissance), pas dans `public`.
///
/// `linkedUserId` porte le **rapprochement** : quand le prospect démarché s'inscrit
/// (match e-mail), le lead est rattaché à son compte et converti. Indexé sur
/// `email` (clé du rapprochement) et `status` (filtrage de la file active).
model Lead {
  /// ULID préfixé `lead_` (fourni par l'IdGenerator).
  id String @id

  /// Raison sociale / nom de l'établissement démarché (seul champ obligatoire).
  businessName String @map("business_name")

  /// Contact chez le prospect, vide si non renseigné.
  contactName String @default("") @map("contact_name")

  /// E-mail du prospect — **clé de rapprochement** à l'inscription. Vide si inconnu.
  email String @default("")

  phone String @default("")

  /// SIRET si connu (identité business), vide sinon.
  siret String @default("")

  /// Étape du pipeline : new | contacted | qualified | negotiating | converted | lost.
  status String @default("new")

  /// Notes libres du commercial.
  notes String @default("")

  /// Compte rapproché (le prospect s'est inscrit), ou null. Pas de FK dure : le
  /// lead vit dans `growth` et ne dépend pas de la table `users` de `public`.
  linkedUserId String? @map("linked_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Dernier contact enregistré, ou null si jamais contacté.
  lastContactedAt DateTime? @map("last_contacted_at")

  @@index([email])
  @@index([status])
  @@map("leads")
  @@schema("growth")
}

// NB — Volontairement HORS de ce schéma :
// - ProductionPlan (« qtés à produire demain ») : c'est de la donnée PRODUCTION
//   (contexte interne/labo), pas du commerce customer-facing. Elle vit côté admin,
//   comme une projection dérivée des Order de ce schéma (calculée par le cron).
// - Cart : reste côté client (localStorage) jusqu'à la validation ; seule la
//   commande (Order) est persistée.
// - Stock : décision « source de vérité » reportée (Shopify vs nous).

// ─────────────────────────────────────────────────────────────────────────────
// Marché ciblé — pénétration par territoire (config commerciale staff)
// ─────────────────────────────────────────────────────────────────────────────

/// Un code NAF ciblé (catégorie d'acteurs professionnels visés). Config globale
/// staff, appliquée à toutes les zones lors du comptage via l'API entreprises.
model MarketNafCode {
  code      String   @id
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("market_naf_codes")
  @@schema("growth")
}

/// Une zone ciblée (code postal) avec le nombre d'acteurs visés STOCKÉ. `addressable`
/// = somme des comptages sur les NAF ciblés au dernier rafraîchissement ; `perNaf` =
/// le détail par code NAF ; `fetchedAt` = null tant qu'on n'a pas redemandé l'API.
model MarketZone {
  codePostal  String    @id @map("code_postal")
  addressable Int       @default(0)
  perNaf      Json      @default("[]") @map("per_naf")
  fetchedAt   DateTime? @map("fetched_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("market_zones")
  @@schema("growth")
}

/// Une **terminaison** de compte (churn), enregistrée à la clôture par le client ou
/// le commercial. `reason` = la catégorie de départ ; `outcome` distingue une
/// **tentative rattrapée** (`recovered`, le compte est resté) d'une **résiliation
/// confirmée** (`confirmed`). Sert au camembert des raisons (confirmées) et au taux
/// de rattrapage (recovered / tentatives), global et par catégorie.
model CompanyTermination {
  id           String    @id
  companyId    String    @map("company_id")
  /// price | competitor | closure | quality | no_need | unresponsive | other.
  reason       String
  /// Sous-raison précise (ex. `delivery_cost`, `catalog_price`), vide si non précisée.
  subReason    String    @default("") @map("sub_reason")
  /// 3ᵉ niveau optionnel (ex. catégorie produit sous `better_price`), vide sinon.
  detail       String    @default("") @map("detail")
  /// client | commercial (qui a enregistré la terminaison).
  initiatedBy  String    @map("initiated_by")
  /// confirmed (résilié) | recovered (rattrapé, compte conservé).
  outcome      String
  /// Pour un `recovered` : `auto` (plateforme) | `sales` (commercial), vide sinon.
  recoveredVia String    @default("") @map("recovered_via")
  /// Instant de l'action qui a rattrapé (délai de réaction), null si non rattrapée.
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([outcome, reason])
  @@map("company_terminations")
  @@schema("growth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Prise de rendez-vous — disponibilité déclarée + rendez-vous, schéma `growth`
// Doc : documentation/architecture-prise-de-rendez-vous.md
// ─────────────────────────────────────────────────────────────────────────────

/// **Règle hebdomadaire** de disponibilité commerciale : « le mardi, 09:00–12:00 ».
///
/// Une règle n'est PAS une liste de créneaux : les créneaux en sont **dérivés au
/// calcul** (`slotsFor`). Deux conséquences voulues — changer un horaire est un
/// `UPDATE` sur une ligne (pas une régénération), et il n'existe aucun créneau
/// persisté qui puisse diverger de l'horaire réel.
///
/// Les heures sont en **heure locale d'Europe/Paris** (`HH:MM`) : c'est ce que le
/// commercial saisit et pense, et la résolution en instant se fait au calcul —
/// donc le changement d'heure ne décale rien.
///
/// Pas de `staff_user_id` : la v1 porte **un agenda d'équipe**. L'identité staff
/// n'est pas dans le jeton aujourd'hui, une colonne qu'on ne saurait pas remplir
/// serait une dette. Extension prévue : la colonne nullable (null = équipe).
model AvailabilityRule {
  /// ULID préfixé `avrule_`.
  id String @id

  /// Jour de la semaine, convention `Date.getDay()` : 0 = dimanche … 6 = samedi.
  weekday Int

  /// Bornes locales `HH:MM`, `start` strictement avant `end` (garanti au contrat).
  startTime String @map("start_time")
  endTime   String @map("end_time")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([weekday])
  @@map("availability_rules")
  @@schema("growth")
}

/// **Exception** datée à la grille hebdomadaire : une fermeture (congés, férié) ou
/// une ouverture ponctuelle (un samedi de salon). Sans bornes, une fermeture ferme
/// la journée entière.
model AvailabilityException {
  /// ULID préfixé `avexc_`.
  id String @id

  /// Jour concerné, `AAAA-MM-JJ` en heure locale — un jour de calendrier, pas un
  /// instant : stocké en `DATE` pour qu'aucun fuseau ne puisse le décaler.
  day DateTime @db.Date

  /// `closed` (fermeture) | `open` (ouverture hors grille).
  kind String

  /// Bornes locales `HH:MM`, ou null pour une fermeture de journée entière.
  startTime String? @map("start_time")
  endTime   String? @map("end_time")

  /// Motif libre, affiché au commercial (« congés », « salon »).
  reason String @default("")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([day])
  @@map("availability_exceptions")
  @@schema("growth")
}

/// Un **rendez-vous** commercial posé sur un créneau.
///
/// `status` suit une machine à états à terminaux **définitifs** (`honored`,
/// `no_show`, `cancelled`) : reprogrammer, c'est annuler puis créer, avec
/// `rescheduled_from_id` pour garder le fil.
///
/// ⚠️ L'**exclusivité du créneau** ne tient pas en code applicatif (deux requêtes
/// concurrentes passeraient la même vérification avant qu'une seule n'écrive).
/// Elle est garantie par un **index unique partiel** posé en SQL brut dans la
/// migration — Prisma ne sait pas modéliser un index conditionnel :
///     CREATE UNIQUE INDEX appointments_slot_unique
///       ON growth.appointments (start_at) WHERE status <> 'cancelled';
/// Un rendez-vous annulé libère donc son créneau ; un rendez-vous actif le
/// verrouille. La violation se traduit en 409, jamais en 500.
///
/// Le **sujet est discriminé et non muré par la société** : un prospect froid
/// (`lead`) ou une personne sans société (`user`) doit pouvoir être reçu — c'est
/// justement la population qu'on cherche à capter. Pas de FK dure pour la même
/// raison que `Lead.linked_user_id` : `growth` ne dépend pas des tables de `public`.
model Appointment {
  /// ULID préfixé `appt_`.
  id String @id

  /// Bornes du rendez-vous, en **UTC** (la vérité ; la lecture locale se dérive).
  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  /// requested | confirmed | honored | no_show | cancelled.
  status String @default("requested")

  /// phone | visio | onsite.
  channel String

  /// Motif — discover | quote | order | recurring | billing | other.
  purpose String @default("other")

  /// company | lead | user.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  contactName  String @default("") @map("contact_name")
  contactEmail String @default("") @map("contact_email")
  contactPhone String @default("") @map("contact_phone")

  /// Message libre du demandeur.
  message String @default("")

  /// Motif d'annulation — exigé par l'agrégat quand on annule, vide sinon.
  cancelReason String @default("") @map("cancel_reason")

  /// Rendez-vous d'origine si celui-ci le reprogramme, null sinon.
  rescheduledFromId String? @map("rescheduled_from_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startAt])
  @@index([status])
  @@index([subjectType, subjectId])
  @@map("appointments")
  @@schema("growth")
}

/// **Politique de réservation** — les bornes que le commercial pose autour de sa
/// grille. Singleton (une constante fixe en `id` garantit l'unicité), et rangée
/// dans `growth` plutôt que dans `b2b_platform_settings` : `growth` ne doit
/// dépendre d'aucune table de `public`, c'est ce qui rend son extraction possible
/// le jour venu.
model BookingPolicySettings {
  id String @id

  /// Durée d'un rendez-vous, en minutes — aussi le pas de découpe des plages.
  slotMinutes Int @default(30) @map("slot_minutes")

  /// On ne réserve pas dans les N heures qui viennent (délai de prévenance).
  leadTimeHours Int @default(24) @map("lead_time_hours")

  /// On ne réserve pas au-delà de N jours (horizon).
  horizonDays Int @default(30) @map("horizon_days")

  /// Canaux proposés au client : phone | visio | onsite (au moins un).
  channels String[] @default(["phone"])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("booking_policy_settings")
  @@schema("growth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Alertes de compte client — cf. documentation/b2b/architecture-alertes-compte-client.md
// ─────────────────────────────────────────────────────────────────────────────

/// Le réglage **global** d'un type d'alerte : une ligne par type, valable pour
/// tous les comptes tant qu'aucune dérogation ne l'écrase.
///
/// `kind` est la clé, et il est en **String** (union validée au bord par Zod),
/// pas en enum Prisma : ajouter un type de détection ne doit pas coûter une
/// migration. `params` est discriminé par ce même `kind` côté contrat —
/// `thresholdPercent` n'a aucun sens pour « produit jamais pris ».
///
/// Une ligne **absente** = le type n'a jamais été touché : le lecteur retombe
/// alors sur les défauts déclarés dans `ALERT_KINDS`. C'est pour ça que
/// `updated_at` sert de « jamais réglé » à l'écran plutôt qu'une date inventée.
model AlertRuleSetting {
  kind String @id

  enabled Boolean @default(true)

  /// Paramètres du détecteur, forme dictée par `kind` (union discriminée Zod).
  params Json

  /// Canaux : { staffInApp, staffEmail, customerVisible }. Le journal du compte,
  /// lui, est inconditionnel — ces trois-là sont ce qu'on fait EN PLUS.
  delivery Json

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("alert_rule_settings")
  @@schema("public")
}

/// La **dérogation d'un compte** à une règle globale. Une ligne **seulement si**
/// le compte déroge : l'absence signifie « suit le réglage global », ce qui se
/// lit sans ambiguïté et n'oblige pas à semer une ligne par (compte × type).
///
/// `mode` = `off` (le type ne s'évalue pas ici) ou `custom` (le compte porte sa
/// propre règle). En `custom`, `params`/`delivery` sont **complets** — jamais un
/// diff : un override partiel obligerait à arbitrer ce que devient un champ à
/// moitié dérogé quand le global change, et il n'y a pas de bonne réponse.
model AccountAlertOverride {
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind String

  mode String

  /// Nuls en mode `off` : il n'y a rien à régler quand la règle est éteinte.
  enabled  Boolean?
  params   Json?
  delivery Json?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([companyId, kind])
  @@index([companyId])
  @@map("account_alert_overrides")
  @@schema("public")
}

/// Une **alerte déclenchée** : un type, une commande, et les lignes concernées.
///
/// Une ligne par (type × commande), **pas par produit** : un client qui élargit
/// sa gamme sur quinze références produirait quinze alertes, et la première vraie
/// utilisation noierait la liste. Le bruit est ainsi borné par construction.
///
/// `findings` est un **snapshot figé** (quantité, référence, écart, message) : la
/// moyenne d'aujourd'hui ne doit pas réécrire ce qu'on a constaté en mars. Une
/// alerte est un fait daté, pas une requête rejouée à l'affichage.
model AccountAlert {
  /// ULID (fourni par l'`IdGenerator`) : triable par le temps.
  id String @id

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind String

  orderId String @map("order_id")
  /// Référence humaine figée — c'est elle qu'on dicte au téléphone.
  orderNumber String @map("order_number")

  /// Anti-doublon : `kind:orderId`. Ne porte PAS les seuils — réévaluer après un
  /// ajustement de réglage ne doit pas repeupler l'historique.
  idempotencyKey String @unique @map("idempotency_key")

  /// Temps de l'ÉVÉNEMENT (autorité = `Clock`), distinct de l'écriture.
  occurredAt DateTime @map("occurred_at")

  /// Les constats, figés : [{ sku, productName, quantity, baseline, deviationPercent, message }].
  findings Json

  acknowledgedAt DateTime? @map("acknowledged_at")
  /// Le `sub` staff qui a acquitté — figé, résolvable même après un changement de nom.
  acknowledgedBy String? @map("acknowledged_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, occurredAt])
  @@index([companyId, acknowledgedAt])
  @@map("account_alerts")
  @@schema("public")
}

/// La **norme d'un produit** : ce qu'on en commande habituellement, tous comptes
/// confondus. Read-model **matérialisé**, recalculé par cron.
///
/// Pas calculable à la volée : un agrégat cross-comptes sur six mois, par SKU, à
/// chaque commande, c'est la requête qui met une base à genoux le jour où
/// l'historique grossit. Même patron que `LeadScore`.
///
/// `medianQuantity` et non une moyenne : une moyenne se fait déplacer par
/// l'aberration qu'on cherche, donc une faute de frappe passée une fois
/// éteindrait la détection des suivantes.
model ProductNorm {
  /// Référence catalogue (SKU du PIM) — String, pas une FK (autre db).
  sku String @id

  /// Médiane des quantités observées sur la fenêtre. Décimal : la médiane d'un
  /// échantillon pair tombe entre deux entiers.
  medianQuantity Decimal @map("median_quantity") @db.Decimal(12, 2)

  /// Nombre de lignes observées — sous un plancher, il n'y a pas de « norme ».
  sampleLines Int @map("sample_lines")

  /// La fenêtre sur laquelle cette norme a été mesurée, en jours.
  windowDays Int @map("window_days")

  computedAt DateTime @map("computed_at")

  @@map("product_norms")
  @@schema("public")
}
