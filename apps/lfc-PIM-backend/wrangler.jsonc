{
  // Backend PIM (NestJS) en Cloudflare Container. Consommé par
  // .github/workflows/deploy_pim_backend.yml.
  "name": "lfc-pim-backend",
  "main": "container/worker.ts",
  "compatibility_date": "2025-06-01",

  "containers": [
    {
      "class_name": "Backend",
      // Image pré-poussée sur le registre Cloudflare (build+push CI, contexte racine).
      // Deux placeholders remplacés au deploy : `__CF_ACCOUNT_ID__` par le secret
      // CLOUDFLARE_ACCOUNT_ID, et `__IMAGE_TAG__` par le SHA du commit.
      //
      // ⚠️ PAS de tag `latest` — Cloudflare Containers le refuse. Même raison et
      // même montage que le backend B2B, cf. son wrangler.jsonc.
      "image": "registry.cloudflare.com/__CF_ACCOUNT_ID__/lfc-pim-backend:__IMAGE_TAG__",
      "max_instances": 2,
      "instance_type": "basic",
      // Placement forcé en Europe de l'Ouest — le défaut « au plus près de la
      // requête qui démarre le container » avait posé le backend B2B à Dallas.
      // Même raison et même arbitrage (dont le refus de `jurisdiction`), cf. le
      // wrangler.jsonc du backend B2B.
      "constraints": { "regions": ["WEUR"] },
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],

  // PLUS AUCUNE ADRESSE PUBLIQUE. Ce Worker n'est joignable que par le service
  // binding de la passerelle (`gateway/wrangler.toml`) : c'est ce qui fait d'elle
  // une vraie frontière et non une décoration. Tant que `…workers.dev` répondait
  // au monde, la contourner suffisait à ignorer tout ce qu'elle applique.
  //
  // Ce qui continue de fonctionner sans adresse publique : les Cron Triggers
  // (attachés au Worker, pas à une URL) et l'accès au container par son binding
  // Durable Object. Ce qui cesse : tout appel entrant direct, y compris le nôtre.
  //
  // Vérifié avant de fermer — aucun tiers ne dépendait de cette adresse : le PIM
  // n'expose aucun webhook (zéro occurrence dans son code), et la cible du
  // webhook Stripe (`api-b2b.lafoliedouce.eu`) ne résout pas en DNS, donc elle
  // était déjà morte.
  //
  // ⚠️ Pour rouvrir en urgence : repasser à `true` et redéployer. La passerelle
  // reste le chemin normal ; ceci n'est qu'un interrupteur de secours.
  "workers_dev": false,

  // Rate limiting à l'edge (par IP cliente) : le Worker rejette en 429 AVANT de
  // réveiller le container. `period` n'accepte que 10 ou 60 (secondes). 300/min
  // = large pour un SPA connecté, mais coupe le flood d'une IP unique. La
  // protection volumétrique/distribuée reste l'anti-DDoS automatique Cloudflare.
  // ⚠️ Champ de PREMIER NIVEAU `ratelimits`, jamais `unsafe.bindings` : sous
  // l'ancienne forme la configuration n'était pas appliquée et `limit()` rendait
  // toujours `success: true`. Même correction et même mesure que côté B2B, cf.
  // son wrangler.jsonc.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
}
