{
  // `lfd-osrm` : le calcul d'itinéraires routiers de la Savoie, en Cloudflare
  // Container derrière un Worker d'entrée minimal (plan de tournée, lot 8,
  // forme B-ter — documentation/livraisons/plan-preparation-de-tournee.md).
  // Consommé par .github/workflows/deploy_lfd_osrm.yml (wrangler deploy).
  //
  // Il ne partage RIEN avec `lfd-api` : ni Worker, ni image, ni déploiement.
  // La carte se refait chaque mois sans toucher à l'API. Depuis le lot 8 bis,
  // l'API le joint par la passerelle (`/api/osrm`, jeton vérifié par elle), et
  // non plus par une interception dans son propre Worker.
  "name": "lfd-osrm",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",

  "containers": [
    {
      "class_name": "Osrm",
      // Image pré-poussée sur le registre Cloudflare par le workflow. Deux
      // placeholders, remplacés au déploiement : `__CF_ACCOUNT_ID__` par le
      // secret CLOUDFLARE_ACCOUNT_ID (jamais commité), `__IMAGE_TAG__` par le
      // tag de la CARTE — `savoie-AAAAMMJJ-osrm<version>`. Jamais `latest` :
      // Cloudflare le refuse, et l'image EST la carte — son tag est ce qui dit
      // laquelle tourne, et ce qu'on redéploie pour revenir à la précédente.
      "image": "registry.cloudflare.com/__CF_ACCOUNT_ID__/lfd-osrm:__IMAGE_TAG__",
      // `lite` (1/16 vCPU, 256 MiB, 2 Go de disque) : `osrm-routed` chargé tient
      // en 47 à 51 Mo, l'image en ≈ 220 Mo (mesuré le 2026-09-29, L8-C6).
      "instance_type": "lite",
      // Une instance : OSRM est sans état et son trafic tient en quelques
      // appels par matin. Plusieurs instances n'apporteraient que des réveils.
      "max_instances": 1,
      // Même placement que `lfd-api`, qui seul l'interroge : Europe de l'Ouest.
      "constraints": { "regions": ["WEUR"] },
    },
  ],

  "durable_objects": {
    "bindings": [{ "name": "OSRM", "class_name": "Osrm" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Osrm"] }],

  // AUCUNE ADRESSE PUBLIQUE, ni `workers.dev` ni route : le seul appelant est
  // la passerelle, par son service binding `OSRM` (`gateway/wrangler.toml`),
  // qui exige le jeton avant de router. Une adresse ici serait une seconde
  // porte ouverte au monde, sans jeton, à côté de la passerelle.
  "workers_dev": false,

  // AUCUN cron, délibérément : `lfd-api` en a un pour rester chaud, OSRM non.
  // Endormi, un conteneur n'est pas facturé (L8-C11) ; il se réveille au
  // premier appel du matin.

  "observability": {
    "enabled": true,
  },
}
