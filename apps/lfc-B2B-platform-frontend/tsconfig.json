/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  // Flags stricts (calqués sur fold-ng) hérités de la base du monorepo. Ici on
  // ne garde que ce qui est propre à cette app : cible/module. Ne PAS déclarer
  // d'`angularCompilerOptions` — un bloc enfant remplacerait celui des flags.
  "extends": "../../tsconfig.flags.frontend.json",
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    // Packages du workspace résolus vers leur SOURCE (pas leur build) : compilés
    // par cette app via ces mappings. Conséquence voulue : Vite les traite comme
    // du code projet, pas comme des deps externes — il ne les pré-bundle donc pas
    // dans `vite/deps`, ce qui supprime le cache figé « does not provide an export
    // named X » quand on ajoute un export au package. `@lfd/endpoints` (un seul
    // fichier, zéro import externe) comme `@lfd/b2b-ui` : un subpath par domaine.
    "paths": {
      "@lfd/front-ops": ["../../packages/front-ops/src/index.ts"],
      "@lfd/b2b-ui/appointment": ["../../packages/b2b-ui/src/appointment/index.ts"],
      "@lfd/b2b-ui/cart": ["../../packages/b2b-ui/src/cart/index.ts"],
      "@lfd/b2b-ui/catalog": ["../../packages/b2b-ui/src/catalog/index.ts"],
      "@lfd/b2b-ui/address": ["../../packages/b2b-ui/src/address/index.ts"],
      "@lfd/b2b-ui/company": ["../../packages/b2b-ui/src/company/index.ts"],
      "@lfd/b2b-ui/hours": ["../../packages/b2b-ui/src/hours/index.ts"],
      "@lfd/b2b-ui/order": ["../../packages/b2b-ui/src/order/index.ts"],
      "@lfd/b2b-ui/panel": ["../../packages/b2b-ui/src/panel/index.ts"],
      "@lfd/b2b-ui/pricing": ["../../packages/b2b-ui/src/pricing/index.ts"],
      "@lfd/b2b-ui/subscription": ["../../packages/b2b-ui/src/subscription/index.ts"],
      "@lfd/endpoints": ["../../packages/endpoints/src/index.ts"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
