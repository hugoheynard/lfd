{
  "name": "lfc-b2b-platform-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config:auth": "node scripts/generate-auth-config.mjs",
    "start": "pnpm config:auth && ng serve",
    "build": "pnpm config:auth && ng build",
    "build:cloudflare": "pnpm config:auth && ng build --configuration cloudflare",
    "watch": "pnpm config:auth && ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "dev": "pnpm config:auth && node ../../dev-toolbox/ng-serve-quiet.mjs",
    "postinstall": "pnpm config:auth"
  },
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@auth0/auth0-angular": "^2.11.0",
    "@lfd/b2b-ui": "workspace:*",
    "@lfd/contracts": "workspace:*",
    "@lfd/endpoints": "workspace:*",
    "@stripe/stripe-js": "^9.13.0",
    "fold-ng": "catalog:",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@types/node": "^26.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
