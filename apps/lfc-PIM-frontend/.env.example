# Config d'environnement du PIM front — injectée au BUILD.
#
# Le PIM front est iframé sous le shell (il reçoit son jeton via SuiteBridge) : sa seule
# variable d'environnement est l'URL de SON backend. Pas d'Auth0 propre ici.
#
# Dev local : `cp .env.example .env` (ou laisse : on retombe sur localhost:3100).
# Déployé   : mets PIM_API_BASE_URL en variable de build (GitHub Actions / Cloudflare).
# Pas un secret — juste une origine.

# URL du backend PIM (en prod : le sous-domaine gateway, ex. https://api-pim.<zone>)
PIM_API_BASE_URL=http://localhost:3100
