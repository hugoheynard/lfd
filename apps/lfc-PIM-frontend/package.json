{
  "name": "lfc-pim-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config:api": "node scripts/generate-api-config.mjs",
    "start": "pnpm config:api && ng serve",
    "build": "pnpm config:api && ng build",
    "build:cloudflare": "pnpm config:api && ng build --configuration cloudflare",
    "watch": "pnpm config:api && ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "dev": "pnpm config:api && node ../../dev-toolbox/ng-serve-quiet.mjs",
    "postinstall": "pnpm config:api"
  },
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@lfd/pim-contracts": "workspace:*",
    "@lfd/suite-embed": "workspace:*",
    "fold-ng": "catalog:",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@types/node": "^26.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
