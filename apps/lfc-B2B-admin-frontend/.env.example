# Config d'environnement du B2B admin front — injectée au BUILD (prod).
#
# Le B2B admin est iframé sous le shell (jeton via SuiteBridge) : sa seule variable
# d'environnement est l'URL de SON backend (surface /admin du backend B2B).
# En DEV, angular.json substitue api-config.ts par api-config.dev.ts (gateway-aware,
# @lfd/endpoints) — cette variable ne sert donc qu'au build PROD/cloudflare.
#
# Déployé : mets B2B_ADMIN_API_BASE_URL en variable de build (GitHub Actions / Cloudflare).
# Pas un secret — juste une origine.

# URL du backend B2B (en prod : le sous-domaine gateway, ex. https://api-b2b.<zone>)
B2B_ADMIN_API_BASE_URL=https://api-b2b.lafoliecoffee.xyz
