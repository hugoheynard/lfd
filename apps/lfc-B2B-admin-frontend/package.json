{
  "name": "lfc-b2b-admin-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config:api": "node scripts/generate-api-config.mjs",
    "start": "pnpm config:api && pnpm config:auth && ng serve",
    "build": "pnpm config:api && pnpm config:auth && ng build",
    "build:cloudflare": "pnpm config:api && pnpm config:auth && ng build --configuration cloudflare",
    "watch": "pnpm config:api && pnpm config:auth && ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src --fix",
    "lint:ci": "eslint src",
    "test:watch": "ng test --watch",
    "dev": "pnpm config:api && pnpm config:auth && node ../../dev-toolbox/ng-serve-quiet.mjs",
    "postinstall": "pnpm config:api && pnpm config:auth",
    "config:auth": "node scripts/generate-auth-config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@auth0/auth0-angular": "catalog:",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@lfd/b2b-ui": "workspace:*",
    "@lfd/catalog-ui": "workspace:*",
    "@lfd/contracts": "workspace:*",
    "@lfd/endpoints": "workspace:*",
    "@lfd/front-ops": "workspace:*",
    "@lfd/ops-contract": "workspace:*",
    "@lfd/pim-contracts": "workspace:*",
    "@sentry/angular": "catalog:",
    "@stripe/stripe-js": "catalog:",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "echarts": "^6.1.0",
    "fold-ng": "catalog:",
    "qrcode-generator": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:",
    "web-vitals": "catalog:"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "catalog:",
    "@analogjs/vitest-angular": "catalog:",
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "catalog:",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
