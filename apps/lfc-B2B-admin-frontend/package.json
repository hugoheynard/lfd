{
  "name": "lfc-b2b-admin-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config:api": "node scripts/generate-api-config.mjs",
    "start": "pnpm config:api && pnpm config:auth && ng serve",
    "build": "pnpm config:api && pnpm config:auth && ng build",
    "build:cloudflare": "pnpm config:api && pnpm config:auth && ng build --configuration cloudflare",
    "watch": "pnpm config:api && pnpm config:auth && ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "dev": "pnpm config:api && pnpm config:auth && node ../../dev-toolbox/ng-serve-quiet.mjs",
    "postinstall": "pnpm config:api && pnpm config:auth",
    "config:auth": "node scripts/generate-auth-config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@auth0/auth0-angular": "^2.11.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@lfd/b2b-ui": "workspace:*",
    "@lfd/catalog-ui": "workspace:*",
    "@lfd/contracts": "workspace:*",
    "@lfd/endpoints": "workspace:*",
    "@lfd/suite-embed": "workspace:*",
    "@stripe/stripe-js": "^9.13.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "echarts": "^6.1.0",
    "fold-ng": "catalog:",
    "qrcode-generator": "^2.0.4",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.2",
    "@analogjs/vitest-angular": "^2.6.2",
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "catalog:",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "typescript": "catalog:",
    "vitest": "^4.0.8"
  }
}
