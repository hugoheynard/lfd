{
  "name": "lfc-suite-shell",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "config:auth": "node scripts/generate-auth-config.mjs",
    "start": "pnpm config:auth && ng serve",
    "build": "pnpm config:auth && ng build",
    "build:cloudflare": "pnpm config:auth && ng build --configuration cloudflare",
    "watch": "pnpm config:auth && ng build --watch --configuration development",
    "test": "ng test",
    "dev": "pnpm config:auth && node ../../dev-toolbox/ng-serve-quiet.mjs",
    "postinstall": "pnpm config:auth"
  },
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@angular/common": "catalog:",
    "@angular/compiler": "catalog:",
    "@angular/core": "catalog:",
    "@angular/forms": "catalog:",
    "@angular/platform-browser": "catalog:",
    "@angular/router": "catalog:",
    "@auth0/auth0-angular": "catalog:",
    "@lfd/endpoints": "workspace:*",
    "@lfd/front-ops": "workspace:*",
    "@lfd/suite-embed": "workspace:*",
    "fold-ng": "catalog:",
    "rxjs": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "catalog:",
    "@analogjs/vitest-angular": "catalog:",
    "@angular/build": "catalog:",
    "@angular/cli": "catalog:",
    "@angular/compiler-cli": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
