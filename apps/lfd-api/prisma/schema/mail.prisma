// ─────────────────────────────────────────────────────────────────────────────
// MAIL — le service d'e-mails, son propre schéma (2026-11-06)
// ─────────────────────────────────────────────────────────────────────────────
//
// Plan `documentation/editeur-de-contenu/plan-service-e-mails.md`, lot S0 : le
// schéma est déclaré AVANT le premier modèle, pour que les portes le
// connaissent avant le premier fichier du bloc `src/mail/`. S1 y pose les
// demandes et leur suivi.
//
// ⚠️ Les trois tables `public.mail_copy_*` / `public.mail_section_orders`
// RESTENT dans `public` (plan, S3) : seul leur écrivain changera. Ce fichier ne
// porte que les tables neuves du bloc.

/// **Une demande d'e-mail et son suivi** (S1, C7) : ce qui a été demandé, à
/// qui, et ce qu'il en est advenu. Écrite dans la transaction de l'appelant
/// (`mail.send`) ou après l'envoi (`mail.sendAndAwaitReceipt`) ; les données du modèle n'y sont
/// PAS — elles voyagent dans le fait `mail.requested` de la boîte d'envoi.
///
/// ⚠️ `recipient` est une donnée personnelle (client ou staff), au registre
/// RGPD. Durée décidée par Hugo le 2026-11-06 (plan § 7) : une demande close
/// (`sent`, `failed`, `refused`) se garde **1 an**. La purge est bâtie À BLANC
/// (`MAIL_REQUEST_PURGE`, `dry-run` par défaut) : elle compte, elle ne
/// supprime rien tant que Hugo ne l'a pas activée.
model MailRequest {
  id              String    @id
  /// La clé du registre `B2bMails` (`customer.order-ready`).
  template        String    @db.VarChar(80)
  /// L'espace du modèle, `lfc` ou `lfd` (CHECK en base, C3).
  brand           String    @db.VarChar(16)
  /// L'adresse du destinataire.
  recipient       String    @db.VarChar(320)
  /// La langue lue dans les données du modèle ; `null` s'il n'en déclare pas.
  locale          String?   @db.VarChar(8)
  /// `requested` | `sending` | `sent` | `failed` | `refused` (CHECK en base).
  status          String    @db.VarChar(10)
  /// L'identifiant Resend ; `null` tant que rien n'est parti, ou en mode à blanc.
  providerId      String?   @map("provider_id")
  /// Unique : un rejeu ne crée pas une seconde demande.
  idempotencyKey  String    @unique @map("idempotency_key") @db.VarChar(200)
  /// La raison d'un échec ou d'un refus, tronquée à 500 caractères.
  failureReason   String?   @map("failure_reason") @db.VarChar(500)
  requestedAt     DateTime  @map("requested_at") @db.Timestamptz(6)
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(6)
  /// L'instant du dernier échec ou du refus.
  failedAt        DateTime? @map("failed_at") @db.Timestamptz(6)
  /// Le premier envoi différé engagé (S1b) : la fenêtre de reprise (23 h) en part.
  firstAttemptAt  DateTime? @map("first_attempt_at") @db.Timestamptz(6)
  /// Le dernier envoi différé engagé : un `sending` plus vieux est orphelin.
  lastAttemptAt   DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  /// Les envois différés engagés (plafond dans l'agrégat).
  attempts        Int       @default(0)
  /// La version publiée du document qui a composé l'envoi (plan
  /// `plan-editeur-par-blocs.md`, § 5, S4c) ; `null` = le document de départ,
  /// ou rien d'envoyé encore.
  documentVersion Int?      @map("document_version")

  @@index([status, requestedAt])
  @@index([status, lastAttemptAt])
  @@map("mail_request")
  @@schema("mail")
}

/// **Le document d'un e-mail** (plan `plan-editeur-par-blocs.md`, § 5, S4c) :
/// l'arrangement de ses blocs, en brouillon et publié. Les phrases n'y sont
/// JAMAIS : elles restent au dictionnaire (`public.mail_copy_entries`).
///
/// Pas de ligne = le document de départ, calculé à la lecture. Jamais
/// supprimé : « revenir au modèle d'origine » vide `published` et `draft`, la
/// ligne reste, avec son auteur.
model MailDocument {
  /// La clé du registre (`customer.order-ready`).
  template         String    @id @db.VarChar(80)
  /// Monte à chaque écriture : le verrou entre deux rédacteurs.
  revision         Int
  /// Le brouillon (`MailDocument` de `@lfd/mail-blocks`) ; `null` = aucun.
  draft            Json?
  draftAt          DateTime? @map("draft_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  draftBy          String?   @map("draft_by")
  /// Le document envoyé ; `null` = le document de départ.
  published        Json?
  publishedVersion Int?      @map("published_version")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  publishedBy      String?   @map("published_by")
  /// La dernière version posée, publiée ou retirée depuis : la suivante en part.
  lastVersion      Int       @default(0) @map("last_version")
  retractedAt      DateTime? @map("retracted_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  retractedBy      String?   @map("retracted_by")

  @@map("mail_document")
  @@schema("mail")
}

/// **Une version publiée d'un document d'e-mail**, en AJOUT SEUL (un
/// déclencheur refuse UPDATE et DELETE) : `mail_request.document_version` la
/// désigne, et dit quel texte a composé un envoi.
model MailDocumentVersion {
  template    String   @db.VarChar(80)
  version     Int
  document    Json
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  publishedBy String   @map("published_by")

  @@id([template, version])
  @@map("mail_document_version")
  @@schema("mail")
}

/// La charte graphique d'un espace d'e-mails (plan
/// `plan-editeur-par-blocs.md`, § 25, C1) — `lfc` ou `lfd`. Pas de ligne = la
/// charte de départ, calculée depuis les constantes du rendu.
model MailCharter {
  /// L'espace (`lfc`, `lfd`) ; `internal` est rangé dans `lfd`.
  space            String    @id @db.VarChar(16)
  /// Monte à chaque écriture : le verrou entre deux rédacteurs.
  revision         Int
  /// Le brouillon (`MailCharterSettings` de `@lfd/mail-blocks`) ; `null` = aucun.
  draft            Json?
  draftAt          DateTime? @map("draft_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  draftBy          String?   @map("draft_by")
  /// La charte en service, logo pointant vers sa copie ; `null` = la charte de départ.
  published        Json?
  publishedVersion Int?      @map("published_version")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  publishedBy      String?   @map("published_by")
  /// La dernière version posée : la suivante en part.
  lastVersion      Int       @default(0) @map("last_version")

  @@map("mail_charter")
  @@schema("mail")
}

/// Chaque charte publiée, en ajout seul (un déclencheur refuse UPDATE et DELETE).
model MailCharterVersion {
  space       String   @db.VarChar(16)
  version     Int
  settings    Json
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  publishedBy String   @map("published_by")

  @@id([space, version])
  @@map("mail_charter_version")
  @@schema("mail")
}

/// **L'identité d'envoi d'un espace** (plan `plan-editeur-par-blocs.md`,
/// § 25, C3) : le nom d'expéditeur, l'adresse d'envoi, l'adresse de réponse.
/// Pas de ligne = l'identité par défaut de la configuration
/// (`MAILER_FROM_ADDRESS`, `MAILER_REPLY_TO`). Enregistrée seulement si le
/// domaine de l'adresse d'envoi est vérifié chez Resend et qu'un essai est
/// parti sous elle.
model MailSenderIdentity {
  /// L'espace (`lfc`, `lfd`) ; `internal` est rangé dans `lfd`.
  space          String   @id @db.VarChar(16)
  /// Monte à chaque écriture : le verrou entre deux rédacteurs.
  revision       Int
  /// Le nom affiché devant l'adresse (« La Folie Douce »).
  senderName     String   @map("sender_name") @db.VarChar(80)
  /// L'adresse d'envoi, sur un domaine vérifié chez Resend.
  fromAddress    String   @map("from_address") @db.VarChar(254)
  /// L'adresse de réponse ; `null` = les réponses vont à l'adresse d'envoi.
  replyToAddress String?  @map("reply_to_address") @db.VarChar(254)
  changedAt      DateTime @map("changed_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  changedBy      String   @map("changed_by")

  @@map("mail_sender_identity")
  @@schema("mail")
}
