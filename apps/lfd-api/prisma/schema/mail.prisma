// ─────────────────────────────────────────────────────────────────────────────
// MAIL — le service d'e-mails, son propre schéma (2026-11-06)
// ─────────────────────────────────────────────────────────────────────────────
//
// Plan `documentation/mail/plan-service-e-mails.md`, lot S0 : le
// schéma est déclaré AVANT le premier modèle, pour que les portes le
// connaissent avant le premier fichier du bloc `src/mail/`. S1 y pose les
// demandes et leur suivi.
//
// ⚠️ Les trois tables `public.mail_copy_*` / `public.mail_section_orders`
// RESTENT dans `public` (plan, S3) : seul leur écrivain changera. Ce fichier ne
// porte que les tables neuves du bloc.

/// **Une demande d'e-mail et son suivi** (S1, C7) : ce qui a été demandé, à
/// qui, et ce qu'il en est advenu. Écrite dans la transaction de l'appelant
/// (`mail.send`) ou après l'envoi (`mail.sendAndAwaitReceipt`) ; les données du modèle n'y sont
/// PAS — elles voyagent dans le fait `mail.requested` de la boîte d'envoi.
///
/// ⚠️ `recipient` est une donnée personnelle (client ou staff), au registre
/// RGPD. Durée décidée par Hugo le 2026-11-06 (plan § 7) : une demande close
/// (`sent`, `failed`, `refused`) se garde **1 an**. La purge est bâtie À BLANC
/// (`MAIL_REQUEST_PURGE`, `dry-run` par défaut) : elle compte, elle ne
/// supprime rien tant que Hugo ne l'a pas activée.
model MailRequest {
  id              String               @id
  /// La clé du registre `B2bMails` (`customer.order-ready`).
  template        String               @db.VarChar(80)
  /// L'espace du modèle, `lfc` ou `lfd` (CHECK en base, C3).
  brand           String               @db.VarChar(16)
  /// L'adresse du destinataire.
  recipient       String               @db.VarChar(320)
  /// La langue lue dans les données du modèle ; `null` s'il n'en déclare pas.
  locale          String?              @db.VarChar(8)
  /// `requested` | `sending` | `sent` | `failed` | `refused` (CHECK en base).
  status          String               @db.VarChar(10)
  /// L'identifiant Resend ; `null` tant que rien n'est parti, ou en mode à blanc.
  providerId      String?              @map("provider_id")
  /// Unique : un rejeu ne crée pas une seconde demande.
  idempotencyKey  String               @unique @map("idempotency_key") @db.VarChar(200)
  /// La raison d'un échec ou d'un refus, tronquée à 500 caractères.
  failureReason   String?              @map("failure_reason") @db.VarChar(500)
  requestedAt     DateTime             @map("requested_at") @db.Timestamptz(6)
  sentAt          DateTime?            @map("sent_at") @db.Timestamptz(6)
  /// L'instant du dernier échec ou du refus.
  failedAt        DateTime?            @map("failed_at") @db.Timestamptz(6)
  /// Le premier envoi différé engagé (S1b) : la fenêtre de reprise (23 h) en part.
  firstAttemptAt  DateTime?            @map("first_attempt_at") @db.Timestamptz(6)
  /// Le dernier envoi différé engagé : un `sending` plus vieux est orphelin.
  lastAttemptAt   DateTime?            @map("last_attempt_at") @db.Timestamptz(6)
  /// Les envois différés engagés (plafond dans l'agrégat).
  attempts        Int                  @default(0)
  /// La version publiée du document qui a composé l'envoi (plan
  /// `plan-editeur-par-blocs.md`, § 5, S4c) ; `null` = le document de départ,
  /// ou rien d'envoyé encore.
  documentVersion Int?                 @map("document_version")
  /// L'adresse en minuscules, écrite par l'agrégat (plan
  /// `le-suivi-des-e-mails.md`, décision 9) ; la recherche y compare.
  /// Nullable : une demande écrite par un binaire d'avant T1 n'en porte pas.
  recipientKey    String?              @map("recipient_key") @db.VarChar(320)
  /// Le retour du fournisseur (décision 1) : `delayed` | `delivered` |
  /// `complained` | `bounced` (CHECK en base) ; `null` = rien reçu.
  delivery        String?              @db.VarChar(12)
  deliveryAt      DateTime?            @map("delivery_at") @db.Timestamptz(6)
  /// Le GENRE du retour (`Permanent/Suppressed`), jamais son texte (décision 4).
  deliveryKind    String?              @map("delivery_kind") @db.VarChar(64)
  /// La raison FERMÉE d'un refus (plan `plan-desinscription-des-e-mails.md`,
  /// U2) : `unsubscribed` | `no_consent` (CHECK en base) ; `null` hors de ces
  /// refus. Le suivi l'affiche sans lire `failure_reason`.
  refusalCode     String?              @map("refusal_code") @db.VarChar(16)
  /// Ce pour quoi l'e-mail part (`le-sujet-des-e-mails.md`, règle 2).
  subjects        MailRequestSubject[]

  @@index([status, requestedAt])
  @@index([status, lastAttemptAt])
  @@index([providerId])
  @@index([recipientKey])
  @@index([delivery, deliveryAt])
  @@map("mail_request")
  @@schema("mail")
}

/// **Un sujet d'une demande d'e-mail** (`le-sujet-des-e-mails.md`,
/// règles 1 et 2) : un type de la liste fermée du canal (`order`,
/// `account`…) et un identifiant OPAQUE — le bloc `mail` ne lit jamais
/// l'objet désigné. Plusieurs par demande (une facture nomme chacune de ses
/// commandes). Écrit avec la demande, jamais changé ; emporté par sa purge
/// (ON DELETE CASCADE). L'index `(subject_type, subject_id)` sert la fiche
/// d'une commande, qui lit ses e-mails.
model MailRequestSubject {
  requestId   String      @map("request_id")
  /// Le type fermé (`order`) — la liste est dans le canal, pas en base.
  subjectType String      @map("subject_type") @db.VarChar(32)
  /// L'identifiant opaque de l'objet, 120 caractères au plus.
  subjectId   String      @map("subject_id") @db.VarChar(120)
  request     MailRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([requestId, subjectType, subjectId])
  @@index([subjectType, subjectId])
  @@map("mail_request_subject")
  @@schema("mail")
}

/// **Un retour du fournisseur, rangé avant d'être appliqué** (plan
/// `le-suivi-des-e-mails.md`, décision 2) : un rebond peut arriver avant
/// que la demande n'ait reçu son `provider_id`. Le webhook range d'abord ici —
/// `svix_id` unique, c'est lui qui dédoublonne un rejeu — puis applique aux
/// demandes connues ; la demande relit ses retours à la pose de son
/// identifiant, et le balayeur applique le reste. Aucun texte du fournisseur :
/// le genre seulement. Un retour sans demande au bout de 30 jours est purgé.
model MailDeliveryEvent {
  id         String   @id
  /// L'identifiant du message Svix : un rejeu ne range pas deux fois.
  svixId     String   @unique @map("svix_id") @db.VarChar(200)
  /// L'identifiant Resend de l'e-mail (`data.email_id`).
  providerId String   @map("provider_id")
  /// `delayed` | `delivered` | `complained` | `bounced` (CHECK en base).
  delivery   String   @db.VarChar(12)
  /// Le genre du retour (`Permanent/Suppressed`), jamais son texte.
  kind       String?  @db.VarChar(64)
  /// L'instant du retour chez le fournisseur (`created_at` de l'événement).
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  /// L'instant où nous l'avons reçu : la purge des orphelins en part.
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)

  @@index([providerId])
  @@index([receivedAt])
  @@map("mail_delivery_event")
  @@schema("mail")
}

/// **Une adresse révélée** dans le suivi des e-mails (plan
/// `le-suivi-des-e-mails.md`, décision 7, T2) : qui, quel envoi, quand —
/// jamais l'adresse. La lecture de l'adresse n'est permise qu'à ce membre du
/// staff, pour cet envoi, dans les 5 minutes ; la ligne compte aussi dans le
/// plafond de 30 consultations par heure et par personne.
///
/// Pas de clé étrangère vers `mail_request` : la demande se purge à 1 an, la
/// trace aussi, chacune de son côté. Purgée à 1 an sous `MAIL_REQUEST_PURGE`.
model MailRecipientReveal {
  id            String   @id
  /// La demande d'e-mail dont l'adresse a été révélée.
  mailRequestId String   @map("mail_request_id")
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  revealedBy    String   @map("revealed_by")
  revealedAt    DateTime @map("revealed_at") @db.Timestamptz(6)

  @@index([revealedBy, revealedAt])
  @@index([revealedBy, mailRequestId, revealedAt])
  @@index([revealedAt])
  @@map("mail_recipient_reveal")
  @@schema("mail")
}

/// **Un envoi trouvé par une recherche**, figé à l'instant de la recherche
/// (T2) : la lecture des résultats ne recherche pas de nouveau — elle n'a pas
/// l'adresse. Supprimé avec sa recherche (cascade, purge à 1 an).
model MailRecipientSearchHit {
  searchId      String              @map("search_id")
  mailRequestId String              @map("mail_request_id")
  search        MailRecipientSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@id([searchId, mailRequestId])
  @@map("mail_recipient_search_hit")
  @@schema("mail")
}

/// **Une recherche des envois d'une adresse** (décision 8, T2) : qui, quand,
/// et l'EMPREINTE de l'adresse cherchée (`HMAC-SHA256` sous
/// `AppConfig.mailRecipientSearchKey`) — jamais l'adresse. Compte dans le même
/// plafond horaire que les révélations. Purgée à 1 an sous `MAIL_REQUEST_PURGE`.
model MailRecipientSearch {
  id                   String                   @id
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  searchedBy           String                   @map("searched_by")
  /// `HMAC-SHA256` de l'adresse normalisée, en hexadécimal (64 caractères).
  recipientFingerprint String                   @map("recipient_fingerprint") @db.VarChar(64)
  searchedAt           DateTime                 @map("searched_at") @db.Timestamptz(6)
  hits                 MailRecipientSearchHit[]

  @@index([searchedBy, searchedAt])
  @@index([searchedAt])
  @@map("mail_recipient_search")
  @@schema("mail")
}

/// **Le document d'un e-mail** (plan `plan-editeur-par-blocs.md`, § 5, S4c) :
/// l'arrangement de ses blocs, en brouillon et publié. Les phrases n'y sont
/// JAMAIS : elles restent au dictionnaire (`public.mail_copy_entries`).
///
/// Pas de ligne = le document de départ, calculé à la lecture. Jamais
/// supprimé : « revenir au modèle d'origine » vide `published` et `draft`, la
/// ligne reste, avec son auteur.
model MailDocument {
  /// La clé du registre (`customer.order-ready`).
  template         String    @id @db.VarChar(80)
  /// Monte à chaque écriture : le verrou entre deux rédacteurs.
  revision         Int
  /// Le brouillon (`MailDocument` de `@lfd/mail-blocks`) ; `null` = aucun.
  draft            Json?
  draftAt          DateTime? @map("draft_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  draftBy          String?   @map("draft_by")
  /// Le document envoyé ; `null` = le document de départ.
  published        Json?
  publishedVersion Int?      @map("published_version")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  publishedBy      String?   @map("published_by")
  /// La dernière version posée, publiée ou retirée depuis : la suivante en part.
  lastVersion      Int       @default(0) @map("last_version")
  retractedAt      DateTime? @map("retracted_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  retractedBy      String?   @map("retracted_by")

  @@map("mail_document")
  @@schema("mail")
}

/// **Une version publiée d'un document d'e-mail**, en AJOUT SEUL (un
/// déclencheur refuse UPDATE et DELETE) : `mail_request.document_version` la
/// désigne, et dit quel texte a composé un envoi.
model MailDocumentVersion {
  template    String   @db.VarChar(80)
  version     Int
  document    Json
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  publishedBy String   @map("published_by")

  @@id([template, version])
  @@map("mail_document_version")
  @@schema("mail")
}

/// La charte graphique d'un espace d'e-mails (plan
/// `plan-editeur-par-blocs.md`, § 25, C1) — `lfc` ou `lfd`. Pas de ligne = la
/// charte de départ, calculée depuis les constantes du rendu.
model MailCharter {
  /// L'espace (`lfc`, `lfd`) ; `internal` est rangé dans `lfd`.
  space            String    @id @db.VarChar(16)
  /// Monte à chaque écriture : le verrou entre deux rédacteurs.
  revision         Int
  /// Le brouillon (`MailCharterSettings` de `@lfd/mail-blocks`) ; `null` = aucun.
  draft            Json?
  draftAt          DateTime? @map("draft_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  draftBy          String?   @map("draft_by")
  /// La charte en service, logo pointant vers sa copie ; `null` = la charte de départ.
  published        Json?
  publishedVersion Int?      @map("published_version")
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  publishedBy      String?   @map("published_by")
  /// La dernière version posée : la suivante en part.
  lastVersion      Int       @default(0) @map("last_version")

  @@map("mail_charter")
  @@schema("mail")
}

/// Chaque charte publiée, en ajout seul (un déclencheur refuse UPDATE et DELETE).
model MailCharterVersion {
  space       String   @db.VarChar(16)
  version     Int
  settings    Json
  publishedAt DateTime @map("published_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  publishedBy String   @map("published_by")

  @@id([space, version])
  @@map("mail_charter_version")
  @@schema("mail")
}

/// **L'identité d'envoi d'un espace** (plan `plan-editeur-par-blocs.md`,
/// § 25, C3) : le nom d'expéditeur, l'adresse d'envoi, l'adresse de réponse.
/// Pas de ligne = l'identité par défaut de la configuration
/// (`MAILER_FROM_ADDRESS`, `MAILER_REPLY_TO`). Enregistrée seulement si le
/// domaine de l'adresse d'envoi est vérifié chez Resend et qu'un essai est
/// parti sous elle.
model MailSenderIdentity {
  /// L'espace (`lfc`, `lfd`) ; `internal` est rangé dans `lfd`.
  space          String   @id @db.VarChar(16)
  /// Monte à chaque écriture : le verrou entre deux rédacteurs.
  revision       Int
  /// Le nom affiché devant l'adresse (« La Folie Douce »).
  senderName     String   @map("sender_name") @db.VarChar(80)
  /// L'adresse d'envoi, sur un domaine vérifié chez Resend.
  fromAddress    String   @map("from_address") @db.VarChar(254)
  /// L'adresse de réponse ; `null` = les réponses vont à l'adresse d'envoi.
  replyToAddress String?  @map("reply_to_address") @db.VarChar(254)
  changedAt      DateTime @map("changed_at") @db.Timestamptz(6)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  changedBy      String   @map("changed_by")

  @@map("mail_sender_identity")
  @@schema("mail")
}

/// **La préférence marketing d'une adresse pour un espace** (plan
/// `documentation/mail/plan-desinscription-des-e-mails.md`, règles 10, 20,
/// 22, 23 ; lot U2) : le registre unique de l'accord et du retrait. Pas de
/// ligne = jamais demandé. L'espace est la société émettrice (`lfc`).
///
/// ⚠️ `recipient_key` est une donnée personnelle de client, au registre RGPD,
/// gardée tant que l'accord ou la désinscription vaut. À l'effacement, une
/// ligne `pending` ou `accepted` est supprimée ; une ligne `unsubscribed`
/// perd sa clé et garde son EMPREINTE (`print`, HMAC à clé, pseudonyme) — la
/// supprimer reviendrait à réécrire à quelqu'un qui a dit non.
model MailMarketingPreference {
  id                  String    @id
  /// L'espace qui écrit (`lfc` | `lfd`, CHECK en base).
  space               String    @db.VarChar(16)
  /// L'adresse en minuscules ; `null` une fois effacée (seulement `unsubscribed`).
  recipientKey        String?   @map("recipient_key") @db.VarChar(320)
  /// `HMAC-SHA256(recipient_key)` sous `AppConfig.mailMarketingPrintKey`, 64 hexadécimaux.
  print               String    @db.VarChar(64)
  /// `pending` | `accepted` | `unsubscribed` (CHECK en base).
  status              String    @db.VarChar(12)
  /// `direct` | `partners` ; `null` : aucun accord n'a été recueilli.
  origin              String?   @db.VarChar(8)
  /// La version du texte de la case acceptée.
  acceptedTextVersion String?   @map("accepted_text_version") @db.VarChar(64)
  /// La langue du texte accepté.
  acceptedLocale      String?   @map("accepted_locale") @db.VarChar(8)
  /// `signup` | `preferences` | `order` | `newsletter` | `staff` (CHECK en base).
  acceptedWhere       String?   @map("accepted_where") @db.VarChar(12)
  /// La référence opaque de l'acte (commande, compte).
  acceptedRef         String?   @map("accepted_ref") @db.VarChar(120)
  requestedAt         DateTime? @map("requested_at") @db.Timestamptz(6)
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(6)
  unsubscribedAt      DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  /// `link` | `one_click` | `staff` | `group` (CHECK en base).
  unsubscribedSource  String?   @map("unsubscribed_source") @db.VarChar(10)

  /// Postgres tient deux NULL pour distincts : l'unicité ne vaut que tant que la clé existe.
  @@unique([space, recipientKey])
  @@unique([space, print])
  @@index([print])
  @@map("mail_marketing_preference")
  @@schema("mail")
}

/// **Une consultation du registre de préférence par le staff** (plan
/// `plan-desinscription-des-e-mails.md`, lot C4) — la figure des
/// consultations du suivi : `reveal` (une adresse affichée : `preference_id`)
/// ou `search` (une recherche par adresse : `fingerprint`, l'empreinte HMAC de
/// la clé de recherche du suivi). Jamais l'adresse. Compte dans le plafond
/// PARTAGÉ de 30 consultations par heure et par personne ; purgée à 1 an sous
/// `MAIL_REQUEST_PURGE`. Pas de clé étrangère vers la ligne du registre : la
/// trace se purge de son côté.
model MailPreferenceConsultation {
  id           String                          @id
  /// `reveal` | `search` (CHECK en base, avec la colonne qui va avec).
  kind         String                          @db.VarChar(8)
  /// L'identifiant INTERNE de la fiche staff — jamais un `sub` Auth0.
  staffId      String                          @map("staff_id")
  /// La ligne dont l'adresse a été affichée (`reveal` seulement).
  preferenceId String?                         @map("preference_id")
  /// `HMAC-SHA256` de l'adresse cherchée, normalisée, 64 hexadécimaux (`search` seulement).
  fingerprint  String?                         @db.VarChar(64)
  consultedAt  DateTime                        @map("consulted_at") @db.Timestamptz(6)
  hits         MailPreferenceConsultationHit[]

  @@index([staffId, consultedAt])
  @@index([staffId, preferenceId, consultedAt])
  @@index([consultedAt])
  @@map("mail_preference_consultation")
  @@schema("mail")
}

/// Les lignes du registre TROUVÉES par une recherche, figées à son instant.
model MailPreferenceConsultationHit {
  consultationId String                     @map("consultation_id")
  preferenceId   String                     @map("preference_id")
  consultation   MailPreferenceConsultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@id([consultationId, preferenceId])
  @@map("mail_preference_consultation_hit")
  @@schema("mail")
}
