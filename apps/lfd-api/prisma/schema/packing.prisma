// ─────────────────────────────────────────────────────────────────────────────
// PACKING — le colisage, son propre domaine
// ─────────────────────────────────────────────────────────────────────────────
//
// Référence `documentation/colisage/colisage.md` (§7). Ces tables se
// remplissent par les faits que le fournil publie dans la boîte d'envoi
// (`production/channels/packing/`), et le poste de colisage les lit et les
// écrit depuis K2 (l'ombre de K1 et sa route de contrôle sont retirées en K3c).
//
// ⚠️ Aucune clé étrangère vers `production` ni vers `public` : une commande est
// un identifiant OPAQUE + un instantané, comme partout ailleurs. Les faits
// arrivent dans le désordre : chaque table se remplit de façon commutative.

/// **Une commande à coliser**, telle que la liste tirée par le fournil l'a
/// donnée. Clé : la journée et la commande — une commande déplacée d'un jour à
/// l'autre est deux colisages.
model PackingOrder {
  serviceDay String @map("service_day") @db.VarChar(10)
  /// L'identifiant de la commande côté COMMERCE, opaque.
  orderId    String @map("order_id")
  /// **Le rang de l'envoi** (plan E7 reliquat, choix 5 et 14, lot L3b) : 1 =
  /// la commande, au-delà un reliquat — sa feuille est distincte, sur le même
  /// stock du jour. CHECK ≥ 1 en base.
  rank       Int    @default(1)

  reference         String
  customerLabel     String  @map("customer_label")
  fulfillmentMethod String  @map("fulfillment_method")
  /// `HH:mm` — début du créneau, sinon fin de l'échéance ; `null` = en dernier.
  dueAt             String? @map("due_at") @db.VarChar(5)
  /// `pro` ou `public`, tel que le fournil l'a figé (2026-10-06). `null` =
  /// inconnu : fait publié sans le champ. CHECK en base.
  clientele         String? @db.VarChar(6)
  /// Le site qui remet ce retrait, identifiant OPAQUE du commerce, recopié du
  /// fait du fournil (2026-10-13, plan du tri et des couleurs, L1a). `null` :
  /// livraison, commande d'avant le site, ou ligne inscrite avant le champ —
  /// jamais rattrapée (`createMany … skipDuplicates`). Aucune clé étrangère.
  siteId            String? @map("site_id")

  /// L'instant du tirage (clôture ou retirage) qui l'a inscrite — celui du fournil.
  drawnAt DateTime @map("drawn_at") @db.Timestamptz(6)

  /// Le bac fermé (K2). `null` tous les deux = ouvert ; en K1, toujours ouvert.
  packedAt              DateTime? @map("packed_at") @db.Timestamptz(6)
  packedBy              String?   @map("packed_by")
  /// Les contenants comptés (K2). `0` = personne ne les a comptés.
  containerCount        Int       @default(0) @map("container_count")
  /// `counted` (le compte ci-dessus) ou `listed` (la colonne Contenants, K2b).
  /// `listed` est posé à l'inscription par le binaire de K2b (CHECK).
  containerMode         String    @default("counted") @map("container_mode") @db.VarChar(8)
  /// Un manque signalé sur ce bac (E6a) ; effacé — et annoncé — à la fermeture complète.
  shortfallReportedAt   DateTime? @map("shortfall_reported_at") @db.Timestamptz(6)
  /// Le départ incomplet décidé par le commerce (E6b) : les lignes dues sont
  /// réduites aux quantités au bac. Une fiche autorisée ne se re-signale pas et
  /// ne se retire pas à la réouverture de la journée.
  shortfallAuthorizedAt DateTime? @map("shortfall_authorized_at") @db.Timestamptz(6)
  /// La feuille retirée par l'annulation d'une commande inscrite (plan A1,
  /// `documentation/commandes/annulation/plan-a1-retirer-une-commande-inscrite.md`,
  /// § 2.2–2.3) : ses contenants sont annulés, plus aucun geste ne la touche.
  /// Posée sur une ligne neuve — la pierre tombale — si la liste à coliser
  /// n'est pas encore arrivée : le tirage n'y insère alors aucune ligne.
  withdrawnAt           DateTime? @map("withdrawn_at") @db.Timestamptz(6)

  lines      PackingLine[]
  containers PackingContainer[]

  @@id([serviceDay, orderId, rank])
  @@map("packing_order")
  @@schema("packing")
}

/// **Une ligne à coliser** : ce qui est dû, et ce qui est au bac (K2).
model PackingLine {
  serviceDay String       @map("service_day") @db.VarChar(10)
  orderId    String       @map("order_id")
  /// Le rang de l'envoi de la feuille (lot L3b) ; 1 = la commande.
  rank       Int          @default(1)
  order      PackingOrder @relation(fields: [serviceDay, orderId, rank], references: [serviceDay, orderId, rank], onDelete: Restrict)

  sku         String
  productName String @map("product_name")
  /// La quantité DUE — celle de l'instantané du fournil.
  quantity    Int

  /// Au bac (K2) : réversible tant que le bac est ouvert. `null` = pas au bac.
  packedAt       DateTime? @map("packed_at") @db.Timestamptz(6)
  packedBy       String?   @map("packed_by")
  packedInitials String    @default("") @map("packed_initials")

  @@id([serviceDay, orderId, rank, sku])
  @@map("packing_line")
  @@schema("packing")
}

/// **La réserve d'un article, pour une journée** — LA ligne qu'une mise au bac
/// et un retour verrouillent (§11, SÉRIEUX). Elle ne dépend pas des commandes :
/// une remise qui arrive avant la liste à coliser est gardée ici.
///
/// Invariant visé (K2) : `packed ≤ received − returned`. Les CHECK de la
/// migration tiennent déjà les trois compteurs positifs.
model PackingStock {
  serviceDay String @map("service_day") @db.VarChar(10)
  sku        String

  /// Σ des remises reçues du fournil.
  received   Int @default(0)
  /// Σ des retours rendus au fournil.
  returned   Int @default(0)
  /// Ce qui est au bac (K2). En K1, toujours 0.
  packed     Int @default(0)
  /// Σ des pièces envoyées en boutique depuis la réserve (plan A1, lot A1.4) :
  /// une sortie, reçue au comptoir comme un réassort d'origine `reserve`.
  sentToShop Int @default(0) @map("sent_to_shop")

  @@id([serviceDay, sku])
  @@map("packing_stock")
  @@schema("packing")
}

/// **Un fait reçu**, une fois : la clé d'idempotence d'une remise (`handoffId`)
/// ou d'un retour (`requestId`). Écrite dans la même transaction que l'effet
/// sur la réserve — un fait reçu deux fois ne compte qu'une fois, quel que
/// soit le chemin (rejeu admin, réannonce).
model PackingReceipt {
  /// `handoffId` pour une remise, `requestId` pour un retour.
  id         String   @id
  /// `handoff` ou `return` (CHECK).
  kind       String
  serviceDay String   @map("service_day") @db.VarChar(10)
  sku        String
  /// La quantité APPLIQUÉE à la réserve, toujours positive (CHECK).
  quantity   Int
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)

  @@index([serviceDay, sku])
  @@map("packing_receipt")
  @@schema("packing")
}

/// **Une demande de retour reçue du fournil** sur une journée `packing` (K2,
/// §13 B2). Le colisage la tranche sous le verrou de la réserve :
/// `returned = min(requested, reçu − rendu − au bac)`. Si la remise visée
/// (`handoff_id`) n'est pas encore arrivée, la demande attend ici, sans
/// décision, et elle est tranchée à son arrivée (§13, MINEURS).
model PackingReturn {
  requestId  String    @id @map("request_id")
  serviceDay String    @map("service_day") @db.VarChar(10)
  sku        String
  /// La remise visée — l'`id` de la fournée.
  handoffId  String    @map("handoff_id")
  requested  Int
  receivedAt DateTime  @map("received_at") @db.Timestamptz(6)
  /// La décision : `null` tous les deux = en attente de la remise.
  decidedAt  DateTime? @map("decided_at") @db.Timestamptz(6)
  returned   Int?

  @@index([handoffId])
  @@map("packing_return")
  @@schema("packing")
}

/// Le **journal des journées du colisage** — le pendant de
/// `production.day_change`, dans son propre schéma (D3). Aucun code ne
/// l'écrit : les déclencheurs d'instruction des tables `packing.*` l'alimentent
/// par `packing.record_day_change_by_service_day()`.
model PackingDayChange {
  id         BigInt   @id @default(autoincrement())
  serviceDay String   @map("service_day") @db.VarChar(10)
  changedAt  DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@index([serviceDay, id])
  @@map("day_change")
  @@schema("packing")
}

/// **Un contenant d'une commande** (K2b, `colisage.md` §5–§5.1)
/// : un bac — déclaré par la livraison, qui en garde le code, le QR et le
/// chargement — ou un sac à emporter, qui naît et vit ici. Jamais supprimé :
/// un contenant annulé porte `voided_at`, ses lignes restent, ignorées.
model PackingContainer {
  id         String       @id
  serviceDay String       @map("service_day") @db.VarChar(10)
  orderId    String       @map("order_id")
  /// Le rang de l'envoi de la feuille (lot L3b) ; 1 = la commande.
  rank       Int          @default(1)
  order      PackingOrder @relation(fields: [serviceDay, orderId, rank], references: [serviceDay, orderId, rank], onDelete: Restrict)

  /// `bin` ou `bag` (CHECK).
  nature  String  @db.VarChar(4)
  /// L'identifiant OPAQUE de `delivery.delivery_bin`, sans clé étrangère.
  binId   String? @unique @map("bin_id")
  /// Instantané du code court du bac, pris à la déclaration.
  binCode String? @map("bin_code") @db.VarChar(6)
  /// Instantané de la moitié (`left` | `right`) ; nul pour un bac entier.
  binHalf String? @map("bin_half") @db.VarChar(5)

  openedAt DateTime  @map("opened_at") @db.Timestamptz(6)
  openedBy String    @map("opened_by")
  voidedAt DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy String?   @map("voided_by")

  lines PackingContainerLine[]

  @@index([serviceDay, orderId])
  @@map("container")
  @@schema("packing")
}

/// **Ce qu'un contenant porte** : un SKU, une quantité. « Au bac » d'une ligne
/// de commande = la somme sur ses contenants non annulés. Une quantité retirée
/// à zéro reste une ligne à zéro.
model PackingContainerLine {
  containerId String           @map("container_id")
  container   PackingContainer @relation(fields: [containerId], references: [id], onDelete: Restrict)
  /// Recopié du contenant : le déclencheur `day_change` lit la journée ici.
  serviceDay  String           @map("service_day") @db.VarChar(10)
  sku         String
  quantity    Int

  @@id([containerId, sku])
  @@map("container_line")
  @@schema("packing")
}

/// **Une fiche de réassort au colisage** (réassort, lot R3b, 2026-10-21 —
/// `documentation/reassort-boutiques/plan-reapprovisionnement.md` §13). À part
/// de `PackingOrder` : un réassort n'a ni client, ni bon, ni acheminement.
/// Inscrite par `production.resupply_list_drawn`, seulement pour un point
/// servi par transfert (§13.4, Q1 révisée). Titrée « Réassort <point> » ;
/// sa destination est le transfert du point.
///
/// ⚠️ Aucune clé étrangère vers `production` ni vers `public` : le réassort
/// est un identifiant OPAQUE du commerce.
model PackingResupply {
  serviceDay String @map("service_day") @db.VarChar(10)
  resupplyId String @map("resupply_id")

  /// Le point servi par transfert, opaque, et son nom figé à l'arrêt.
  siteId    String  @map("site_id")
  siteLabel String? @map("site_label")
  /// Le nom du réassort (lot R1g), tiré du fait du fournil ; `null` : sans nom.
  name      String?

  drawnAt DateTime @map("drawn_at") @db.Timestamptz(6)

  /// `evening` : figé à l'arrêt (R3b) ; `asap` : réassort « au plus tôt »
  /// lancé dans la journée (R4b), en tête du poste (CHECK).
  kind String @default("evening")

  /// La clôture de la fiche : la quantité emballée de chaque ligne est
  /// définitive, et le commerce peut la lire. Les deux ensemble (CHECK).
  closedAt DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy String?   @map("closed_by")

  lines PackingResupplyLine[]

  @@id([serviceDay, resupplyId])
  @@index([resupplyId])
  @@map("packing_resupply")
  @@schema("packing")
}

/// Une ligne d'une fiche de réassort : la quantité DEMANDÉE, et celle
/// réellement emballée (0 ≤ emballée ≤ demandée, CHECK), `NULL` tant que
/// personne ne l'a saisie. Les pièces emballées sortent de la réserve du jour
/// (`packing_stock.packed`) : le fournil ne les reprend pas en retour.
model PackingResupplyLine {
  serviceDay String          @map("service_day") @db.VarChar(10)
  resupplyId String          @map("resupply_id")
  resupply   PackingResupply @relation(fields: [serviceDay, resupplyId], references: [serviceDay, resupplyId], onDelete: Restrict)

  sku         String
  productName String @map("product_name")
  quantity    Int

  packed   Int?      @map("packed")
  packedAt DateTime? @map("packed_at") @db.Timestamptz(6)
  packedBy String?   @map("packed_by")

  reservation PackingStockReservation?

  @@id([serviceDay, resupplyId, sku])
  @@map("packing_resupply_line")
  @@schema("packing")
}

/// **La part de la réserve du jour retenue par un réassort lancé** (réassort,
/// lot R4b — `reassort-boutiques/plan-au-plus-tot.md` §2 ③, Q7). Posée par le
/// fait `production.resupply_launched` sous le verrou de `packing_stock`
/// `(jour, SKU)` : une commande ne prend pas une pièce réservée, et la fiche
/// prend la sienne en premier. Reste dû = `quantity` − emballé de la ligne.
/// Levée (`released_at`) à la clôture de la fiche. Jamais effacée.
model PackingStockReservation {
  serviceDay String              @map("service_day") @db.VarChar(10)
  sku        String
  resupplyId String              @map("resupply_id")
  line       PackingResupplyLine @relation(fields: [serviceDay, resupplyId, sku], references: [serviceDay, resupplyId, sku], onDelete: Restrict, map: "packing_stock_reservation_line_fkey")

  /// Les pièces réservées (> 0, CHECK) — la quantité demandée par la ligne.
  quantity   Int
  reservedAt DateTime  @map("reserved_at") @db.Timestamptz(6)
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)

  @@id([serviceDay, resupplyId, sku])
  @@index([serviceDay, sku])
  @@map("packing_stock_reservation")
  @@schema("packing")
}

/// **Les réglages du colisage** — Réglages › Colisage (Hugo, 2026-10-25) : UNE
/// ligne, clé naturelle `packing`, comme `production_settings`. Ligne absente :
/// les défauts — le partage d'une moitié FERMÉ.
///
/// **Aucune journée** : exception écrite dans `test/day-change-triggers.e2e-spec.ts`.
model PackingSettings {
  /// Toujours `packing` : il n'y a qu'un réglage.
  key         String   @id
  /// Le geste « Partager une moitié » du poste ; fermé par défaut.
  halfSharing Boolean  @default(false) @map("half_sharing")
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)
  updatedBy   String   @map("updated_by")

  @@map("packing_settings")
  @@schema("packing")
}
