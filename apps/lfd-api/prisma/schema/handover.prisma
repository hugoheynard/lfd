// ─────────────────────────────────────────────────────────────────────────────
// LE RETRAIT — son schéma `handover` (2026-11-03, plan
// `documentation/retrait/plan-schema-handover.md`). Les trois tables vivaient
// dans `production`, héritage du temps où le retrait était un sous-dossier du
// fournil ; elles y ont été déplacées par `SET SCHEMA`, sans recopie.
// ─────────────────────────────────────────────────────────────────────────────

/// La REMISE d'une commande, telle que le fournil la constate.
///
/// ## Pourquoi elle n'est pas sur `ProductionOrder`
///
/// Une `ProductionOrder` n'existe que si une clôture l'a inscrite ; une commande
/// passée après la clôture de sa journée est pourtant remettable — la règle de
/// remise laisse passer `placed` exprès, pour ne pas renvoyer un client qui est
/// là avec son colis prêt. L'y accrocher obligerait à créer une ligne de plan à
/// la volée, ce qui fausserait le compte à produire.
///
/// ## Ce que les deux uniques rendent impossible
///
/// Une seconde remise du même envoi ne s'écrit pas. Ce n'est pas une condition
/// dans un `WHERE` qu'on peut oublier de recopier : c'est la base qui refuse,
/// par le chemin du scan (`(orderId, rank)` depuis L3d) comme par celui de la
/// saisie (`reference`).
model OrderHandover {
  id String @id @default(cuid())

  /// L'identifiant de la commande côté COMMERCE. Opaque : on le garde pour
  /// pouvoir en reparler, jamais pour aller lire à côté.
  orderId   String @map("order_id")
  /// Le rang de l'envoi retiré — 1 = la commande elle-même, défaut de toute
  /// ligne d'avant le reliquat (plan E7 reliquat, choix 5, lot L3d). Une
  /// remise par ENVOI : `@@unique([orderId, rank])` remplace l'unicité par
  /// commande. CHECK `rank >= 1` en base.
  rank      Int    @default(1)
  /// Le numéro lisible, `ORD-…` — celui qu'on saisit quand le code manque.
  /// Unique sur toutes les lignes : un reliquat prendra `ORD-…-2` (choix 13,
  /// lot L4), le rang 1 garde la valeur d'aujourd'hui.
  reference String @unique

  handedOverAt  DateTime @map("handed_over_at")
  /// L'identité staff qui a constaté, figée. Une preuve sans auteur n'en est pas.
  handedOverBy  String   @map("handed_over_by")
  /// `scan` (les deux parties étaient là), `manual` (l'équipe a saisi) ou
  /// `deposit` (déposé à la porte par le livreur, sans personne pour
  /// réceptionner — AP-D8 ; écrit par `HandoverDoorstepAttestor` depuis
  /// « Déposé avec preuve », B2, vérifié le 2026-10-07).
  handedOverVia String   @map("handed_over_via")

  @@unique([orderId, rank])
  @@map("order_handover")
  @@schema("handover")
}

/// La GARDE d'une commande passée au livreur : sa tournée est partie
/// (`documentation/livraisons/livreur/a-la-porte.md`, BQ).
///
/// Annoncée par la livraison par un fait durable, `delivery.round_departed`,
/// écrit dans la boîte d'envoi DANS la transaction du départ (DD1,
/// 2026-10-06, `plan-depart-durable.md` § 5 : `departAndFreeze`,
/// `delivery-departure-support.ts`, vérifié le 2026-10-07) ; tenue par le
/// retrait, qui s'y abonne (`RecordRoundDeparted`, sa clé est la commande) ;
/// lue par le fournil : un verdict qualité sur une commande partie est
/// refusé — le produit n'est plus là.
///
/// Une ligne par envoi (commande, rang) ; un second départ (une commande rapportée qui
/// repart un autre jour) réécrit l'instant et efface le retour.
model OrderDeparture {
  /// L'identifiant de la commande côté COMMERCE, opaque.
  orderId    String    @map("order_id")
  /// Le rang de l'envoi parti — 1 = la commande (plan E7 reliquat, choix 5,
  /// lot L3d). La garde est tenue par envoi : clé `(order_id, rank)`.
  rank       Int       @default(1)
  /// Nul : un retour est connu, son départ pas encore livré (la boîte
  /// d'envoi ne garantit aucun ordre — `plan-depart-durable.md`, B1).
  departedAt DateTime? @map("departed_at")
  /// « Rapportée » (plan « À la porte », B3, LB-Q2) : l'arrêt est clos sans
  /// livraison, la commande est revenue — elle redevient contrôlable. Nul :
  /// partie, et pas revenue. Monotone par instant avec `departedAt` : une
  /// écriture plus ancienne que l'état ne fait rien (DD1).
  returnedAt DateTime? @map("returned_at")

  @@id([orderId, rank])
  @@map("order_departure")
  @@schema("handover")
}

/// Les **pièces d'une remise à la porte** (`documentation/livraisons/livreur/a-la-porte.md`,
/// B1, § 9, L6-C9) : la photo (toujours), la signature au doigt (quand
/// l'arrêt l'exigeait au départ), le nom tapé de qui a réceptionné.
///
/// Elles appartiennent au RETRAIT, qui atteste la remise : une ligne par envoi (L3d) —
/// la commande au rang 1 —, écrite dans la même transaction que `order_handover`. Les images
/// sont au bucket des pièces (`ProductionDocumentStore`), sous ces clés.
///
/// Une remise au comptoir n'en a pas : la présence d'une ligne est ce qui dit
/// « remise à la porte » — le rejeu du livreur s'y lit (§ 10 bis).
///
/// `order_id` est OPAQUE : aucune clé étrangère, comme `order_handover`.
model OrderHandoverProof {
  orderId       String   @map("order_id")
  /// Le rang de l'envoi remis à la porte — 1 = la commande (plan E7
  /// reliquat, choix 12, lot L3d) : une preuve par envoi, clé
  /// `(order_id, rank)`, comme l'attestation qu'elle accompagne.
  rank          Int      @default(1)
  /// Nul pour une remise sans personne (le dépôt, B2) ; 2 à 80 sinon.
  receiverName  String?  @map("receiver_name")
  photoKey      String   @map("photo_key")
  signatureKey  String?  @map("signature_key")
  /// La photo du bon signé (Hugo, 2026-10-25) — exigée avec la signature ;
  /// nulle sinon, et pour toute pièce d'avant.
  signedSlipKey String?  @map("signed_slip_key")
  /// La fiche staff du livreur, figée.
  recordedBy    String   @map("recorded_by")
  recordedAt    DateTime @map("recorded_at")

  @@id([orderId, rank])
  @@map("order_handover_proof")
  @@schema("handover")
}
