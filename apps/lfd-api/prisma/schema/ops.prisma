// ─────────────────────────────────────────────────────────────────────────────
// OPS — la mémoire de la carte de santé
// ─────────────────────────────────────────────────────────────────────────────

/// **Une transition de statut**, et rien d'autre.
///
/// Une ligne quand un nœud CHANGE d'état — pas un échantillon périodique. Une
/// mesure toutes les quinze secondes ferait des dizaines de milliers de lignes
/// par jour pour dire quatre-vingt-dix-neuf fois la même chose ; une transition
/// en fait quelques dizaines, et ce sont exactement celles qu'on relit.
///
/// Ce que cette table rend possible, dans l'ordre où ça compte :
///
///  1. **`since` survit au redémarrage.** En mémoire seule, il repartait de
///     l'instant présent à chaque déploiement : « down depuis 6 h » redevenait
///     « down depuis à l'instant », c'est-à-dire un incident rajeuni au moment
///     précis où sa durée était l'information ;
///  2. **les nœuds sans trafic gagnent une histoire.** Tiers, fronts et base
///     n'ont pas de volume à tracer, mais ils ont une frise de disponibilité —
///     et c'est leur vraie métrique ;
///  3. **les alertes deviennent calibrables.** Brancher un canal sans savoir
///     combien de transitions par semaine fabrique du bruit, et un canal
///     bruyant s'ignore.
///
/// Pas de clé étrangère vers quoi que ce soit : `node` est un identifiant du
/// manifeste de topologie, pas une ligne d'une autre table. Une contrainte
/// inventerait une dépendance là où il n'y a qu'un nom.
model NodeStatusLog {
  /// ULID préfixé `nodestatus_` (fourni par l'IdGenerator).
  id String @id

  /// L'identifiant du nœud dans la topologie déclarée (`b2b`, `auth0`, …).
  node String

  /// up | degraded | down | unknown.
  status String

  /// Ce qui a produit ce statut (`probe-failed`, `error-rate`, `deploy-ok`, …).
  reason String

  /// Le constat de la sonde, s'il y en avait un. Vide sinon.
  detail String @default("")

  /// L'instant du CHANGEMENT — c'est lui que `since` rend.
  at DateTime @default(now())

  /// Lecture par nœud, du plus récent au plus ancien : c'est la seule qu'on fait.
  @@index([node, at(sort: Desc)])
  @@map("node_status_log")
  @@schema("ops")
}

/// **Un e-mail parti**, et ce qu'il est devenu.
///
/// `providerId` est l'identifiant Resend : la SEULE clé qui relie un envoi aux
/// événements qui le suivront. Nul en mode à blanc — rien n'est parti, et un
/// identifiant inventé ne se rapprocherait de rien.
///
/// `template` sert de **catégorie** : c'est lui qui permet de dire « les liens
/// d'accès rebondissent, les alertes internes non », qui est la seule forme
/// utile de cette information.
model MailSend {
  /// ULID préfixé `mailsend_`.
  id String @id

  /// Identifiant Resend, unique quand il existe : il dédoublonne l'envoi.
  providerId String? @unique @map("provider_id")

  /// Le gabarit envoyé (`customer.access-opened`, `staff.appointment-booked`…).
  template String

  recipient String

  /// sent | delayed | delivered | complained | bounced.
  status String @default("sent")

  /// Quand ce statut a été constaté — pas quand l'e-mail est parti.
  statusAt DateTime @default(now()) @map("status_at")

  /// Ce que le fournisseur a dit du rejet. Vide quand tout va bien.
  detail String @default("")

  sentAt DateTime @default(now()) @map("sent_at")

  /// La lecture des relevés : par gabarit, sur une fenêtre récente.
  @@index([template, sentAt])
  @@map("mail_send")
  @@schema("ops")
}

/// **Le registre des messages de webhook déjà vus.**
///
/// Les fournisseurs réessaient : le même événement arrive plusieurs fois, et le
/// traiter deux fois compterait deux rebonds pour un seul. L'unicité
/// `(provider, externalId)` est la garantie — portée par la base, pas par une
/// vérification applicative qui perdrait la course à deux requêtes simultanées.
model WebhookEvent {
  /// ULID préfixé `webhookevent_`.
  id String @id

  /// `resend`, et demain `stripe`.
  provider String

  /// L'identifiant du message chez le fournisseur (`svix-id` pour Resend).
  externalId String @map("external_id")

  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, externalId])
  @@map("webhook_event")
  @@schema("ops")
}
