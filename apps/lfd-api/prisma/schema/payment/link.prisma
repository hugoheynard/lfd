// ─────────────────────────────────────────────────────────────────────────────
// LES LIENS DE PAIEMENT — schéma `payment`
// ─────────────────────────────────────────────────────────────────────────────
//
// Plan `documentation/payment/liens-de-paiement/plan-le-lien-vers-un-sujet.md`,
// §2.1. Ce que Prisma ne sait pas écrire vit dans
// `20261122100000_les_liens_vers_un_sujet` : le CHECK de la révocation, l'index
// unique partiel d'un lien vivant par sujet, le déclencheur des colonnes
// immuables et le refus du DELETE.

/// **Un lien de paiement vers un sujet** — table `payment.pay_link`.
///
/// Propriétaire : `src/payment/link/`. Le sujet est opaque, comme celui d'un
/// paiement. Le jeton n'est jamais en clair : `token_hash` (HMAC-SHA-256) pour
/// le retrouver, `token_sealed` (le coffre de champs) pour le recopier.
///
/// Ce que le SQL porte et que ce modèle ne montre pas :
/// - `pay_link_revoked_pair` : `revoked_at` et `revoked_reason` posés ensemble ;
/// - `pay_link_live_per_subject_key` : index unique PARTIEL sur
///   `(subject_type, subject_id) WHERE revoked_at IS NULL` ;
/// - le déclencheur `pay_link_guard` (`BEFORE UPDATE`) : tout est immuable,
///   sauf la révocation, posée une fois ;
/// - le déclencheur `pay_link_no_delete` (`BEFORE DELETE`) : refusé, sauf sous
///   `SET LOCAL payment.purge = 'on'`.
model PayLink {
  /// ULID posé par le code (`IdGenerator`).
  id             String    @id
  subjectType    String    @map("subject_type")
  subjectId      String    @map("subject_id")
  /// L'application qui a demandé le lien — une valeur du registre des origines.
  origin         String
  /// Le nom du payeur tel que l'appelant l'a donné à l'ouverture, figé.
  payerLabel     String    @map("payer_label")
  /// HMAC-SHA-256 du jeton, en hexadécimal : la page publique cherche par lui.
  tokenHash      String    @unique @map("token_hash")
  /// Le jeton scellé par le coffre de champs : le staff recopie le lien.
  tokenSealed    String    @map("token_sealed")
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  /// Une fiche staff, ou `system` pour une émission automatique.
  createdBy      String    @map("created_by")
  /// Le nom du membre du staff auteur, donné par l'appelant et figé ; NULL :
  /// le système, une fiche introuvable, ou un lien d'avant la colonne.
  createdByLabel String?   @map("created_by_label")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason  String?   @map("revoked_reason")

  /// Les paiements nés de la page de ce lien.
  payments CardPayment[]

  @@index([subjectType, subjectId])
  @@map("pay_link")
  @@schema("payment")
}
