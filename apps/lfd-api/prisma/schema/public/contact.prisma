// ─────────────────────────────────────────────────────────────────────────────
// Les DEMANDES CLIENTS — motifs, demandes (« Nous écrire », « Signaler un
// problème »), photos ; et la carte de contact de la boutique et ses numéros
// (`documentation/contenu-ecommerce/demandes-clients.md`, 2026-10-09).
// Contexte `src/b2b/contact/`.
// ─────────────────────────────────────────────────────────────────────────────

/// À qui un motif ou un numéro est proposé ; pour une demande, `b2b` ou `b2c`
/// seulement — l'espace d'où elle a été écrite.
enum ContactAudience {
  b2b
  b2c
  both

  @@schema("public")
}

/// La priorité d'un motif, à usage interne : trie les demandes à traiter.
/// Déclarée dans l'ordre croissant — Postgres trie une énumération par son
/// rang, et « urgent d'abord » est un `ORDER BY priority DESC`.
enum RequestPriority {
  low
  medium
  urgent

  @@schema("public")
}

/// Le TYPE d'une demande — le formulaire d'où elle vient
/// (`demandes-clients.md`, 2026-10-09). Un type à venir (rendez-vous,
/// devis) est une valeur de plus, et ses détails ses propres colonnes.
enum RequestKind {
  contact
  order_problem

  @@schema("public")
}

/// Un **motif** proposé par un formulaire (« Nous écrire », « Signaler un
/// problème ») : son type, immuable ; son libellé en trois langues (le
/// français obligatoire) ; l'adresse qui reçoit les demandes ; son rang, son
/// public, sa priorité. Archivé plutôt que supprimé : une demande garde son
/// motif.
model RequestReason {
  /// ULID (fourni par l'`IdGenerator`).
  id String @id

  /// Le formulaire qui le propose. Immuable : le domaine refuse sa révision.
  kind RequestKind

  labelFr String @map("label_fr")
  /// Vide = le libellé français.
  labelEn String @default("") @map("label_en")
  labelIt String @default("") @map("label_it")

  /// L'adresse de l'équipe qui reçoit les demandes de ce motif.
  recipientEmail String @map("recipient_email")

  position Int             @default(0)
  active   Boolean         @default(true)
  audience ContactAudience @default(both)
  /// Usage interne, jamais servie à la boutique.
  priority RequestPriority @default(medium)

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")

  requests CustomerRequest[]

  @@index([kind, archivedAt, position])
  @@map("request_reason")
  @@schema("public")
}

/// Une **demande client** : une ENVELOPPE commune (motif figé, auteur, texte,
/// traitement, anonymisation) et les DÉTAILS de son type dans des colonnes
/// typées — `order_id` / `order_number` pour un problème de commande, et la
/// table `customer_request_photo`. Un CHECK tient la correspondance.
///
/// 🔴 Données personnelles d'un tiers (nom, e-mail, téléphone, texte,
/// rattachements, commande, photos) : **anonymisées** douze mois après le
/// traitement — ou la réception, jamais traitée — par le balayage nocturne.
/// La ligne reste ; aucun `DELETE`.
model CustomerRequest {
  /// ULID (fourni par l'`IdGenerator`).
  id String @id

  /// Le formulaire d'où elle vient, figé.
  kind RequestKind

  reasonId String        @map("reason_id")
  reason   RequestReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  /// Le libellé français du motif, figé à la réception.
  reasonLabel String          @map("reason_label")
  /// La priorité du motif, figée à la réception.
  priority    RequestPriority

  /// L'espace d'où elle a été écrite : `b2b` ou `b2c`.
  audience ContactAudience

  authorName  String @map("author_name")
  authorEmail String @map("author_email")
  /// Vide quand l'auteur ne l'a pas donné.
  authorPhone String @default("") @map("author_phone")
  body        String

  /// Le client connecté et la société pour laquelle il agissait ; NULL pour un
  /// visiteur. Identifiants opaques, sans clé étrangère.
  userId    String? @map("user_id")
  companyId String? @map("company_id")

  /// `order_problem` : la commande signalée (identifiant opaque, sans clé
  /// étrangère) et son numéro figé. NULL pour `contact`, et après anonymisation.
  orderId     String? @map("order_id")
  orderNumber String? @map("order_number")

  receivedAt DateTime @map("received_at")

  handledAt        DateTime? @map("handled_at")
  /// L'id de fiche staff de qui l'a traitée — un identifiant, pas un nom.
  handledByStaffId String?   @map("handled_by_staff_id")
  /// Nom figé de qui l'a traitée ; vide si l'annuaire ne le connaissait pas.
  handledByName    String?   @map("handled_by_name")

  anonymizedAt DateTime? @map("anonymized_at")

  photos CustomerRequestPhoto[]

  @@index([handledAt, priority, receivedAt])
  @@index([kind, handledAt])
  @@index([reasonId])
  @@map("customer_request")
  @@schema("public")
}

/// Une **photo** jointe à un signalement de problème (au plus trois). L'objet
/// vit dans le stockage sous `requests/<demande>/<photo>` ; la ligne garde sa
/// clé. À l'anonymisation, l'objet est SUPPRIMÉ du stockage et la ligne vidée
/// (`purged_at` posé) — la ligne reste.
model CustomerRequestPhoto {
  /// ULID (fourni par l'`IdGenerator`).
  id        String @id
  requestId String @map("request_id")
  request   CustomerRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  /// Rang d'affichage, 0..2.
  position    Int
  /// Vide une fois purgée.
  storageKey  String @map("storage_key")
  /// Relu dans les octets au dépôt ; vide une fois purgée.
  contentType String @map("content_type")
  sizeBytes   Int    @map("size_bytes")

  createdAt DateTime  @map("created_at")
  purgedAt  DateTime? @map("purged_at")

  @@unique([requestId, position])
  @@map("customer_request_photo")
  @@schema("public")
}

/// La **carte de contact** de la boutique : le numéro, et le titre et la phrase
/// de la carte pour les pros et pour les particuliers, en trois langues. Une
/// ligne unique (clé `contact`) ; absente ou vide, la boutique garde les textes
/// de son dictionnaire.
model ContactSettings {
  /// Toujours `contact` : il n'y a qu'un réglage.
  key String @id

  /// Le surtitre de la carte (« On répond » à la boutique) — 2026-10-09.
  b2bKickerFr String @default("") @map("b2b_kicker_fr")
  b2bKickerEn String @default("") @map("b2b_kicker_en")
  b2bKickerIt String @default("") @map("b2b_kicker_it")
  b2bTitleFr String @default("") @map("b2b_title_fr")
  b2bTitleEn String @default("") @map("b2b_title_en")
  b2bTitleIt String @default("") @map("b2b_title_it")
  b2bBodyFr  String @default("") @map("b2b_body_fr")
  b2bBodyEn  String @default("") @map("b2b_body_en")
  b2bBodyIt  String @default("") @map("b2b_body_it")
  /// Le surtitre de la carte (« On répond » à la boutique) — 2026-10-09.
  b2cKickerFr String @default("") @map("b2c_kicker_fr")
  b2cKickerEn String @default("") @map("b2c_kicker_en")
  b2cKickerIt String @default("") @map("b2c_kicker_it")
  b2cTitleFr String @default("") @map("b2c_title_fr")
  b2cTitleEn String @default("") @map("b2c_title_en")
  b2cTitleIt String @default("") @map("b2c_title_it")
  b2cBodyFr  String @default("") @map("b2c_body_fr")
  b2cBodyEn  String @default("") @map("b2c_body_en")
  b2cBodyIt  String @default("") @map("b2c_body_it")

  /// Instant du geste, lu du `Clock`.
  updatedAt        DateTime @map("updated_at")
  /// Qui l'a posé, figé au geste : l'id de fiche staff et un nom instantané.
  updatedByStaffId String   @map("updated_by_staff_id")
  updatedByName    String   @map("updated_by_name")

  @@map("contact_settings")
  @@schema("public")
}

/// Un **numéro de contact** de la boutique (Hugo, 2026-10-09) : ce qu'on lit à
/// côté (« Boutique de Val d'Isère », « Service commercial », le français
/// obligatoire), le numéro tel que saisi, son public, son rang. Archivé plutôt
/// que supprimé, comme un motif.
model ContactPhone {
  /// ULID (fourni par l'`IdGenerator`).
  id String @id

  labelFr String @map("label_fr")
  labelEn String @default("") @map("label_en")
  labelIt String @default("") @map("label_it")

  number   String
  audience ContactAudience @default(both)
  position Int             @default(0)
  active   Boolean         @default(true)

  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")

  @@index([archivedAt, position])
  @@map("contact_phone")
  @@schema("public")
}
