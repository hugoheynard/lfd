// ─────────────────────────────────────────────────────────────────────────────
// Le devis de période — plan
// `documentation/comptabilite/facturation/plan-clients-publics-chorus.md`,
// § 6 sexies (P2 bis, QD3).
// ─────────────────────────────────────────────────────────────────────────────
//
// Propriétaire : `src/lafoliecoffee/accounting/`. Un payeur public dont le
// numéro d'engagement arrive sur le devis : sa clôture RANGE ses commandes
// dans un devis au lieu d'émettre la facture.
//
// 🔴 Contraintes INVISIBLES ici — elles vivent dans la migration
// `20261124220000_le_devis_de_periode`, Prisma ne sait pas les exprimer :
//   · un seul devis non remplacé par (entité, payeur, mandat, code service,
//     clôture) — index unique partiel `period_quote_live_once` ;
//   · une commande n'est que dans UN devis `awaiting` — index unique partiel
//     `period_quote_order_awaiting_once` ;
//   · `invoice_id` posé ⇔ `state = 'invoiced'`, état connu, numéro
//     `D-<AAAAMMJJ>-<rang>`, empreinte sha256 hexadécimale ;
//   · un devis ni ses commandes ne se suppriment, un état final ne se quitte
//     pas, le compteur ne recule pas (déclencheurs).

/// UN devis de période, dans UNE version. `state` : `awaiting` | `invoiced` |
/// `superseded`.
model PeriodQuote {
  id             String      @id
  /// `D-<AAAAMMJJ>-<rang>` — partagé par les versions d'un même devis.
  number         String
  version        Int
  legalEntityId  String      @map("legal_entity_id")
  legalEntity    LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  /// Le payeur légal — opaque.
  payerCompanyId String      @map("payer_company_id")
  /// Sa raison sociale au rangement, pour l'écran.
  payerName      String      @map("payer_name")
  /// Le mandat effectif du groupe ; `""` = aucun (jamais NULL, comme
  /// `invoice_monthly_outcome.mandate_id`).
  mandateId      String      @default("") @map("mandate_id")
  /// Le code service des commandes ; `""` = aucun.
  serviceCode    String      @default("") @map("service_code")
  /// Le début de la période DU PAYEUR.
  periodStartsAt DateTime    @map("period_starts_at") @db.Timestamptz(3)
  periodClosesAt DateTime    @map("period_closes_at") @db.Timestamptz(3)
  state          String
  /// SHA-256 (hexadécimal) du calcul de la facture sur ses commandes.
  fingerprint    String
  totalTtcCents  Int         @map("total_ttc_cents")
  /// La facture émise de ce devis ; posée avec `invoiced`.
  invoiceId      String?     @unique @map("invoice_id")
  invoice        Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdAt      DateTime    @map("created_at") @db.Timestamptz(3)

  orders PeriodQuoteOrder[]

  @@unique([id, state])
  @@unique([number, version])
  @@map("period_quote")
  @@schema("public")
}

/// Une commande d'un devis. `order_id` est opaque ; `quote_state` est la copie
/// de l'état du devis, tenue par la clé étrangère composite (ON UPDATE CASCADE).
model PeriodQuoteOrder {
  quoteId    String      @map("quote_id")
  orderId    String      @map("order_id")
  quoteState String      @map("quote_state")
  quote      PeriodQuote @relation(fields: [quoteId, quoteState], references: [id, state], onDelete: Restrict, onUpdate: Cascade)

  @@id([quoteId, orderId])
  @@map("period_quote_order")
  @@schema("public")
}

/// Le dernier rang de devis par (entité, étiquette de période `AAAAMMJJ`).
model PeriodQuoteCounter {
  legalEntityId String      @map("legal_entity_id")
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  periodTag     String      @map("period_tag")
  lastRank      Int         @map("last_rank")

  @@id([legalEntityId, periodTag])
  @@map("period_quote_counter")
  @@schema("public")
}
