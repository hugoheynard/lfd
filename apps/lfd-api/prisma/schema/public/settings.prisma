// ─────────────────────────────────────────────────────────────────────────────
// Points de retrait — adresses GLOBALES de la plateforme
// ─────────────────────────────────────────────────────────────────────────────

/// Un **site** — un lieu physique À NOUS (2026-10-13,
/// `documentation/sites/sites.md`,
/// §1) : on y fabrique et on en part, on y remet des commandes, ou on y est
/// servi par un transfert interne. C'était le « point de retrait » ; le modèle
/// Prisma a changé de nom, la TABLE non (`pickup_addresses`, Q-S1 proposé) —
/// les références (`pickup_address_id`) et les snapshots restent valides.
///
/// Plusieurs sites, un seul `isDefault`. Une commande en retrait fige un
/// snapshot de l'adresse choisie. Les invariants (rôles, couleurs, archivage,
/// défaut) sont portés par l'agrégat `Site` (`b2b/sites/domain/site.ts`).
model Site {
  id String @id @default(cuid())

  label      String
  ligne1     String
  ligne2     String @default("")
  codePostal String @map("code_postal")
  ville      String
  pays       String

  // Un seul point par défaut (le préselectionné au checkout). L'invariant « au
  // moins un point » et « un seul défaut » est tenu par le repository.
  isDefault Boolean @default(false) @map("is_default")

  // Remise appliquée au panier en cas de retrait ici. `discountMode` null =
  // aucune remise ; sinon `discountValue` = bp (percent) ou centimes (amount).
  discountMode  CartAdjustmentMode? @map("discount_mode")
  discountValue Int?                @map("discount_value")

  // À QUI la remise s'applique : les pros (société active) et/ou les
  // particuliers. Défaut `true` = l'existant, où toute requête la reçoit. Sans
  // remise, ces cases ne sont pas lues ; une remise qui n'en coche aucune est
  // refusée par `PickupDiscount`. Cf. `plan-remise-et-livraison-par-clientele.md`, D2.
  discountForB2b Boolean @default(true) @map("discount_for_b2b")
  discountForB2c Boolean @default(true) @map("discount_for_b2c")

  // Quand un pro peut venir : ouverture au public ET créneau réservé aux pros,
  // deux fenêtres NOMMÉES et jamais fusionnées — leur union peut avoir un trou
  // (pros 5h–6h30, public 7h–20h), et l'aplatir inventerait une demi-heure
  // d'ouverture. Forme = `PickupOpening` de `@lfd/contracts`, en JSON car on ne
  // requête jamais par heure.
  opening Json?

  /// Le point GPS du lieu (`{ lat, lng }`, `gpsPointSchema`), ou `NULL` s'il
  /// n'est pas saisi. C'est d'ici que partira le calcul des distances quand le
  /// point est le départ des tournées (2026-09-29, `plan-preparation-de-tournee.md`, Q9).
  gps Json?

  /// Le site REMET des commandes à des clients (retrait) : proposé au
  /// checkout, onglet au comptoir. `true` = l'existant, où tout point remettait.
  pickup Boolean @default(true)

  /// À QUELLES clientèles le site remet (Hugo, 2026-10-15) : un site peut être
  /// réservé au retrait des pros (société active) ou des particuliers. Défaut
  /// `true` = l'existant. Lues seulement si `pickup` ; un retrait ouvert à
  /// personne est refusé par l'agrégat `Site` et par un CHECK.
  pickupForB2b Boolean @default(true) @map("pickup_for_b2b")
  pickupForB2c Boolean @default(true) @map("pickup_for_b2c")

  /// D'où vient la marchandise : fabriquée/colisée sur place, ou arrivée par
  /// un transfert interne. Un site `transfer` remet forcément (agrégat).
  supply SiteSupply @default(on_site)

  /// Livraisons et transferts peuvent en partir. Un site qui expédie est
  /// `on_site` (agrégat).
  deliveryDeparture Boolean @default(false) @map("delivery_departure")

  /// Archivé : plus proposé, mais toujours résolu par id (départ, copies). Remplace
  /// la suppression physique — un site est référencé par des commandes.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  /// Comment un site servi par transfert est approvisionné (§4) : dans une
  /// tournée B2B du jour (`integrated`, défaut) ou par une tournée dédiée.
  transferMode SiteTransferMode @default(integrated) @map("transfer_mode")

  /// La mise en place au comptoir, en minutes, APRÈS le colisage ; s'ajoute à
  /// la marge de retrait (§4.6). ≥ 0, tenu par l'agrégat et par un CHECK.
  counterSetupMinutes Int @default(0) @map("counter_setup_minutes")

  /// Les couleurs de la logistique, LIBRES (`#rrggbb`, Hugo 2026-10-13) :
  /// aucune teinte refusée, seule la forme est vérifiée (`SiteColor` et CHECK). `NULL`
  /// = aucune couleur, pour de bon : une couleur posée peut être retirée, et le
  /// resserrement prévu au lot S3r est tombé (Hugo, 2026-10-13).
  pickupColorB2b   String? @map("pickup_color_b2b")
  pickupColorB2c   String? @map("pickup_color_b2c")
  deliveryColorB2b String? @map("delivery_color_b2b")
  deliveryColorB2c String? @map("delivery_color_b2c")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Sociétés qui ont fait de ce point leur retrait préféré (cf. Company).
  preferredBy Company[]

  /// Les créneaux PUBLICS du point, et leurs fermetures datées. Structure NEUVE,
  /// à côté d'`opening` : elle ne concerne que le visiteur, jamais le pro.
  publicSlotRules PublicPickupSlotRule[]
  publicClosures  PublicPickupClosure[]

  @@map("pickup_addresses")
  @@schema("public")
}

/// D'où vient la marchandise d'un site (plan des sites, §3.1).
enum SiteSupply {
  on_site
  transfer

  @@map("site_supply")
  @@schema("public")
}

/// Le mode du transfert interne vers un site servi par transfert (§4).
enum SiteTransferMode {
  integrated
  dedicated

  @@map("site_transfer_mode")
  @@schema("public")
}

/// **Zone de livraison** — un secteur de codes postaux (stations éloignées)
/// portant un frais de livraison HT ajouté au panier quand la commande est livrée
/// vers ce secteur. `postalPrefixes` = préfixes couverts (`73150` exact, `731` =
/// secteur) ; le plus long gagne. Config globale. `feeValue` = bp (percent) ou
/// centimes (amount) selon `feeMode`.
model DeliveryZone {
  id             String   @id @default(cuid())
  postalPrefixes String[] @map("postal_prefixes")
  label          String   @default("")

  feeMode  CartAdjustmentMode @map("fee_mode")
  feeValue Int                @map("fee_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_zones")
  @@schema("public")
}

/// Créneau (un début et une fin) ou échéance (une heure limite seule).
enum DeliveryWindowMode {
  slot
  deadline

  @@schema("public")
}

/// **À qui la livraison est proposée** — un réglage global, UNE ligne.
///
/// Ligne absente = ouverte aux deux : c'est l'existant, et aucun semis n'est
/// nécessaire pour le reproduire. Clé NATURELLE comme `PlatformContent` ; auteur
/// figé comme `FeatureAccessOverride`. Propriétaire : `src/b2b/delivery-availability/`.
/// Cf. `documentation/livraisons/clientele/plan-remise-et-livraison-par-clientele.md`, D4.
model DeliveryAvailability {
  /// Toujours `delivery` : il n'y a qu'un réglage, et son nom est connu d'avance.
  key String @id

  openToB2b Boolean @map("open_to_b2b")
  openToB2c Boolean @map("open_to_b2c")

  /// **Créneau ou échéance** : comment une livraison se demande, pour toute
  /// adresse qui ne le surcharge pas (`delivery_specs.windowMode`). Défaut
  /// `deadline` depuis le 2026-10-04 (Hugo, §14.2) ; `slot` à sa création
  /// (CA-D2). Plan composition automatique.
  windowMode DeliveryWindowMode @default(deadline) @map("window_mode")

  /// **Marges de production**, en minutes (plan production par vagues, V0,
  /// §7.3) : livraison = colisage + chargement ; retrait = colisage seul.
  /// Retranchées de l'échéance d'une commande pour dire au fournil avant
  /// quelle heure sortir. `NULL` = non réglée, et c'est voulu : sans réglage,
  /// la journée n'a qu'un seul seuil. Aucun défaut inventé.
  deliveryMarginMinutes Int? @map("delivery_margin_minutes")
  pickupMarginMinutes   Int? @map("pickup_margin_minutes")

  /// Instant du geste, lu du `Clock` — pas `@updatedAt`, qui lirait l'horloge
  /// de la base au lieu de celle de la requête.
  updatedAt        DateTime @map("updated_at")
  /// Qui l'a posé, figé à l'instant du geste : l'identifiant survit à tout, le
  /// nom et le rôle sont un instantané. L'id de fiche depuis le 2026-09-18 ;
  /// les lignes plus anciennes portaient un `sub` Auth0, converti par la
  /// migration `20260918190000_conversion_des_auteurs_staff` ; seul y reste un
  /// `sub` que la table des `sub` ne connaît pas. La colonne s'appelait
  /// `updated_by_sub` jusqu'au renommage du plan de l'auteur (étape 5).
  updatedByStaffId String   @map("updated_by_staff_id")
  updatedByName    String   @map("updated_by_name")
  updatedByRole    String   @map("updated_by_role")

  @@map("delivery_settings")
  @@schema("public")
}

/// **L'ouverture de la boutique à la commande**, par clientèle (Hugo,
/// 2026-10-09). Fermée, le catalogue et les prix restent visibles : seules les
/// passations de la clientèle sont refusées (409). La saisie du staff passe
/// toujours. Une ligne unique, de clé `orders` ; **ligne absente = ouverte aux
/// deux**. Sa propre table et non `delivery_settings` : celle-là est le réglage
/// de la LIVRAISON, et y loger la commande aurait fait de chaque geste de l'un
/// une réécriture de l'autre. Doc : `documentation/commandes/ouverture-de-la-boutique.md`.
model OrderOpening {
  /// Toujours `orders` : il n'y a qu'un réglage.
  key String @id

  ordersOpenToB2b Boolean @default(true) @map("orders_open_to_b2b")
  ordersOpenToB2c Boolean @default(true) @map("orders_open_to_b2c")

  /// Instant du geste, lu du `Clock`.
  updatedAt        DateTime @map("updated_at")
  /// Qui l'a posé, figé au geste : l'id de fiche staff, un nom et un rôle instantanés.
  updatedByStaffId String   @map("updated_by_staff_id")
  updatedByName    String   @map("updated_by_name")
  updatedByRole    String   @map("updated_by_role")

  @@map("order_opening_settings")
  @@schema("public")
}

/// **L'interrupteur de l'heure limite générale** (plan
/// `documentation/commandes/plan-reglages-commandes.md`, §8.1, lot O3, Hugo
/// 2026-10-14). Désactivée, la règle `OrderCutoff` n'est plus servie (passation,
/// boutique, fournil) ; elle reste en base. Une ligne au plus, clé `orders` ;
/// **ligne absente = activée**. Les limites produit n'en dépendent pas.
model OrderCutoffSettings {
  /// Toujours `orders` : il n'y a qu'un réglage.
  key String @id

  enabled        Boolean @default(true)
  /// Une commande peut-elle viser AUJOURD'HUI ? (Hugo, 2026-10-14, §8.3.) Non
  /// par défaut ; aucune règle de délai codée en dur ailleurs.
  sameDayAllowed Boolean @default(false) @map("same_day_allowed")

  /// Instant du geste, lu du `Clock`.
  updatedAt        DateTime @map("updated_at")
  /// Qui l'a posé, figé au geste : l'id de fiche staff, un nom et un rôle instantanés.
  updatedByStaffId String   @map("updated_by_staff_id")
  updatedByName    String   @map("updated_by_name")
  updatedByRole    String   @map("updated_by_role")

  @@map("order_cutoff_settings")
  @@schema("public")
}

/// **Ce que la boutique permet au client d'annuler lui-même** (plan
/// `documentation/commandes/annulation/annulation-par-le-client.md`, lot C6,
/// C6.5). Une ligne, clé `orders`, posée délai ACTIF (24 h) depuis `20261013400000` ; ligne absente =
/// délai actif aussi. Un pro n'est jamais concerné : seul le fournil lui ferme la
/// porte. Pas daté : la valeur décide d'un geste au moment où il est fait, et le
/// fait `order.cancelled` fige le délai appliqué.
model CustomerCancellationSettings {
  /// Toujours `orders` : il n'y a qu'un réglage.
  key String @id

  /// Un délai est-il imposé aux particuliers ? (décision du 2026-10-13 : la
  /// colonne garde son nom d'origine, `open_to_b2c`, mais `true` veut dire
  /// « délai imposé », plus « annulation ouverte » — la limite de tous est
  /// le compte à produire, le délai ne fait que l'avancer.)
  delayEnabled Boolean @default(true) @map("open_to_b2c")
  /// Délai avant l'ancre (retrait / livraison), en heures — 0 à 168 (CHECK).
  hoursBefore  Int     @default(24) @map("hours_before")

  /// Instant du dernier geste ; NULL tant que personne n'a rien réglé.
  updatedAt        DateTime? @map("updated_at")
  /// Qui l'a posé, figé au geste ; NULL sur la ligne posée par la migration.
  updatedByStaffId String?   @map("updated_by_staff_id")
  updatedByName    String?   @map("updated_by_name")
  updatedByRole    String?   @map("updated_by_role")

  @@map("customer_cancellation_settings")
  @@schema("public")
}

/// Le **contenu de plateforme** — les textes de la vitrine, tenus par le staff.
///
/// Ils vivaient compilés dans le bundle du front client, en trois dictionnaires
/// `fr/en/it.ts` : un mot à corriger demandait un développeur, une revue et un
/// déploiement. Ils sont désormais une donnée.
///
/// `content` est du **JSON** et c'est un choix, pas un raccourci : la forme est
/// l'affaire du contrat (`footerContentSchema`), validée au bord par Zod, et
/// tout l'intérêt est qu'elle bouge quand la vitrine bouge — sans une migration
/// par paragraphe ajouté. Ce que la base garantit, c'est qu'il y a UNE ligne par
/// bloc et qu'on sait quand elle a changé.
model PlatformContent {
  /// Le bloc : `footer` aujourd'hui, d'autres ensuite. Clé NATURELLE et pas un
  /// cuid — il y a une ligne par bloc, et son nom est connu à l'avance.
  key String @id

  /// Les trois langues, dans la forme du contrat.
  content Json

  /// Monte à chaque enregistrement. De quoi dire à un rédacteur que quelqu'un
  /// d'autre a écrit pendant qu'il avait l'écran ouvert.
  revision Int @default(1)

  /// Le NOM de la personne, pas son identifiant : cette valeur est lue par du
  /// personnel qui n'a pas l'annuaire staff sous les yeux — et il vit de toute
  /// façon dans une autre base.
  updatedBy String? @map("updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_content")
  @@schema("public")
}

/// **Un PDF de référence des CGV** — le document juridique, dont les
/// paragraphes de `platform_content` ne sont que la lecture en ligne
/// (`documentation/legal/plan-cgv-par-audience.md`, C3, C3′).
///
/// 🔴 **Jamais écrasé, et la base le tient** : un déclencheur refuse tout
/// `DELETE` et tout `UPDATE` autre que la pose de `superseded_at` quand elle
/// est nulle. Chaque dépôt est une ligne neuve et un objet R2 neuf (bucket
/// `customers`, port sans `delete`) ; le dépôt suivant remplace celui-ci en
/// posant `superseded_at`. Un index unique partiel tient « un seul en vigueur
/// par texte ».
model LegalDocumentFile {
  /// ULID frappé par l'API. Il entre dans la clé de stockage.
  id                String    @id
  /// `sales-terms` | `sales-terms-pro` — la clé de ligne du texte dans
  /// `platform_content`. Tenu par un CHECK.
  documentKey       String    @map("document_key")
  /// La clé de l'objet dans le bucket `customers`, sous `legal/`.
  storageKey        String    @unique @map("storage_key")
  /// SHA-256 des octets, en hexadécimal.
  sha256            String
  sizeBytes         Int       @map("size_bytes")
  uploadedAt        DateTime  @map("uploaded_at") @db.Timestamptz(3)
  /// L'id de la FICHE staff qui l'a déposé — au registre RGPD.
  uploadedByStaffId String    @map("uploaded_by_staff_id")
  /// `NULL` = le PDF en vigueur pour ce texte.
  supersededAt      DateTime? @map("superseded_at") @db.Timestamptz(3)

  /// Les commandes passées sous ce PDF (C4) — d'où l'interdiction de supprimer.
  orders Order[]

  @@index([documentKey, uploadedAt(sort: Desc)])
  @@map("legal_document_files")
  @@schema("public")
}

/// **Une règle de créneaux publics** — une plage homogène d'un point de retrait,
/// découpée à pas constant pour le VISITEUR.
///
/// 🔴 Elle ne remplace rien : `PickupAddress.opening` porte toujours les heures
/// PRO, et ce plan n'y touche pas (`documentation/commandes/plan-creneaux-de-retrait.md`,
/// §3). Les créneaux restent DÉRIVÉS (D1) — rien d'enregistré ici ne peut
/// diverger de l'horaire réel, seule la règle est stockée.
///
/// **Plusieurs règles par (point, jour)**, et c'est la différence avec
/// l'unicité d'`OrderCutoff` : c'est ce qui donne deux badges dans la même
/// matinée. Le chevauchement est refusé par l'agrégat `PickupSchedule`, pas par
/// un index — l'écriture est un geste d'administration, rare, à un opérateur (D8).
model PublicPickupSlotRule {
  /// ULID préfixé `ppslot_`.
  id String @id

  /// Un créneau appartient TOUJOURS à un comptoir.
  pickupAddressId String @map("pickup_address_id")
  pickupAddress   Site   @relation(fields: [pickupAddressId], references: [id], onDelete: Cascade)

  /// `null` = tous les jours ; sinon la clé du jour (`mon`…`sun`), celle du
  /// contrat (`Weekday`, `packages/contracts/src/address.ts`).
  weekday String?

  /// Bornes locales `HH:MM`, pendule d'Europe/Paris, `start` avant `end`.
  startTime String @map("start_time")
  endTime   String @map("end_time")

  /// Le pas de découpe, en minutes — le « générateur avec une durée ».
  slotMinutes Int @map("slot_minutes")

  /// Texte LIBRE, argument commercial et non vérité de production (§2.4).
  /// `null` = pas de pastille ; la chaîne vide est refusée à la saisie (D2).
  badge String?

  /// Combien de personnes on sert sur CE créneau. `null` = aucune limite, et
  /// c'est le défaut voulu : on ne refuse jamais un client (D3). Jamais `0`.
  ///
  /// ⚠️ La capacité de STOCK (ce que le four a sorti) n'a volontairement aucune
  /// colonne : personne ne sait encore la remplir, et une colonne qu'on ne sait
  /// pas remplir est une dette, pas une préparation (D3).
  serviceCapacity Int? @map("service_capacity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pickupAddressId, weekday])
  @@map("public_pickup_slot_rules")
  @@schema("public")
}

/// **Une fermeture datée** du retrait public — congés, jour sans fournée, four
/// en panne (D4).
///
/// Un INTERVALLE de jours et non un jour unique comme `AvailabilityException` :
/// une semaine de congés est une ligne, pas sept. Bornes horaires facultatives —
/// absentes, la journée entière est fermée. Une fermeture **prime** sur toute
/// règle.
model PublicPickupClosure {
  /// ULID préfixé `ppclose_`.
  id String @id

  pickupAddressId String @map("pickup_address_id")
  pickupAddress   Site   @relation(fields: [pickupAddressId], references: [id], onDelete: Cascade)

  /// Jours locaux inclusifs, `AAAA-MM-JJ`. Stockés en `DATE` pour qu'aucun
  /// fuseau ne puisse les décaler — un jour de calendrier, pas un instant.
  fromDay DateTime @map("from_day") @db.Date
  toDay   DateTime @map("to_day") @db.Date

  /// Bornes locales `HH:MM`, ou `null` des deux côtés pour la journée entière.
  startTime String? @map("start_time")
  endTime   String? @map("end_time")

  /// Motif libre — il est lu par du personnel qui n'a pas le réglage sous les yeux.
  reason String @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pickupAddressId, fromDay])
  @@map("public_pickup_closures")
  @@schema("public")
}
