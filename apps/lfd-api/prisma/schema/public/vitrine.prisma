/// **Les abonnés de la vitrine** — ceux qu'on prévient quand le catalogue
/// publié change (`documentation/webhooks/vitrine.md`, lot W,
/// 2026-10-18). L'agrégat `VitrineSubscriber` de `b2b/vitrine` en est le seul
/// écrivain.
///
/// Un abonné est une ORGANISATION (l'agence web) : un nom et une adresse,
/// aucun contact nominatif. Jamais supprimé : on le coupe (`active`).
model VitrineSubscriber {
  /// L'id de l'`IdGenerator` (ULID).
  id   String @id
  name String

  /// À quoi sert cet abonné — pour le staff seulement, jamais envoyé à
  /// l'agence ni servi sur `/vitrine/*`. 500 caractères au plus (`CHECK`).
  description String?

  /// L'adresse où écrire à l'agence (e-mails de mise à jour) — facultative,
  /// peut être NOMINATIVE : au registre RGPD. Jamais servie sur `/vitrine/*`,
  /// jamais dans le corps du webhook, jamais dans un log.
  contactEmail String? @map("contact_email")

  /// `https://…`, sans requête ni fragment ni identifiants (refusés par le
  /// domaine à la saisie ; un jeton en requête serait affiché à l'écran).
  /// `null` : abonné en LECTURE SEULE (2026-10-20) — il lit `/vitrine/*`,
  /// aucun webhook ne lui part ; le balayage ne le compare pas.
  endpointUrl String? @map("endpoint_url")

  /// Le secret de signature, SCELLÉ (`FieldCipher`, `FIELD_ENCRYPTION_KEY`) :
  /// il faut le relire pour signer. Une rotation de la clé le rend illisible —
  /// le runbook dit de régénérer les secrets d'abonnés.
  signingSecretSealed String @map("signing_secret_sealed")

  /// La clé de lecture, HACHÉE (SHA-256, hex) : elle identifie l'abonné sur
  /// `/vitrine/*`, et n'a jamais besoin d'être relue.
  readKeyHash String @unique @map("read_key_hash")

  /// Les ensembles reçus : `catalogue` · `operations` · `texts` · `featured`
  /// (`CHECK`). Une case ne fait que RETIRER.
  contents String[]

  active   Boolean
  /// Posé quand une livraison a épuisé ses essais : plus rien ne part tant
  /// qu'on n'a pas « tout renvoyé ».
  failedAt DateTime? @map("failed_at") @db.Timestamptz(3)

  /// La dernière séquence attribuée à une livraison de changements.
  lastSequence Int @default(0) @map("last_sequence")

  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  fingerprints VitrineFingerprint[]
  deliveries   VitrineDelivery[]
  notices      VitrineNoticeRecipient[]

  @@map("vitrine_subscribers")
  @@schema("public")
}

/// **La dernière empreinte ÉMISE** d'un élément, par abonné (W3′, B3) : ce à
/// quoi le balayage compare la vue du moment. Une table de suivi, pas un
/// agrégat : la ligne d'un élément retiré de la vue disparaît avec la
/// notification de son retrait.
model VitrineFingerprint {
  subscriberId String @map("subscriber_id")
  /// `item` (sku) · `operation` (key) · `shelf` (id) · `text` (clé) — `CHECK`.
  kind         String
  elementKey   String @map("element_key")
  /// SHA-256 (hex) de l'élément dans les trois langues servies.
  fingerprint  String

  emittedAt DateTime @map("emitted_at") @db.Timestamptz(3)

  subscriber VitrineSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@id([subscriberId, kind, elementKey])
  @@map("vitrine_fingerprints")
  @@schema("public")
}

/// **Les livraisons** à un abonné (W2′). 🔴 UNE seule livraison de
/// changements en attente par abonné — index unique partiel, posé par la
/// migration : la suivante absorbe celle qui attend au lieu de s'empiler.
model VitrineDelivery {
  id           String @id
  subscriberId String @map("subscriber_id")
  /// L'identifiant d'ENVOI (en-tête `Vitrine-Delivery`) : stable d'un essai à
  /// l'autre, neuf à chaque absorption de changements. `id` reste la ligne.
  dispatchId   String @map("dispatch_id")

  /// `change` · `test` (`CHECK`). Un essai ne compte ni dans la séquence, ni
  /// dans l'échec de l'abonné.
  kind     String
  /// Croissante par abonné pour `change` ; `NULL` pour `test`.
  sequence Int?

  /// Les changements : `{ changed: {items,operations,shelves,texts}, removed: {…} }`.
  changes Json

  /// `pending` · `delivered` · `failed` (`CHECK`).
  state         String
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  /// Le dernier refus, en clair pour l'écran — jamais le corps de la réponse.
  lastError     String?   @map("last_error")
  lastStatus    Int?      @map("last_status")

  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)

  subscriber VitrineSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@unique([subscriberId, sequence])
  @@index([state, nextAttemptAt])
  @@index([subscriberId, createdAt])
  @@map("vitrine_deliveries")
  @@schema("public")
}

/// **Une annonce aux abonnés** (plan vitrine §7, Hugo 2026-10-18) : un e-mail
/// écrit à l'écran, envoyé à chaque contact choisi, un message par adresse.
/// Journal : jamais supprimé, jamais modifié après coup.
model VitrineNotice {
  id             String @id
  /// Qui l'a envoyée — l'id du staff, jamais son nom recopié.
  authorStaffId  String @map("author_staff_id")
  /// 150 caractères au plus (`CHECK`), texte brut.
  subject        String
  /// 5000 caractères au plus (`CHECK`), texte brut.
  message        String
  /// Fournie par l'écran (UUID) : un double clic retrouve la même annonce.
  idempotencyKey String @unique @map("idempotency_key")

  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  recipients VitrineNoticeRecipient[]

  @@index([createdAt])
  @@map("vitrine_notices")
  @@schema("public")
}

/// **Un destinataire d'une annonce** : l'adresse telle qu'elle était à
/// l'envoi (l'abonné peut en changer ensuite), et ce que le fournisseur a dit.
model VitrineNoticeRecipient {
  noticeId     String    @map("notice_id")
  subscriberId String    @map("subscriber_id")
  /// Copie de l'adresse du contact au moment de l'envoi — au registre RGPD.
  contactEmail String    @map("contact_email")
  /// `NULL` : pas encore tenté · `true` : le fournisseur a ACCEPTÉ (pas
  /// « arrivé ») · `false` : refusé, ou mailer à blanc.
  mailSent     Boolean?  @map("mail_sent")
  attemptedAt  DateTime? @map("attempted_at") @db.Timestamptz(3)

  notice     VitrineNotice     @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  subscriber VitrineSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  @@id([noticeId, subscriberId])
  @@map("vitrine_notice_recipients")
  @@schema("public")
}

/// **Le bail du balayage** (`documentation/webhooks/vitrine.md`, 2026-10-19) :
/// une ligne par balayage nommé, prise par une seule écriture conditionnée.
/// Deux passages du cron qui se chevauchent (un balayage de plus de cinq
/// minutes) ne livrent pas deux fois : le second trouve le bail tenu et sort
/// sans rien faire. Un bail échu (processus tué) se reprend de lui-même.
model VitrineSweepLease {
  /// `sweep` — le seul balayage aujourd'hui.
  name         String    @id
  /// Le jeton du passage qui tient le bail ; seul lui le rend.
  claimToken   String?   @map("claim_token")
  /// `NULL` : libre. Échu au mur (`WallClock`) : libre aussi.
  claimedUntil DateTime? @map("claimed_until") @db.Timestamptz(3)

  @@map("vitrine_sweep_leases")
  @@schema("public")
}
