// ─────────────────────────────────────────────────────────────────────────────
// L'estampille du principal —
// `documentation/caching-usage/plan-principal-en-memoire.md`, §3 et §3 bis.
// ─────────────────────────────────────────────────────────────────────────────

/// **Un numéro qui monte à chaque écriture sur `users`, `memberships`,
/// `companies`** — ce que le résolveur du principal gardé en mémoire lit à
/// chaque requête pour savoir s'il doit relire.
///
/// 🔴 Aucun code ne l'écrit : trois déclencheurs `BEFORE … FOR EACH STATEMENT`
/// (migration `20261104120000_l_estampille_du_principal`). Un compteur et non
/// un journal : son verrou aligne l'ordre des validations sur l'ordre des
/// numéros (§3, après `vitruve`).
///
/// Une seule ligne, `id = 1` (contrainte `CHECK`).
model PrincipalStamp {
  id    Int    @id @db.SmallInt
  value BigInt @default(0)

  @@map("principal_stamp")
  @@schema("public")
}
