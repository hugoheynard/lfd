/// **Un reçu de réassort** — ce que la vitrine d'un point a reçu (lot J1 de
/// `documentation/limites-de-commande/plan-jour-meme-sur-stock.md`, refait au
/// lot R2 de `documentation/reassort-boutiques/plan-reapprovisionnement.md`).
///
/// Un mouvement interne, JAMAIS une commande — aucun prix, aucune TVA, aucun
/// règlement. Un reçu par réassort envoyé (`resupplyId`), et au plus un
/// « réassort sans commande » par (point, journée) (`resupplyId` nul, index
/// unique partiel `resupply_receipt_unordered_key`, écrit dans la migration).
/// Écrit seulement une fois reçu. Le stock estimé (somme des reçus) n'est pas
/// stocké : il se calcule.
model ResupplyReceipt {
  id String @id

  /// Le site de retrait (`pickup_addresses.id`), sans clé étrangère : un site
  /// archivé ne doit pas emporter ce qu'il a reçu.
  siteId     String   @map("site_id")
  /// La journée de vente (date civile de Paris).
  serviceDay DateTime @map("service_day") @db.Date

  /// Le réassort réceptionné ; `null` pour un réassort sans commande.
  resupplyId String?       @unique @map("resupply_id")
  resupply   SiteResupply? @relation(fields: [resupplyId], references: [id], onDelete: Restrict)

  /// Verrou optimiste : deux postes qui corrigent le même reçu ne s'écrasent pas.
  version Int @default(0)

  /// « Réceptionner » (ou la première saisie d'un réassort sans commande) :
  /// instant du `Clock`, auteur figé.
  receivedAt        DateTime @map("received_at")
  receivedByStaffId String   @map("received_by_staff_id")
  receivedByName    String   @map("received_by_name")
  receivedByRole    String   @map("received_by_role")

  /// Instant du dernier geste, lu du `Clock`.
  updatedAt        DateTime @map("updated_at")
  /// Qui l'a fait, figé au geste : l'id de fiche staff, un nom et un rôle instantanés.
  updatedByStaffId String   @map("updated_by_staff_id")
  updatedByName    String   @map("updated_by_name")
  updatedByRole    String   @map("updated_by_role")

  lines ResupplyReceiptLine[]

  @@index([siteId, serviceDay])
  @@map("resupply_receipt")
  @@schema("public")
}

/// Une ligne d'un reçu : le SKU produit, son libellé FIGÉ (lu au catalogue
/// publié, ou recopié du réassort), l'attendu et le reçu (entiers ≥ 0).
model ResupplyReceiptLine {
  id String @id @default(cuid())

  receiptId String          @map("receipt_id")
  receipt   ResupplyReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  sku              String
  label            String
  /// L'attendu : la quantité demandée au réassort ; `null` sans commande.
  expectedQuantity Int?   @map("expected_quantity")
  /// Le reçu.
  quantity         Int
  /// Rang d'affichage : l'ordre du réassort, ou de saisie.
  position         Int

  @@unique([receiptId, sku])
  @@index([receiptId])
  @@map("resupply_receipt_line")
  @@schema("public")
}

/// **Le réassort d'un point** — ce que le comptoir demande au fournil pour sa
/// vitrine (lot R1 de `documentation/reassort-boutiques/plan-reapprovisionnement.md`,
/// §12, Hugo 2026-10-21). JAMAIS une commande : aucun prix, aucune TVA, aucun
/// règlement, aucune clé vers `orders`. Depuis R1c, la demande en cours
/// (brouillon, `placed_at` nul) est écrite aussi ; depuis R1d, le fournil
/// envoie les siens (`origin`), créés déjà envoyés. Une annulation est un
/// état, pas une suppression.
model SiteResupply {
  id String @id

  /// Le point de retrait (`pickup_addresses.id`), sans clé étrangère : un
  /// point archivé ne doit pas emporter ce qu'il a demandé.
  siteId     String   @map("site_id")
  /// `tomorrow` (le soir pour demain) | `asap` (« au plus tôt », le jour même).
  target     String
  /// La journée visée (date civile de Paris), déduite de la visée au geste.
  serviceDay DateTime @map("service_day") @db.Date
  /// Qui l'envoie (lot R1d) : `counter` — le comptoir, par sa demande en
  /// cours ; `bakehouse` — le fournil, « je t'envoie ça », jamais brouillon
  /// (CHECK `site_resupply_bakehouse_placed`).
  origin     String   @default("counter")
  /// Son nom libre et facultatif (lot R1g), « Vitrine du matin » : rogné,
  /// 1 à 60 caractères (CHECK `site_resupply_name_trimmed`), `null` : sans nom.
  name       String?  @db.VarChar(60)

  /// Verrou optimiste : deux postes qui remplissent, envoient ou annulent en
  /// même temps ne s'écrasent pas.
  version Int @default(1)

  /// Le geste « Envoyer le réassort » : instant du `Clock`, auteur figé. Tous
  /// `null` tant que c'est la demande en cours (brouillon, lot R1c). Une seule
  /// demande en cours par (point, visée, journée) : index unique partiel
  /// `site_resupply_open_draft_key`, que Prisma ne sait pas déclarer.
  placedAt        DateTime? @map("placed_at")
  placedByStaffId String?   @map("placed_by_staff_id")
  placedByName    String?   @map("placed_by_name")
  placedByRole    String?   @map("placed_by_role")

  /// Le geste « Annuler » ; tous `null` tant qu'il est passé.
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledByStaffId String?   @map("cancelled_by_staff_id")
  cancelledByName    String?   @map("cancelled_by_name")
  cancelledByRole    String?   @map("cancelled_by_role")

  /// Le signal « il est là » (lot R3e) : la réception au site du transfert
  /// qui le porte, ou « Monté » au fournil pour un point servi sur place.
  /// Tous `null` tant qu'il est attendu ; jamais sur une demande en cours
  /// (CHECK `site_resupply_arrival_whole`, `site_resupply_arrival_placed`).
  arrivedAt        DateTime? @map("arrived_at")
  arrivedByStaffId String?   @map("arrived_by_staff_id")
  arrivedByName    String?   @map("arrived_by_name")
  arrivedByRole    String?   @map("arrived_by_role")

  /// « Lancé par X à HH:MM » (lot R4a) : l'AFFICHAGE du lancement d'un
  /// réassort « au plus tôt » au fournil, posé par l'abonné du fait
  /// `production.resupply_launched`. Le refus d'annuler ne le lit pas : il
  /// est synchrone, au fournil. Nom figé, `null` si l'annuaire n'en avait pas.
  launchedAt     DateTime? @map("launched_at") @db.Timestamptz(6)
  launchedByName String?   @map("launched_by_name")

  /// « Parti à HH:MM » (lot R4d) : l'AFFICHAGE du départ de la tournée qui
  /// porte le transfert du réassort, posé par l'abonné du fait
  /// `delivery.transfer_departed`. Aucun refus ne le lit. Nom figé du
  /// livreur, `null` si la tournée n'en avait pas.
  departedAt     DateTime? @map("departed_at") @db.Timestamptz(6)
  departedByName String?   @map("departed_by_name")

  lines   SiteResupplyLine[]
  /// Son reçu, une fois réceptionné (lot R2).
  receipt ResupplyReceipt?

  @@index([serviceDay, siteId])
  @@map("site_resupply")
  @@schema("public")
}

/// Une ligne demandée : le SKU produit, son libellé FIGÉ au geste (catalogue
/// publié), la quantité demandée (entier > 0).
model SiteResupplyLine {
  id String @id @default(cuid())

  resupplyId String       @map("resupply_id")
  resupply   SiteResupply @relation(fields: [resupplyId], references: [id], onDelete: Restrict)

  sku      String
  label    String
  quantity Int
  /// Rang d'affichage : l'ordre de saisie.
  position Int

  @@unique([resupplyId, sku])
  @@map("site_resupply_line")
  @@schema("public")
}

/// **Une alerte de stock** — « rupture » ou « stock faible » déclarée par le
/// comptoir sur un article, pour un point (lot R1b de
/// `documentation/reassort-boutiques/plan-reapprovisionnement.md`, Hugo
/// 2026-10-21). Aucun effet sur la boutique ni la passation (lot J2).
///
/// Une seule alerte VIVANTE (`lifted_at IS NULL`) par (point, article) : index
/// unique partiel écrit dans la migration (Prisma ne sait pas le déclarer).
/// Pas de suppression : une alerte levée garde qui, quand et pourquoi.
model SiteStockAlert {
  id String @id

  /// Le point de retrait (`pickup_addresses.id`), sans clé étrangère.
  siteId String @map("site_id")
  /// Le SKU produit, et son libellé FIGÉ à la première déclaration.
  sku    String
  label  String
  /// `out_of_stock` (rupture) | `low` (stock faible).
  level  String

  /// Verrou optimiste : deux postes qui touchent la même alerte ne s'écrasent pas.
  version Int @default(1)

  /// La DERNIÈRE déclaration : instant du `Clock`, auteur figé.
  declaredAt        DateTime @map("declared_at")
  declaredByStaffId String   @map("declared_by_staff_id")
  declaredByName    String   @map("declared_by_name")
  declaredByRole    String   @map("declared_by_role")

  /// La levée ; tous `null` tant qu'elle est vivante.
  liftedAt        DateTime? @map("lifted_at")
  liftedByStaffId String?   @map("lifted_by_staff_id")
  liftedByName    String?   @map("lifted_by_name")
  liftedByRole    String?   @map("lifted_by_role")
  /// `manual` (le comptoir) | `receipt` (un réassort de l'article reçu au point).
  liftReason      String?   @map("lift_reason")

  @@index([siteId, liftedAt])
  @@map("site_stock_alert")
  @@schema("public")
}
