// Panier récurrent (abonnement) : un GABARIT de commande qui se répète. Ne
// déclenche pas encore de commande (planificateur différé) ; on capture
// l'intention. Mur = `placed_by_user_id` (comme les commandes perso zéro friction).
// `recurrence`/`status` en String (union validée au bord par zod), dates en Date.
model Subscription {
  id String @id @default(cuid())

  placedByUserId String @map("placed_by_user_id")
  placedBy       User   @relation(fields: [placedByUserId], references: [id])

  /// La société de l'abonnement — celle de l'espace où il a été créé, `null`
  /// en perso (plan-notifications-sous-comptes.md, N4e). Le planificateur en
  /// fera la société de ses commandes ; une fois remplie, elle ne change plus.
  /// Les abonnements d'avant la colonne restent `null`, sans remplissage deviné.
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // Traçabilité : commande d'origine (celle « transformée en panier récurrent »).
  fromOrderId String? @map("from_order_id")

  recurrence String // weekly | biweekly | monthly
  status     String @default("active") // active | paused

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date // null = sans fin

  // Acheminement figé (comme les commandes) : livraison = adresse libre snapshot ;
  // retrait = id du point (ou null = défaut).
  fulfillmentMethod       FulfillmentMethod @map("fulfillment_method")
  deliveryAddressSnapshot Json?             @map("delivery_address_snapshot")
  pickupAddressId         String?           @map("pickup_address_id")

  note String @default("")

  /// La borne basse du planificateur : il ne sert aucune échéance avant ce
  /// jour. Posée à l'armement, puis à chaque reprise — une échéance tombée
  /// avant n'est ni due ni manquée. `null` : jamais armé.
  armedFrom DateTime? @map("armed_from") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines       SubscriptionLine[]
  occurrences SubscriptionOccurrence[]
  runs        SubscriptionOccurrenceRun[]

  @@index([placedByUserId])
  @@index([companyId])
  @@map("subscriptions")
  @@schema("public")
}

model SubscriptionOccurrence {
  id String @id @default(cuid())

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // L'échéance visée (« modifier cette commande uniquement »).
  occurrenceDate DateTime @map("occurrence_date") @db.Date

  // Soit on saute l'échéance, soit on remplace ses lignes pour cette date-là.
  skipped Boolean @default(false)
  lines   Json // [{ sku, quantity }] — remplacement (vide si sautée).
  note    String  @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subscriptionId, occurrenceDate])
  @@index([subscriptionId])
  @@map("subscription_occurrences")
  @@schema("public")
}

model SubscriptionLine {
  id String @id @default(cuid())

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Référence catalogue PIM (String, pas une FK). Le prix est ré-résolu à l'échéance.
  sku      String
  quantity Int

  @@index([subscriptionId])
  @@map("subscription_lines")
  @@schema("public")
}

/// **Le registre des échéances** : ce que le planificateur a fait de chaque
/// échéance d'un panier — une ligne par (panier, jour), jamais deux. Une
/// commande générée est définitive ; un refus se réécrit tant que l'heure
/// limite est ouverte, puis l'échéance passe `missed_deadline`. Écrit par le
/// seul contexte des paniers, par son port `OccurrenceRunLedger`.
/// `order_id` est opaque : aucune clé étrangère vers la commande.
model SubscriptionOccurrenceRun {
  id String @id

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  occurrenceDate DateTime @map("occurrence_date") @db.Date

  outcome String // generated | refused | missed_deadline — CHECK en base

  orderId String? @map("order_id")

  /// La cause d'un refus, code stable (`buyer_left`, `deadline_closed`…).
  cause String?
  /// La phrase de l'alerte, qui nomme le cas et le geste de sortie.
  reason String?

  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)

  /// Le nom que Postgres a donné à l'index : le nom par défaut fait 64
  /// caractères, et Postgres coupe à 63.
  @@unique([subscriptionId, occurrenceDate], map: "subscription_occurrence_runs_subscription_id_occurrence_date_ke")
  @@map("subscription_occurrence_runs")
  @@schema("public")
}
