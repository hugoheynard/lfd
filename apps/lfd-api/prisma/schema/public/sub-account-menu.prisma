/// La **carte d'un sous-compte** : ce que ce site peut commander
/// (`documentation/comptes-client/carte-des-sites.md`, § 3.3, § 4).
/// Clée par le `company_id` DU SOUS-COMPTE. Écrite par l'agrégat
/// `SubAccountMenu` (`lafoliecoffee/account`) ; lue dans la même requête que
/// le lecteur pro (`shared/company-standing`), et seulement sous un principal
/// actif. Les valeurs de `mode` et `off_menu` sont tenues par un CHECK.
model SubAccountMenu {
  companyId        String                @id @map("company_id")
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// `only` (liste blanche) | `except` (liste noire) — le défaut d'un article
  /// qu'aucune entrée ne touche.
  mode             String
  /// `hidden` | `visible_locked` — ce que voit le sous-compte hors carte.
  offMenu          String                @map("off_menu")
  updatedAt        DateTime              @map("updated_at") @db.Timestamptz(3)
  /// L'id de fiche du staff qui a posé la carte ; `null` si c'est le principal.
  updatedByStaffId String?               @map("updated_by_staff_id")
  /// L'utilisateur du principal qui a posé la carte ; `null` si c'est le staff.
  updatedByUserId  String?               @map("updated_by_user_id")
  /// `own` (la carte du site compte) | `follows_common` (elle dort, et la
  /// carte commune du principal compte) — § 6.1. Tenu par un CHECK.
  state            String                @default("own")
  entries          SubAccountMenuEntry[]

  @@map("sub_account_menu")
  @@schema("public")
}

/// Une entrée de la carte : une famille (id PIM), un produit (`productSku`)
/// ou un SKU, incluse ou exclue. Le plus fin l'emporte ; une référence que le
/// catalogue ne livre plus dort.
model SubAccountMenuEntry {
  id        String         @id
  companyId String         @map("company_id")
  menu      SubAccountMenu @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  /// `family` | `product` | `sku`.
  level     String
  ref       String
  /// `include` | `exclude`.
  effect    String

  @@unique([companyId, level, ref])
  @@map("sub_account_menu_entry")
  @@schema("public")
}

/// La **carte commune des sites** d'un principal (`carte-des-sites.md`, § 6) :
/// elle s'applique à chacun de ses sites qui n'a pas de carte propre active,
/// jamais au principal lui-même. Clée par le `company_id` DU PRINCIPAL.
/// Écrite par l'agrégat `PrincipalSitesMenu` (`lafoliecoffee/account`) ; lue
/// dans la même requête que le lecteur pro, par `parentCompany`.
model PrincipalSitesMenu {
  companyId        String                    @id @map("company_id")
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// `only` | `except`, comme la carte d'un site.
  mode             String
  /// `hidden` | `visible_locked`.
  offMenu          String                    @map("off_menu")
  updatedAt        DateTime                  @map("updated_at") @db.Timestamptz(3)
  /// L'id de fiche du staff qui a posé la carte ; `null` si c'est le principal.
  updatedByStaffId String?                   @map("updated_by_staff_id")
  /// L'utilisateur du principal qui a posé la carte ; `null` si c'est le staff.
  updatedByUserId  String?                   @map("updated_by_user_id")
  entries          PrincipalSitesMenuEntry[]

  @@map("principal_sites_menu")
  @@schema("public")
}

/// Une entrée de la carte commune, de la forme de {@link SubAccountMenuEntry}.
model PrincipalSitesMenuEntry {
  id        String             @id
  companyId String             @map("company_id")
  menu      PrincipalSitesMenu @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  /// `family` | `product` | `sku`.
  level     String
  ref       String
  /// `include` | `exclude`.
  effect    String

  @@unique([companyId, level, ref])
  @@map("principal_sites_menu_entry")
  @@schema("public")
}
