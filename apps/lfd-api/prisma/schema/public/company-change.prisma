// Le numéro global des COMPTES CLIENTS —
// `documentation/caching-usage/le-cache-du-back-office.md`, § 2.2.
// ─────────────────────────────────────────────────────────────────────────────

/// **Le journal des écritures sur les comptes clients**, en ajout seul.
///
/// 🔴 Aucun code ne l'écrit : des déclencheurs AU NIVEAU DE L'INSTRUCTION sur
/// chaque table que la liste et la fiche des sociétés lisent l'alimentent
/// (migration `20261112180000_les_journaux_des_comptes_et_des_commandes`).
///
/// Le numéro `companies` est `max(id)`. Un journal plutôt qu'un compteur :
/// une ligne de compteur verrouillerait toutes les écritures de comptes
/// jusqu'au commit. Les lignes de plus de sept jours se balaient ; un journal
/// vide rend `0`, et la séquence ne redémarre pas.
model CompanyChange {
  id        BigInt   @id @default(autoincrement())
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  @@map("company_change")
  @@schema("public")
}
