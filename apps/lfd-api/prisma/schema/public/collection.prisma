// ─────────────────────────────────────────────────────────────────────────────
// Le lot de prélèvement figé — plan
// `documentation/comptabilite/prelevement/lot-de-prelevement-fige.md`.
// ─────────────────────────────────────────────────────────────────────────────
//
// Propriétaire : `src/b2b/accounting/`. Le fichier `pain.008` y est STOCKÉ,
// rendu une fois à la constitution, et relu (empreinte vérifiée) à chaque
// téléchargement.
//
// 🔴 Contraintes INVISIBLES ici — elles vivent dans la migration
// `20261005140000_le_lot_de_prelevement_fige`, Prisma ne sait pas les exprimer :
//   · un seul lot NON annulé par (entité, schéma, clôture) — index partiel ;
//   · un lot déposé porte son instant et son auteur, un lot annulé aussi ;
//   · un montant de ligne est strictement positif ;
//   · une commande `batched`/`collected` cite sa ligne, une `excluded` sa
//     raison, une `settled_otherwise` sa note et son auteur ;
//   · `collection_floor` n'a qu'une ligne.

/// L'état d'un lot. `constituted` est le seul dont on sort.
enum CollectionBatchStatus {
  constituted
  deposited
  cancelled

  @@schema("public")
}

/// L'état d'encaissement d'une commande. L'absence de ligne vaut `due`.
enum OrderCollectionState {
  due
  batched
  excluded
  collected
  settled_otherwise
  /// La banque a rejeté ou retourné sa ligne (R5a) : garde sa ligne, hors des états ouverts.
  returned
  /// Passée en perte par le staff, après un retour.
  written_off

  @@schema("public")
}

/// Pourquoi une commande a été écartée d'un lot. Une VALEUR : elle ne se
/// renomme que par migration.
enum CollectionExclusionReason {
  no_mandate
  payer_detached
  one_off_consumed
  ambiguous_creditor
  /// Un bon qu'on ne sait pas facturer (incohérent, surtaxe sans taux, taux
  /// de ligne illisible) — plan `le-prelevement-suit-la-facture.md`.
  unbillable
  /// Une facture émise dont les bons tomberaient sur plusieurs mandats (E4) :
  /// elle ne se prélève pas en morceaux.
  invoice_split

  @@schema("public")
}

/// Un lot : UN fichier `pain.008` d'une entité, d'un schéma, d'un cycle.
model CollectionBatch {
  /// ULID — il entre dans `MsgId`, `PmtInfId` et `EndToEndId` (format arrêté).
  id String @id

  legalEntityId String      @map("legal_entity_id")
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)

  scheme SepaScheme

  cycleStartsAt DateTime @map("cycle_starts_at") @db.Timestamptz(3)
  /// Exclusive. La dernière d'une entité EST sa clôture enregistrée.
  cycleClosesAt DateTime @map("cycle_closes_at") @db.Timestamptz(3)

  status CollectionBatchStatus

  constitutedAt        DateTime  @map("constituted_at") @db.Timestamptz(3)
  /// `staff` | `system` (l'automatisme, PA3). Un CHECK
  /// (`20261008170000_la_constitution_automatique`) tient : `staff` ⇒ fiche
  /// présente, `system` ⇒ aucune — le système n'est jamais joint à l'annuaire.
  constitutedBy        String    @default("staff") @map("constituted_by")
  /// Identifiant staff LOCAL — jamais un `sub`. NULL pour un lot `system`.
  constitutedByStaffId String?   @map("constituted_by_staff_id")
  depositedAt          DateTime? @map("deposited_at") @db.Timestamptz(3)
  depositedByStaffId   String?   @map("deposited_by_staff_id")
  cancelledAt          DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledByStaffId   String?   @map("cancelled_by_staff_id")

  /// Les sociétés du cycle sans mandat prélevable : le lot n'est pas
  /// déposable tant qu'il en nomme une (Q2, interdiction gardée).
  unmandatedCompanies String[] @default([]) @map("unmandated_companies")

  /// Le fichier, rendu UNE fois. `CreDtTm` = `constituted_at`.
  xml        String
  fileSha256 String @map("file_sha256")

  /// L'échéance (`ReqdColltnDt`), FIGÉE à la constitution — la même que le
  /// XML. NULL pour les lots d'avant le 2026-10-08 : leur XML fait foi.
  /// Changer l'échéance d'un lot = l'annuler et le reconstituer.
  requestedCollectionDay DateTime? @map("requested_collection_day") @db.Date
  /// L'échéance que le calendrier donnait (clôture + N, TARGET2) quand une
  /// constitution tardive l'a repoussée pour tenir le préavis (D4, PA2) ;
  /// NULL sinon, et pour les lots d'avant.
  postponedFromDay       DateTime? @map("postponed_from_day") @db.Date

  lines   CollectionBatchLine[]
  notices CollectionNotice[]

  @@index([legalEntityId, cycleClosesAt])
  @@map("collection_batch")
  @@schema("public")
}

/// Une ligne du fichier : UN débiteur, ses commandes, le mandat figé.
model CollectionBatchLine {
  batchId String          @map("batch_id")
  batch   CollectionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  rank    Int

  endToEndId String @unique @map("end_to_end_id")

  mandateId        String   @map("mandate_id")
  mandateReference String   @map("mandate_reference")
  mandateSignedAt  DateTime @map("mandate_signed_at") @db.Timestamptz(3)
  /// La société débitée — le payeur.
  debtorCompanyId  String   @map("debtor_company_id")
  debtorName       String   @map("debtor_name")
  /// Scellé (AES-256-GCM, `FieldCipher`) — comme `company_bank_accounts`.
  debtorIbanSealed String   @map("debtor_iban_sealed")
  debtorIbanLast4  String   @map("debtor_iban_last4")
  debtorBic        String?  @map("debtor_bic")
  /// `RCUR` | `OOFF`.
  sequence         String
  /// Le total TTC de la facture calculée en une fois sur les bons de la
  /// ligne (F2) — ce que la banque prélève. Avant F2 : Σ des bons.
  amountCents      Int      @map("amount_cents")
  /// Σ des totaux des bons de la ligne ; l'écart = `amount_cents` − ceci.
  /// NULL pour les lignes des lots constitués avant F2 (2026-10-08) : jamais
  /// calculé, et pas inventé.
  ordersTotalCents Int?     @map("orders_total_cents")
  orderCount       Int      @map("order_count")
  /// Dont commandes de cycles antérieurs — reprises.
  priorOrderCount  Int      @map("prior_order_count")

  orders     OrderCollection[]
  /// Son arrêté de facturation (F3) ; absent pour une ligne d'un lot d'avant,
  /// et pour une ligne qui encaisse des factures (E4).
  statement  BillingStatement?
  /// Les factures émises que la ligne encaisse (E4) ; aucune avant E4.
  invoices   CollectionBatchLineInvoice[]
  /// Le retour bancaire de la ligne (R5a) ; un seul, par `end_to_end_id`.
  bankReturn CollectionReturn?

  @@id([batchId, rank])
  @@index([mandateId])
  @@map("collection_batch_line")
  @@schema("public")
}

/// Une facture qu'une ligne de débit encaisse (E4).
model CollectionBatchLineInvoice {
  batchId   String              @map("batch_id")
  lineRank  Int                 @map("line_rank")
  line      CollectionBatchLine @relation(fields: [batchId, lineRank], references: [batchId, rank], onDelete: Restrict)
  invoiceId String              @map("invoice_id")
  invoice   Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@id([batchId, lineRank, invoiceId])
  @@index([invoiceId])
  @@map("collection_batch_line_invoice")
  @@schema("public")
}

/// L'état d'encaissement d'UNE commande. `order_id` est opaque.
model OrderCollection {
  orderId String @id @map("order_id")

  state OrderCollectionState

  batchId  String?              @map("batch_id")
  lineRank Int?                 @map("line_rank")
  line     CollectionBatchLine? @relation(fields: [batchId, lineRank], references: [batchId, rank], onDelete: Restrict)

  exclusionReason CollectionExclusionReason? @map("exclusion_reason")

  amountCents Int @map("amount_cents")

  settledNote      String? @map("settled_note")
  settledByStaffId String? @map("settled_by_staff_id")

  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([state])
  @@index([batchId])
  @@map("order_collection")
  @@schema("public")
}

/// Le plancher : aucune commande créée avant n'entre dans un lot. Une ligne,
/// posée par la migration à l'instant de son déploiement.
model CollectionFloor {
  id      Boolean  @id @default(true)
  floorAt DateTime @map("floor_at") @db.Timestamptz(3)

  @@map("collection_floor")
  @@schema("public")
}

/// Ce que l'avis annonce au payeur. Une VALEUR : elle ne se renomme que par migration.
enum CollectionNoticeKind {
  notice
  correction
  cancellation
  unchanged

  @@schema("public")
}

/// Où en est l'avis. `queued` = mis en file, PAS envoyé.
enum CollectionNoticeStatus {
  queued
  sent
  failed
  unsendable

  @@schema("public")
}

/// L'avis de prélèvement d'un payeur (plan
/// `documentation/comptabilite/prelevement/prelevement-automatique.md`, PA2), écrit
/// dans la transaction du lot. Contraintes en SQL
/// (`20261008160000_l_avis_de_prelevement`) : une annulation n'a ni lot ni
/// ligne, les autres ont les deux ; un rectificatif porte l'avant ; un avis
/// non envoyable n'a pas d'adresse, les autres en ont une ; montant > 0.
model CollectionNotice {
  /// ULID — sert de clé d'idempotence chez le fournisseur.
  id String @id

  legalEntityId String   @map("legal_entity_id")
  /// La clôture du cycle annoncé — c'est elle qui relie les avis d'un lot
  /// annulé à ceux de sa reconstitution.
  cycleClosesAt DateTime @map("cycle_closes_at") @db.Timestamptz(3)

  batchId  String?          @map("batch_id")
  batch    CollectionBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  lineRank Int?             @map("line_rank")

  /// Le payeur — opaque, comme `collection_batch_line.debtor_company_id`.
  debtorCompanyId String @map("debtor_company_id")
  debtorName      String @map("debtor_name")

  kind   CollectionNoticeKind
  status CollectionNoticeStatus

  recipientEmail  String? @map("recipient_email")
  /// `billing_contact` | `owner`.
  recipientSource String? @map("recipient_source")

  amountCents           Int       @map("amount_cents")
  collectionDay         DateTime  @map("collection_day") @db.Date
  previousAmountCents   Int?      @map("previous_amount_cents")
  previousCollectionDay DateTime? @map("previous_collection_day") @db.Date

  mandateReference        String    @map("mandate_reference")
  /// L'arrêté de la ligne ; NULL pour une annulation, et pour une ligne qui
  /// encaisse des factures (E4).
  statementId             String?   @map("statement_id")
  /// Les factures que l'avis cite (E4) ; vide avant E4 et pour une annulation.
  invoiceNumbers          String[]  @default([]) @map("invoice_numbers")
  /// Le jour du rejet que cette ligne re-présente (R5a) ; NULL sinon.
  representedRejectionDay DateTime? @map("represented_rejection_day") @db.Date
  creditorName            String    @map("creditor_name")
  creditorIcs             String    @map("creditor_ics")
  /// L'avis parti que celui-ci rectifie, annule ou reconduit.
  supersedesId            String?   @map("supersedes_id")

  createdAt DateTime  @map("created_at") @db.Timestamptz(3)
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(3)
  failedAt  DateTime? @map("failed_at") @db.Timestamptz(3)
  failure   String?

  @@unique([batchId, lineRank])
  @@index([legalEntityId, cycleClosesAt])
  @@map("collection_notice")
  @@schema("public")
}

/// UNE tentative de la constitution automatique par (entité, clôture) — plan
/// `documentation/comptabilite/prelevement/prelevement-automatique.md`, PA3. La clé
/// départage deux passages et interdit de retenter : annuler un lot ne
/// relance pas l'automatisme. Contraintes en SQL
/// (`20261008170000_la_constitution_automatique`) : `outcome` ∈ `pending`,
/// `constituted`, `nothing_to_collect`, `not_yet_open`, `failed` ; un échec
/// porte son message.
model CollectionAutopilotRun {
  legalEntityId String      @map("legal_entity_id")
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  /// La clôture du cycle tenté — exclusive.
  cycleClosesAt DateTime    @map("cycle_closes_at") @db.Timestamptz(3)
  ranAt         DateTime    @map("ran_at") @db.Timestamptz(3)
  outcome       String
  /// Le refus tel quel (`failed`), ou ce que l'issue doit dire en clair.
  message       String?

  @@id([legalEntityId, cycleClosesAt])
  @@map("collection_autopilot_run")
  @@schema("public")
}
