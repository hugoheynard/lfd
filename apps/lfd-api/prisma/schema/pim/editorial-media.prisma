// ---------------------------------------------------------------------------
// Couche éditoriale (doc 01). Rythme de vie propre : change à chaque saison,
// là où l'identité ne bouge jamais. D'où une table séparée, pas des colonnes.
// ---------------------------------------------------------------------------

enum MediaRole {
  hero
  gallery
  lifestyle
  thumbnail
  print

  @@schema("pim")
}

model ProductEditorial {
  productId String  @id @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  descriptionShort Json?   @map("description_short")
  descriptionLong  Json?   @map("description_long")
  story            Json?
  pairing          Json?
  brand            String?
  seoTitle         Json?   @map("seo_title")
  seoDescription   Json?   @map("seo_description")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_editorial")
  @@schema("pim")
}

/// **Un contenu, adressé par son empreinte.** Le magasin partagé des révisions.
///
/// Deux révisions qui partagent quatre-vingt-dix articles inchangés partagent
/// quatre-vingt-dix lignes ICI : une ancre posée sur un catalogue stable ne
/// coûte presque rien, et un diff se calcule en comparant des empreintes avant
/// de lire un seul payload. C'est le mécanisme de git, pour la même raison — et
/// c'est lui qui rend une révision du catalogue COMPLET abordable.
///
/// Jamais purgé avec une révision : un contenu peut être référencé par
/// plusieurs. C'est ce que la clé étrangère de `CatalogRevisionItem` garantit.
model CatalogContent {
  /// SHA-256 du payload canonique (clés triées). L'empreinte EST l'identité.
  hash String @id

  /// L'article figé — la fiche entière moins les octets des visuels, qui vivent
  /// dans le bucket et voyagent par leur URL.
  payload Json

  createdAt DateTime @default(now()) @map("created_at")

  items CatalogRevisionItem[]

  @@map("catalog_content")
  @@schema("pim")
}

model ProductMedia {
  productId String  @map("product_id")

  /// L'image désignée par son **URL**, et par rien d'autre.
  ///
  /// 🔴 Aucune clé étrangère, et c'est le sujet : la bibliothèque est un BLOC à
  /// part depuis le 2026-09-23, dans son propre schéma. Entre deux blocs, ce
  /// dépôt référence par identifiant opaque — exactement comme une ligne de
  /// commande B2B porte un SKU du référentiel. L'URL fait un bon identifiant :
  /// elle est le SHA-256 du contenu, donc stable pour des octets donnés.
  ///
  /// ⚠️ Ce qu'on a perdu au passage : le `ON DELETE RESTRICT` qui empêchait de
  /// supprimer une image affichée. Cette règle vit désormais dans le code —
  /// `DiscardMediaHandler` compte les emplois et refuse, le ramassage
  /// interroge les porteurs et s'abstient si l'un d'eux se tait.
  mediaUrl  String  @map("media_url")
  product   Product @relation(fields: [productId], references: [id])
  role      MediaRole
  position  Int        @default(0)

  /// Quand ce rattachement a bougé. Il n'était pas daté, et c'était sans
  /// conséquence tant que personne ne demandait « la fiche a-t-elle changé
  /// depuis ? » — `ProductReadiness` le demande, et une déclaration qui
  /// ignorerait les visuels se dirait à jour après un changement de photo.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([productId, mediaUrl, role])
  @@index([productId])
  @@index([mediaUrl])
  @@map("product_media")
  @@schema("pim")
}
