// ─────────────────────────────────────────────────────────────────────────────
// SCHÉMA `pim` — le référentiel produit.
//
// Il avait sa propre BASE, avec son propre client et son propre historique de
// migrations : c'était l'étape B2, qui fusionnait les processus sans toucher
// aux données. B4 la termine — une seule base, un schéma par besoin, aux côtés
// de `public`, `growth` et `ops`.
//
// La frontière, elle, ne disparaît pas : `PimDatabaseModule` reste NON global,
// et seul `src/pim/` injecte de quoi lire ces tables. Un schéma partagé n'est
// pas une permission partagée.
//
// Conventions héritées du socle catalogue (doc `02-catalogue-items.md`) :
// - identifiants assignés par la COMMANDE (R1) — aucun `@default(uuid())` ;
// - aucun DELETE physique (R3) — archivage par drapeau ;
// - `created_at` / `updated_at` / `updated_by` sont des colonnes SYSTÈME ;
// - textes traduisibles = `Json` `{ fr, en? }` (`fr` obligatoire).
// ─────────────────────────────────────────────────────────────────────────────

/// **Le point d'arrêt de prise de commande**, posé sur une portée du catalogue.
///
/// Une ligne par portée : `global` ferme toute la production, `category` dit
/// qu'une famille n'a pas la même charge, `product` / `variant` le cas
/// particulier — jusqu'au conditionnement, parce que le pot de 200 g et le seau
/// de 5 kg ne se préparent pas pareil.
///
/// 🔴 **Les trois valeurs sont nullables, et c'est la décision structurante.**
/// L'héritage se fait CHAMP PAR CHAMP : un rang pose ce qu'il change et hérite
/// du reste. Le jour où le labo passe de 18 h à 16 h, tout ce qui n'a pas
/// d'heure propre suit — alors qu'une règle recopiée entière serait restée
/// figée, en silence, sur chaque article qui l'avait dupliquée.
///
/// `NULL` ne veut donc pas dire « aucune limite » : il veut dire **« ce rang ne
/// se prononce pas »**. Confondre les deux empêcherait de déclarer une famille
/// explicitement libre sous un global contraignant.
///
/// ⚠️ Comme pour `PriceFloor`, l'unicité réelle n'est PAS dans ce modèle :
/// `@@unique([scopeType, scopeId])` laisserait passer deux règles globales,
/// Postgres tenant deux `NULL` pour distincts. C'est l'index unique
/// `order_time_limit_one_per_scope` sur `coalesce(scope_id, '')`, posé en SQL
/// par la migration, qui porte la garantie.
model OrderTimeLimit {
  id String @id

  /// `global` | `category` | `product` | `variant`. `scopeId` est `NULL` **si et
  /// seulement si** `scopeType = 'global'`.
  scopeType String  @map("scope_type")
  scopeId   String? @map("scope_id")

  /// Combien de jours **avant** l'acheminement la limite tombe. `0` = le jour même.
  daysBefore Int? @map("days_before")

  /// `HH:MM` en heure de pendule d'**Europe/Paris**, jamais un instant UTC.
  time String?

  /// Le rattrapage après la limite, en minutes. Non déclaré ⇒ `0` à la
  /// résolution, c'est-à-dire une limite ferme.
  graceMinutes Int? @map("grace_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([scopeType])
  @@map("order_time_limit")
  @@schema("pim")
}

/// Taux de TVA — référence commerciale partagée. Les canaux en dérivent ce
/// dont ils ont besoin : Shopify un handle de collection, la boutique B2B un
/// nombre à facturer. Aucun de ces deux vocabulaires ne vit ici.
/// Un **contexte de vente** — une manière de vendre l'article qui a son propre
/// traitement de TVA (donc sa propre collection `tva-*` côté Shopify).
///
/// Une TABLE et non trois colonnes sur `category` : ajouter « B2B » ou « borne
/// libre-service » doit être une LIGNE, pas une migration plus un déploiement.
/// Les trois colonnes `*_tva_id` de `category` sont l'ancien modèle ; elles
/// tombent au troisième déploiement (étendre → basculer → resserrer).
model SalesContext {
  id    String @id
  /// Identité stable, lue par le code (`emporter`, `surPlace`, `b2b`).
  key   String @unique
  /// Ce qu'un humain lit à l'écran.
  label String

  /// Suffixe de handle Shopify. **Vide pour le contexte par défaut** : le
  /// handle nu protège les URL déjà indexées (cf. C0-bis, write-once SEO).
  handleSuffix String @default("") @map("handle_suffix")

  /// Le contexte est-il **en service** ? Un contexte hors service ne se règle
  /// plus à l'écran et ne facture plus. Explicite, jamais implicite : la TVA est
  /// de l'argent, et un contexte activé par accident facture faux.
  active Boolean @default(false)

  /// Shopify en fait-il un produit ? **Distinct de `active`**, et la distinction
  /// n'est pas théorique : le B2B est en service — il facture ses professionnels
  /// — sans que la boutique en ligne ait à porter un second produit par article.
  /// Les confondre activerait des handles `-b2b` le jour où on règle un taux B2B.
  shopifyProjected Boolean @default(false) @map("shopify_projected")

  position Int @default(0)

  categoryVat CategoryContextVat[]
  productVat  ProductContextVat[]
  /// Les points de vente qui offrent ce contexte — l'autre bout de la jointure.
  offeredBy   PointOfSaleContext[]

  /// Ce qui se vend dans ce contexte. Le `Restrict` protège la clé : un contexte
  /// encore vendu ne se supprime pas sous les familles qui le vendent.
  categoryChannels CategoryChannel[]
  productChannels  ProductChannel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_context")
  @@schema("pim")
}

/// Le **genre** d'un point de vente. `shop` = une boutique physique, qui a une
/// URL de click & collect et peut être équipée d'une grille de tables ;
/// `platform` = une plateforme de commande, la boutique professionnelle B2B
/// aujourd'hui.
enum PointOfSaleKind {
  shop
  platform

  @@map("point_of_sale_kind")
  @@schema("pim")
}

/// **D'où l'on vend** — l'entité dont `emplacement` n'était qu'un cas.
///
/// Elle manquait, et ça se lisait à deux endroits : `category_channel.location_id`
/// pouvait être `NULL`, et ce `NULL` voulait dire « le B2B » ; et
/// `sales_context.per_location` n'existait que pour distinguer ce cas. Un `NULL`
/// porteur de sens est toujours le signe d'une ligne absente — ici, la
/// plateforme professionnelle.
///
/// Une boutique porte l'identifiant de l'emplacement dont elle vient : la
/// fusion de p-3 a été un `RENAME`, pas une copie — les jetons de QR déjà
/// imprimés survivent, et la matrice n'a eu aucune référence à retraduire.
///
/// ⚠️ L'unicité du libellé n'est pas ici : `point_of_sale_label_unique`, index
/// sur `lower(label)` — insensible à la casse, comme la lecture de l'écran.
/// Posée en SQL par `20260826240000_resserrer_point_de_vente`.
model PointOfSale {
  id    String          @id
  kind  PointOfSaleKind
  label String

  /// URL de base du click & collect. **Boutique seulement** : `NULL` pour une
  /// plateforme, et `point_of_sale_shop_has_base_url` (SQL) le tient — le genre
  /// n'est pas une convention de lecture, c'est une contrainte.
  baseUrl String? @map("base_url")

  /// Ce que ce point de vente OFFRE — distinct de ce qu'on y vend
  /// (`category_channel`), qui est une décision de catalogue.
  contexts PointOfSaleContext[]

  /// Sa grille de tables à QR. De l'**équipement**, pas un mode de vente : deux
  /// boulangeries peuvent toutes deux servir en salle et une seule être équipée.
  tables PointOfSaleTable[]

  /// Ce qu'on y vend. Le `Restrict` protège la ligne : un point de vente encore
  /// vendu ne se supprime pas sous les familles qui le vendent.
  categoryChannels CategoryChannel[]
  productChannels  ProductChannel[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("point_of_sale")
  @@schema("pim")
}

/// **Ce qu'un point de vente offre.** Successeur de `location_context`, qui ne
/// savait pas parler de la plateforme faute de ligne pour elle.
model PointOfSaleContext {
  pointOfSaleId String      @map("point_of_sale_id")
  pointOfSale   PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)

  /// La `key` du contexte, pas son `id` : c'est elle que le reste du référentiel
  /// cite, et une jointure sur `id` obligerait chaque lecteur à traduire.
  contextKey String       @map("context_key")
  context    SalesContext @relation(fields: [contextKey], references: [key])

  createdAt DateTime @default(now()) @map("created_at")

  @@id([pointOfSaleId, contextKey])
  @@index([contextKey])
  @@map("point_of_sale_context")
  @@schema("pim")
}

/// Une **table** d'une boutique. Le `number` est verrouillé (identité de l'URL
/// imprimée) : clé primaire composite `(point de vente, numéro)`. Suppression en
/// cascade avec le point de vente.
model PointOfSaleTable {
  pointOfSaleId String      @map("point_of_sale_id")
  pointOfSale   PointOfSale @relation(fields: [pointOfSaleId], references: [id], onDelete: Cascade)
  number        Int
  qrCreated     Boolean     @default(false) @map("qr_created")
  /// Token rotatif du QR : le régénérer invalide l'ancien code imprimé.
  /// `NULL` = aucun QR généré.
  token         String?

  @@id([pointOfSaleId, number])
  @@map("point_of_sale_table")
  @@schema("pim")
}
