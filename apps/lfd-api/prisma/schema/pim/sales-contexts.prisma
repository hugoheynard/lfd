// ─────────────────────────────────────────────────────────────────────────────
// SCHÉMA `pim` — le référentiel produit.
//
// Il avait sa propre BASE, avec son propre client et son propre historique de
// migrations : c'était l'étape B2, qui fusionnait les processus sans toucher
// aux données. B4 la termine — une seule base, un schéma par besoin, aux côtés
// de `public`, `growth` et `ops`.
//
// La frontière, elle, ne disparaît pas : `PimDatabaseModule` reste NON global,
// et seul `src/pim/` injecte de quoi lire ces tables. Un schéma partagé n'est
// pas une permission partagée.
//
// Conventions héritées du socle catalogue (doc `02-catalogue-items.md`) :
// - identifiants assignés par la COMMANDE (R1) — aucun `@default(uuid())` ;
// - aucun DELETE physique (R3) — archivage par drapeau ;
// - `created_at` / `updated_at` / `updated_by` sont des colonnes SYSTÈME ;
// - textes traduisibles = `Json` `{ fr, en? }` (`fr` obligatoire).
// ─────────────────────────────────────────────────────────────────────────────

/// **La limite de commande**, posée sur un produit ou sur une famille.
///
/// Une ligne par portée. Le référentiel ne pose que `product` et `category`
/// (CHECK `order_time_limit_product_or_family`) ; une limite de famille vise
/// toute sa descendance, sauf ses exclusions (`OrderTimeLimitExclusion`), et
/// quand plusieurs limites visent un article, la plus stricte gagne.
///
/// Une limite est une **règle entière** : `days_before` et `time` sont tous
/// deux posés, `grace_minutes` vaut `NULL` (pas de rattrapage). Les colonnes
/// restent nullables pour relire les lignes résiduelles, que la résolution
/// ignore.
///
/// ⚠️ Comme pour `PriceFloor`, l'unicité réelle n'est PAS dans ce modèle :
/// `@@unique([scopeType, scopeId])` laisserait passer deux lignes sans cible,
/// Postgres tenant deux `NULL` pour distincts. C'est l'index unique
/// `order_time_limit_one_per_scope` sur `coalesce(scope_id, '')`, posé en SQL
/// par la migration, qui porte la garantie.
model OrderTimeLimit {
  id String @id

  /// `product` | `category` (CHECK `order_time_limit_product_or_family`) ;
  /// `global` et `variant` sont retirées.
  scopeType String  @map("scope_type")
  scopeId   String? @map("scope_id")

  /// Combien de jours **avant** l'acheminement la limite tombe. `0` = le jour même.
  daysBefore Int? @map("days_before")

  /// `HH:MM` en heure de pendule d'**Europe/Paris**, jamais un instant UTC.
  time String?

  /// Le rattrapage après la limite, en minutes. Non déclaré ⇒ `0` à la
  /// résolution, c'est-à-dire une limite ferme.
  graceMinutes Int? @map("grace_minutes")

  /// L'équipe peut-elle passer outre cette limite en saisissant une commande
  /// pour un client ? Une décision de catalogue : le produit répond de sa
  /// faisabilité au fournil. Décochée par défaut : une limite est
  /// infranchissable tant que personne n'a dit le contraire.
  staffMayExceed Boolean @default(false) @map("staff_may_exceed")

  /// Archivée : la limite **cesse de s'appliquer** — ni le référentiel ni le
  /// fil vers le commerce ne la lisent plus. `NULL` = en vigueur.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  /// Les produits exclus nommément d'une limite de FAMILLE, retirés compris.
  exclusions OrderTimeLimitExclusion[]

  @@index([scopeType])
  @@map("order_time_limit")
  @@schema("pim")
}

/// **Un produit exclu nommément de la limite d'une famille** : il échappe à
/// CETTE limite seulement — pas à la sienne, ni à celle d'une famille parente
/// qui ne l'exclut pas.
///
/// Retirer une exclusion pose `removedAt` : elle fait partie de l'agrégat
/// `OrderTimeLimit`, et rien ne s'y efface. Ré-exclure après un retrait crée
/// une nouvelle ligne.
///
/// ⚠️ L'unicité réelle n'est PAS dans ce modèle : l'index unique PARTIEL
/// `order_time_limit_exclusion_one_live` (`WHERE removed_at IS NULL`), posé en
/// SQL par la migration, interdit deux exclusions vivantes du même produit.
model OrderTimeLimitExclusion {
  /// ULID, assigné par l'`IdGenerator`.
  id String @id

  limitId String         @map("limit_id")
  limit   OrderTimeLimit @relation(fields: [limitId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "order_time_limit_exclusion_limit_fkey")

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "order_time_limit_exclusion_product_fkey")

  /// Du `Clock`, jamais un défaut de la base.
  createdAt DateTime  @map("created_at") @db.Timestamptz(6)
  /// `NULL` = l'exclusion est en vigueur.
  removedAt DateTime? @map("removed_at") @db.Timestamptz(6)

  @@map("order_time_limit_exclusion")
  @@schema("pim")
}

/// Taux de TVA — référence commerciale partagée. Les canaux en dérivent ce
/// dont ils ont besoin — la boutique B2B un nombre à facturer. Aucun vocabulaire
/// de canal ne vit ici.
/// Un **contexte de vente** — une manière de vendre l'article qui a son propre
/// traitement de TVA.
///
/// Une TABLE et non trois colonnes sur `category` : ajouter « B2B » ou « borne
/// libre-service » doit être une LIGNE, pas une migration plus un déploiement.
/// Les trois colonnes `*_tva_id` de `category` sont l'ancien modèle ; elles
/// tombent au troisième déploiement (étendre → basculer → resserrer).
model SalesContext {
  id    String @id
  /// Identité stable, lue par le code (`emporter`, `surPlace`, `b2b`).
  key   String @unique
  /// Ce qu'un humain lit à l'écran.
  label String

  /// Le contexte est-il **en service** ? Un contexte hors service ne se règle
  /// plus à l'écran et ne facture plus. Explicite, jamais implicite : la TVA est
  /// de l'argent, et un contexte activé par accident facture faux.
  active Boolean @default(false)

  position Int @default(0)

  /// Les taux réglés dans ce contexte. Le `Restrict` (côté taux) protège la
  /// clé : un contexte qui porte un taux ne se supprime pas sous lui.
  categoryVat CategoryContextVat[]
  productVat  ProductContextVat[]

  /// Archivé : ne se propose plus (L4 du plan du référentiel). `NULL` = en
  /// service. On ne supprime plus : l'archive se restaure.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_context")
  @@schema("pim")
}
