// ─────────────────────────────────────────────────────────────────────────────
// SCHÉMA `pim` — le référentiel produit.
//
// Il avait sa propre BASE, avec son propre client et son propre historique de
// migrations : c'était l'étape B2, qui fusionnait les processus sans toucher
// aux données. B4 la termine — une seule base, un schéma par besoin, aux côtés
// de `public`, `growth` et `ops`.
//
// La frontière, elle, ne disparaît pas : `PimDatabaseModule` reste NON global,
// et seul `src/pim/` injecte de quoi lire ces tables. Un schéma partagé n'est
// pas une permission partagée.
//
// Conventions héritées du socle catalogue (doc `02-catalogue-items.md`) :
// - identifiants assignés par la COMMANDE (R1) — aucun `@default(uuid())` ;
// - aucun DELETE physique (R3) — archivage par drapeau ;
// - `created_at` / `updated_at` / `updated_by` sont des colonnes SYSTÈME ;
// - textes traduisibles = `Json` `{ fr, en? }` (`fr` obligatoire).
// ─────────────────────────────────────────────────────────────────────────────

/// **Le point d'arrêt de prise de commande**, posé sur une portée du catalogue.
///
/// Une ligne par portée : `global` ferme toute la production, `category` dit
/// qu'une famille n'a pas la même charge, `product` / `variant` le cas
/// particulier — jusqu'au conditionnement, parce que le pot de 200 g et le seau
/// de 5 kg ne se préparent pas pareil.
///
/// 🔴 **Les trois valeurs sont nullables, et c'est la décision structurante.**
/// L'héritage se fait CHAMP PAR CHAMP : un rang pose ce qu'il change et hérite
/// du reste. Le jour où le labo passe de 18 h à 16 h, tout ce qui n'a pas
/// d'heure propre suit — alors qu'une règle recopiée entière serait restée
/// figée, en silence, sur chaque article qui l'avait dupliquée.
///
/// `NULL` ne veut donc pas dire « aucune limite » : il veut dire **« ce rang ne
/// se prononce pas »**. Confondre les deux empêcherait de déclarer une famille
/// explicitement libre sous un global contraignant.
///
/// ⚠️ Comme pour `PriceFloor`, l'unicité réelle n'est PAS dans ce modèle :
/// `@@unique([scopeType, scopeId])` laisserait passer deux règles globales,
/// Postgres tenant deux `NULL` pour distincts. C'est l'index unique
/// `order_time_limit_one_per_scope` sur `coalesce(scope_id, '')`, posé en SQL
/// par la migration, qui porte la garantie.
model OrderTimeLimit {
  id String @id

  /// `global` | `category` | `product` | `variant`. `scopeId` est `NULL` **si et
  /// seulement si** `scopeType = 'global'`.
  scopeType String  @map("scope_type")
  scopeId   String? @map("scope_id")

  /// Combien de jours **avant** l'acheminement la limite tombe. `0` = le jour même.
  daysBefore Int? @map("days_before")

  /// `HH:MM` en heure de pendule d'**Europe/Paris**, jamais un instant UTC.
  time String?

  /// Le rattrapage après la limite, en minutes. Non déclaré ⇒ `0` à la
  /// résolution, c'est-à-dire une limite ferme.
  graceMinutes Int? @map("grace_minutes")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([scopeType])
  @@map("order_time_limit")
  @@schema("pim")
}

/// Taux de TVA — référence commerciale partagée. Les canaux en dérivent ce
/// dont ils ont besoin — la boutique B2B un nombre à facturer. Aucun vocabulaire
/// de canal ne vit ici.
/// Un **contexte de vente** — une manière de vendre l'article qui a son propre
/// traitement de TVA.
///
/// Une TABLE et non trois colonnes sur `category` : ajouter « B2B » ou « borne
/// libre-service » doit être une LIGNE, pas une migration plus un déploiement.
/// Les trois colonnes `*_tva_id` de `category` sont l'ancien modèle ; elles
/// tombent au troisième déploiement (étendre → basculer → resserrer).
model SalesContext {
  id    String @id
  /// Identité stable, lue par le code (`emporter`, `surPlace`, `b2b`).
  key   String @unique
  /// Ce qu'un humain lit à l'écran.
  label String

  /// Le contexte est-il **en service** ? Un contexte hors service ne se règle
  /// plus à l'écran et ne facture plus. Explicite, jamais implicite : la TVA est
  /// de l'argent, et un contexte activé par accident facture faux.
  active Boolean @default(false)

  position Int @default(0)

  /// Les taux réglés dans ce contexte. Le `Restrict` (côté taux) protège la
  /// clé : un contexte qui porte un taux ne se supprime pas sous lui.
  categoryVat   CategoryContextVat[]
  productVat    ProductContextVat[]
  /// Les quantités minimales réglées dans ce contexte (`Restrict`).
  minQuantities VariantMinQuantity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_context")
  @@schema("pim")
}
