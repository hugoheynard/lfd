// ─────────────────────────────────────────────────────────────────────────────
// PLATFORM — la boîte d'envoi, aucune connaissance métier
// ─────────────────────────────────────────────────────────────────────────────
//
// Plan `documentation/journalisation/plan-boite-d-envoi.md`, lot BE1 (§7 et §8).
// Code dans `src/platform/outbox/`. Le `type` et la `payload` d'un fait sont
// des VALEURS opaques ici : le schéma ne sait pas ce qu'est une commande.

/// **Un fait durable**, écrit dans la même transaction que le changement qu'il
/// décrit : si elle tombe, il n'existe pas ; si elle passe, il existe pour
/// toujours, sauf purge : un message dont TOUTES les livraisons sont faites
/// depuis plus de 30 jours est éligible (décision de Hugo du 2026-11-06,
/// `documentation/editeur-de-contenu/plan-service-e-mails.md` § 7). La purge
/// est bâtie À BLANC (`OUTBOX_PURGE`, `dry-run` par défaut) : elle compte, elle
/// ne supprime rien tant que Hugo ne l'a pas activée. Un message mort n'est
/// jamais éligible. L'index sur `occurred_at` borne la lecture de la purge.
///
/// L'état de livraison n'est PAS ici : il est par abonné, dans
/// `OutboxDelivery` (§8) — un message a N abonnés, et un seul peut bloquer.
model OutboxMessage {
  /// ULID assigné par l'`IdGenerator`.
  id         String   @id
  /// Clé DÉTERMINISTE du fait (`order.packed:<orderId>`) : un même fait ne
  /// s'écrit qu'une fois, quel que soit le chemin (`ON CONFLICT DO NOTHING`).
  key        String   @unique
  /// Nom stable du fait (`order.handed_over`), quelle que soit la classe.
  type       String
  payload    Json
  /// Lu du `Clock`, jamais de la base.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  traceId    String?  @map("trace_id")

  deliveries OutboxDelivery[]

  @@index([occurredAt])
  @@map("outbox")
  @@schema("platform")
}

/// **La livraison d'un fait à UN abonné** — et son reçu.
///
/// `delivered_at` posé dans la MÊME transaction que l'effet de l'abonné : c'est
/// le reçu qui rend une seconde livraison sans effet. Les essais, le bail et la
/// dernière erreur sont par couple message × abonné : une lettre morte nomme
/// l'abonné qui bloque.
///
/// L'index PARTIEL sur les non livrées (`WHERE delivered_at IS NULL`) est écrit
/// à la main dans la migration `20261004120000_la_boite_d_envoi` : Prisma ne
/// sait pas le dire.
model OutboxDelivery {
  eventId       String        @map("event_id")
  /// Nom stable de l'abonné (`@DurableHandler`).
  subscriber    String
  attempts      Int           @default(0)
  nextAttemptAt DateTime      @map("next_attempt_at") @db.Timestamptz(3)
  /// Bail du relais qui l'a réservée : expiré, la ligne revient.
  claimedUntil  DateTime?     @map("claimed_until") @db.Timestamptz(3)
  deliveredAt   DateTime?     @map("delivered_at") @db.Timestamptz(3)
  lastError     String?       @map("last_error")
  message       OutboxMessage @relation(fields: [eventId], references: [id])

  @@id([eventId, subscriber])
  @@map("outbox_delivery")
  @@schema("platform")
}

/// **Une intention d'un geste du staff** — la clé que l'écran fabrique à
/// l'ouverture d'un dialogue et renvoie à chaque clic (plan
/// `documentation/editeur-de-contenu/plan-service-e-mails.md`, revue, cas 4).
///
/// Une seconde requête de même clé ne réexécute rien : elle relit `result`.
/// L'index unique `(actor_id, key)` arbitre deux clics simultanés, comme
/// `order_idempotency` pour la passation. `gesture` et `subject` sont des
/// VALEURS opaques ici : le schéma ne sait pas ce qu'est une société.
model GestureIntent {
  /// ULID assigné par l'`IdGenerator`.
  id         String    @id
  /// L'identifiant opaque de la fiche du staff qui agit — jamais son adresse.
  actorId    String    @map("actor_id") @db.VarChar(64)
  /// La clé d'intention, un UUID imposé par le contrat de la route.
  key        String    @db.VarChar(64)
  /// Le nom stable du geste (`account.attach-holder`).
  gesture    String    @db.VarChar(80)
  /// Ce que le geste vise (identifiants opaques) : une clé réutilisée sur un
  /// autre sujet est refusée, jamais rejouée.
  subject    String    @db.VarChar(300)
  /// Lu du `Clock`. Une intention non résolue plus vieille que le bail est reprise.
  claimedAt  DateTime  @map("claimed_at") @db.Timestamptz(3)
  /// `null` tant que le geste n'a pas abouti.
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// Ce que le geste a rendu, relu tel quel au rejeu ; sans donnée personnelle.
  result     Json?

  @@unique([actorId, key])
  @@map("gesture_intent")
  @@schema("platform")
}
