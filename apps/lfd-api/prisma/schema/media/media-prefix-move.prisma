/// La **correspondance permanente** des clés déplacées par le préfixe
/// universel (2026-10-13, plan `documentation/mediatheque/plan-prefixe-universel.md`,
/// lot D1) : une ligne par image passée de `products/` à `images/`.
///
/// 🔴 Elle n'est lue par AUCUN code de l'API, et c'est voulu : elle sert au
/// retour arrière (la migration inverse du runbook ne lit qu'elle — S4 de la
/// contradiction) et au retrait de l'ancien préfixe (D2, qui ne supprime que
/// les clés qu'elle liste). Jamais vidée, jamais réécrite : une ligne dit qu'un
/// objet a existé sous l'ancien nom, et c'est cette mémoire-là qu'on garde.
///
/// Les URL sont complètes, origine comprise — c'est ce que les porteurs citent.
model MediaPrefixMove {
  oldUrl        String   @id @map("old_url")
  newUrl        String   @unique @map("new_url")
  oldStorageKey String   @map("old_storage_key")
  newStorageKey String   @map("new_storage_key")
  movedAt       DateTime @default(now()) @map("moved_at") @db.Timestamptz(3)

  @@map("media_prefix_move")
  @@schema("media")
}
