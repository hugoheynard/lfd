// Schéma de la db B2B COMMERCE (la « B2B platform »).
// Contexte : clients pros (customers) qui commandent à La Folie Coffee.
// Doc d'archi : documentation/architecture-identite-auth-tenancy.md
//              documentation/architecture-flux-commande-prod.md
//
// Conventions (alignées sur le PIM) :
// - `User` ICI = une PERSONNE côté client (customer), avec son profil : nom,
//   prénom, e-mail, téléphone. Le staff/back-office vit dans une db SÉPARÉE
//   (bounded context distinct) ; pas de table staff ici.
// - Une personne et une société sont deux choses : le rattachement passe par
//   `memberships` (0..N sociétés par personne, cf. le modèle Membership).
// - Tenancy : chaque table possédée par un client porte `company_id` (le « mur »).
//   On filtre TOUJOURS par ce company_id ; il ne se déduit PLUS du jeton, il est
//   choisi par la requête et vérifié contre les memberships du demandeur.
//   Le staff (autre db) n'est pas muré.
// - Auth : aucune credential stockée. Auth0 possède l'auth ; on ne garde que
//   `auth0_sub` (clé stable) + `email` (clé humaine / secours migration).
// - Pas de DELETE physique : archivage par drapeau (`archived_at`) ou statut.
// - `created_at` / `updated_at` = colonnes SYSTÈME, hors-domaine.
// - Argent : entiers en CENTIMES (`*_cents`), jamais de float. Devise = EUR.
//
// ⚠️ Décisions à confirmer :
// - IDs : `@default(cuid())` ici pour démarrer vite. Le PIM assigne les IDs par la
//   commande (préfixés, sans default). À aligner si tu veux la parité monorepo.
// - `runtime = "nodejs"` : à passer en driver-adapter si le back devient Workers (Hono).

generator client {
  provider            = "prisma-client"
  output              = "../src/platform/database/client"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

// Prisma 7 : plus d'`url` ici. La connexion (db distincte du PIM/admin) est
// fournie par `prisma.config.ts` (Migrate) + l'adapter au constructeur de
// PrismaClient (runtime), comme le PIM.
datasource db {
  provider = "postgresql"
  schemas  = ["public", "growth", "ops", "pim"]
}

// ─────────────────────────────────────────────────────────────────────────────
// Énumérations
// ─────────────────────────────────────────────────────────────────────────────

/// Les crédits qu'on ACCORDE : régler plus tard, et sous quel délai.
///
/// Payer à la commande n'y figure pas — ce n'est pas un terme, c'est l'absence
/// de crédit, et c'est offert à tout le monde. Les mettre dans la même
/// énumération faisait du déblocage un remplacement.
enum DeferredTerm {
  monthly

  @@schema("public")
}

/// Cycle de vie d'un compte client (établissement).
///
/// `pending` = société déclarée par le client depuis « Mes entreprises », pas
/// encore validée commercialement (défaut à la création). L'activation reste
/// **manuelle côté commercial** — décision verrouillée dans
/// `documentation/architecture-onboarding-provisioning-b2b.md`.
///
/// `suspended` ≠ `terminated` : `suspended` coupe l'accès **temporairement**
/// (impayé, litige) et se lève ; `terminated` acte la **fin de la relation
/// commerciale** — définitif du point de vue métier, l'historique est conservé.
/// Ce qui a coupé l'accès — cf. `Company.suspensionCause`.
enum SuspensionCause {
  /// Décision humaine (impayé, litige) : seul un humain la lève.
  staff
  /// Conséquence du retrait de la vérification du KBIS : se lève à la re-vérification.
  kbis_revoked

  @@schema("public")
}

enum CompanyStatus {
  pending
  active
  suspended
  terminated

  @@schema("public")
}

/// Rôle d'une personne AU SEIN d'une société donnée — porté par le `Membership`,
/// donc variable d'une société à l'autre pour la même personne.
/// `company_admin` = gère les users/commandes de cette société (le
/// « gestionnaire », rôle du créateur) ; `member` = passe des commandes.
/// Ce qu'une personne peut faire **dans cette société-là**.
///
/// `owner` n'est pas attribué, il est CONSTATÉ : c'est le détenteur, celui dont
/// l'adresse a servi à ouvrir le compte. Le proposer dans un menu laisserait
/// croire qu'on peut en avoir deux, ou zéro.
enum CustomerRole {
  owner
  admin
  orders
  billing

  @@schema("public")
}

/// Cycle de vie d'une identité customer (provisioning → actif).
enum UserStatus {
  invited
  active
  disabled

  @@schema("public")
}

/// À quoi sert une adresse.
///
/// Deux valeurs, en anglais comme le reste du code. Elles ont été
/// `facturation`/`livraison` jusqu'au 2026-08-25 : la bascule s'est faite en
/// trois déploiements — étendre, basculer, resserrer — parce qu'une valeur
/// d'enum est une DONNÉE écrite en base, pas un nom
/// (`documentation/langue-du-code.md` §4 quater).
enum AddressKind {
  billing
  delivery

  @@schema("public")
}

/// Mode d'**acheminement** d'une commande. `delivery` = livraison à une adresse ;
/// `pickup` = retrait au point de retrait (labo), fallback tant que la livraison
/// n'existe pas. Cf. `documentation/architecture-activation-configuration-b2b.md`.
enum FulfillmentMethod {
  delivery
  pickup

  @@schema("public")
}

/// Mode d'un **ajustement de panier** (remise d'un point de retrait, frais d'une
/// zone de livraison) : `percent` → la valeur est en points de base (2000 = 20 %) ;
/// `amount` → la valeur est en centimes (2000 = 20 €).
enum CartAdjustmentMode {
  percent
  amount

  @@schema("public")
}

/// Cycle de vie d'une commande.
enum OrderStatus {
  draft
  placed
  confirmed
  in_production
  fulfilled
  cancelled

  @@schema("public")
}

/// État du **règlement** d'une commande. Découplé de `OrderStatus` (l'avancement
/// de production) : une commande peut être `placed` et déjà `paid`, ou `placed`
/// et `not_required` (facturée sur terme). Décidé par le `paymentTerm` de la
/// société : `per_order` → `pending` puis `paid` (carte Stripe) ; les termes
/// différés (`monthly`) → `not_required` (encaissée hors ligne).
enum PaymentStatus {
  not_required
  pending
  paid
  failed
  refunded

  @@schema("public")
}

/// **Rôle** d'un utilisateur staff — un paquet nommé de permissions. Le contenu
/// de chaque paquet vit dans le code (`@lfd/contracts`, `ROLE_GRANTS`), pas ici :
/// la base ne stocke que l'affectation.
enum StaffRole {
  admin
  commercial
  comptabilite
  support
  dev

  @@schema("public")
}

/// Où en est une personne vis-à-vis de sa **connexion**. La fiche précède le
/// compte ; l'entrée se constate (`active`), le départ se ferme (`suspended`)
/// sans rien détruire.
enum StaffStatus {
  pending
  invited
  active
  suspended

  @@schema("public")
}

/// Les domaines du back-office sur lesquels une permission porte. Miroir de
/// `StaffResource` (`@lfd/contracts`).
enum StaffResource {
  companies
  orders
  catalog
  tax
  growth
  appointments
  support
  settings
  staff
  activity
  tech
  ops

  @@schema("public")
}

/// Deux niveaux, jamais trois. `write` implique `read`.
enum StaffAction {
  read
  write

  @@schema("public")
}

/// Ce qu'une dérogation fait à une permission. L'absence de ligne vaut
/// « hérite » : on ne stocke que l'écart au rôle.
enum StaffOverrideEffect {
  allow
  deny

  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Company — le TENANT (établissement client pro)
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id String @id @default(cuid())

  // Référence humaine courte (`C-XXXXXX`), lisible et dictable au téléphone —
  // pour que le client donne sa référence en cas de panne de service. Générée à
  // la création, jamais l'`id` technique (cuid, imprononçable).
  reference String @unique

  // Identité légale (cf. Etablissement, front)
  raisonSociale  String @map("raison_sociale")
  enseigne       String @default("") // nom commercial si différent
  formeJuridique String @map("forme_juridique") // SAS, SARL, EI…
  siret          String
  vatNumber      String @default("") @map("tva_intracom")

  // Code NAF (activité principale) résolu depuis le SIRET via l'API entreprises —
  // vide tant qu'inconnu. Dimension d'analyse commerciale (segmenter l'acquisition
  // par secteur) : cf. documentation/commercial-data-analytics.md.
  nafCode String @default("") @map("naf_code")

  // Contact PRINCIPAL de l'entreprise (value object aplati). Semé du profil du
  // créateur ; c'est la carte « Admin du compte entreprise ». Contact unique et
  // obligatoire — les autres interlocuteurs sont des `CompanyContact` (0..N).
  contactPrenom    String @map("contact_prenom")
  contactNom       String @map("contact_nom")
  contactFonction  String @default("") @map("contact_fonction")
  contactEmail     String @map("contact_email")
  contactTelephone String @default("") @map("contact_telephone")

  // Facturation (un seul champ pour l'instant → sur Company ; extraire un
  // BillingProfile le jour où ça grossit : plafond crédit, email de facturation…).
  //
  // `grantedTerms` = les crédits ACCORDÉS, cumulatifs et possiblement vides.
  // Vide = la société paie à la commande, ce que tout le monde peut faire de
  // toute façon. Écrit **uniquement par le staff** : le client ne s'accorde pas
  // un délai de règlement. Sa demande atterrit dans `requestedTerm` (`null` =
  // aucune), pour ne pas confondre « souhaité » et « accordé ».
  grantedTerms  DeferredTerm[] @map("granted_terms")
  requestedTerm DeferredTerm?  @map("requested_term")

  // Défaut `pending` : une société n'est jamais cliente parce qu'elle a été
  // saisie — elle le devient par une activation commerciale explicite.
  status CompanyStatus @default(pending)

  // POURQUOI le compte est suspendu. Ce n'est pas de la décoration : la reprise
  // automatique en dépend. Une suspension déclenchée par le retrait de la
  // vérification du KBIS se lève d'elle-même quand un extrait est vérifié à
  // nouveau — c'est la même règle lue à l'endroit. Une suspension décidée par le
  // staff (impayé, litige) ne se lève JAMAIS toute seule : sans cette colonne,
  // certifier un KBIS rouvrirait le robinet d'un client en recouvrement.
  // `null` hors suspension.
  suspensionCause SuspensionCause? @map("suspension_cause")

  // KBIS — l'extrait déposé par le client, demandé pour la validation. Le fichier
  // vit dans le stockage objet (R2) ; on ne garde ici que ses métadonnées et sa
  // CLÉ de stockage. Tous null = aucun KBIS déposé. La **certification** est
  // propre au fichier : `kbisCertifiedAt` est posé par le staff quand l'extrait
  // est validé, et **remis à null à chaque (re)dépôt** — remplacer le KBIS
  // invalide la certification précédente. Découplé de `status` : un fichier
  // remplacé sur une société active ne reste pas « certifié » à tort.
  kbisStorageKey  String?   @map("kbis_storage_key")
  kbisFileName    String?   @map("kbis_file_name")
  kbisContentType String?   @map("kbis_content_type")
  kbisSize        Int?      @map("kbis_size")
  kbisUploadedAt  DateTime? @map("kbis_uploaded_at")
  kbisCertifiedAt DateTime? @map("kbis_certified_at")

  // QUI a certifié. Le `sub` du token staff est l'identifiant qui reste
  // résolvable après un changement de nom ; le nom et le périmètre sont un
  // INSTANTANÉ de ce qui était vrai ce jour-là. C'est l'objet même d'une trace
  // d'audit : « qui a engagé sa parole, à quel titre, à cette date » — pas « qui
  // porte ce rôle aujourd'hui ». Nuls quand le sub n'est rattaché à aucune fiche
  // de l'annuaire staff (compte non provisionné) : on n'invente pas un nom.
  kbisCertifiedBySub  String? @map("kbis_certified_by_sub")
  kbisCertifiedByName String? @map("kbis_certified_by_name")
  kbisCertifiedByRole String? @map("kbis_certified_by_role")

  // Préférence d'ACHEMINEMENT : comment ce client est servi d'habitude. Ce n'est
  // pas une contrainte — la commande s'ouvre dessus, le client peut en changer
  // au panier. `null` = aucune préférence posée, ce qui n'est PAS « retrait » :
  // c'est l'état de tout le portefeuille existant, et il doit rester lisible.
  //
  // Les deux pointeurs sont facultatifs même quand la méthode est posée : `null`
  // renvoie au DÉFAUT du moment (celui de la plateforme pour le retrait, celui
  // de la société pour la livraison). Pointer explicitement sur l'adresse par
  // défaut la figerait — le jour où elle change, la préférence désignerait
  // encore l'ancienne. Les deux FK sont en `SetNull` : supprimer un point de
  // retrait ou archiver une adresse fait retomber la préférence sur le défaut,
  // jamais sur un pointeur mort.
  preferredFulfillmentMethod FulfillmentMethod? @map("preferred_fulfillment_method")

  preferredPickupAddressId String?        @map("preferred_pickup_address_id")
  preferredPickupAddress   PickupAddress? @relation(fields: [preferredPickupAddressId], references: [id], onDelete: SetNull)

  preferredDeliveryAddressId String?  @map("preferred_delivery_address_id")
  preferredDeliveryAddress   Address? @relation("PreferredDelivery", fields: [preferredDeliveryAddressId], references: [id], onDelete: SetNull)

  // Posé au passage `pending → active` par l'activation commerciale explicite
  // (ancre d'ancienneté commerciale, distincte de `createdAt`). `null` = jamais activé.
  activatedAt DateTime? @map("activated_at")

  // QUI a activé, à quel titre — même patron que la certification du KBIS, et
  // pour la même raison : ouvrir la commande à un client est un ENGAGEMENT, pas
  // un changement de colonne. Le `sub` survit aux changements de nom ; le nom et
  // le périmètre sont un instantané de ce qui était vrai ce jour-là. Nuls pour
  // les comptes activés avant cette trace, et pour un sub hors annuaire staff.
  activatedBySub  String? @map("activated_by_sub")
  activatedByName String? @map("activated_by_name")
  activatedByRole String? @map("activated_by_role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  contacts        CompanyContact[]
  addresses       Address[]
  orders          Order[]
  orderDraft      OrderDraft?
  supportRequests SupportRequest[]
  mandates        PaymentMandate[]

  /// Dérogations de ce compte aux règles d'alerte globales (cf. alerts/).
  alertOverrides AccountAlertOverride[]

  /// Alertes déclenchées sur ce compte (cf. alerts/).
  alerts AccountAlert[]

  // Unicité du SIRET : index PARTIEL (`siret <> ''`), donc invisible du schéma
  // Prisma — il vit dans la migration `20260811160000_unicite_siret_et_interlocuteur`.
  // Le SIRET est facultatif à l'ouverture ; les chaînes vides sont des absences,
  // pas des doublons.
  @@index([siret])
  @@map("companies")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// User — la PERSONNE qui possède le compte (son profil), sans société propre
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id String @id @default(cuid())

  // Identité Auth0 (aucun mot de passe stocké ici). `email` est la clé humaine ;
  // Auth0 en reste propriétaire, on le synchronise (cf. CustomerIdentityPort).
  auth0Sub String @unique @map("auth0_sub")
  email    String

  // Profil de la personne — DISTINCT du contact de la société. Chaîne vide et
  // non `null` pour l'absence, comme partout ailleurs dans ce schéma.
  firstName String @default("") @map("first_name")
  lastName  String @default("") @map("last_name")
  phone     String @default("")

  status UserStatus @default(invited)

  // L'adresse a-t-elle été PROUVÉE ? Fait qui vit chez le fournisseur d'identité
  // (Auth0) : on le recopie ici plutôt que de l'interroger à chaque affichage —
  // une fiche client ne doit pas dépendre d'un aller-retour réseau externe.
  // Rafraîchi à la connexion et quand on émet un lien de mot de passe.
  emailVerified Boolean @default(false) @map("email_verified")

  // Préférences de navigation/affichage de la personne (bag JSON, extensible).
  // Aujourd'hui : `catalogueView` (grille/rayons/liste). Absent = pas de choix
  // explicite → le front applique son défaut. Sac plutôt qu'une colonne par
  // préf : ces réglages purement UI n'ont pas d'invariant et grossiront.
  navPrefs Json? @map("nav_prefs")

  // Traçabilité : id du STAFF (autre db) qui a provisionné ce client.
  // Pas de FK cross-db → simple identifiant.
  invitedBy String? @map("invited_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     Membership[]
  ordersPlaced    Order[]
  subscriptions   Subscription[]
  supportRequests SupportRequest[]

  @@map("users")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// SupportRequest — une demande de rappel/contact à l'activation
// ─────────────────────────────────────────────────────────────────────────────

/// Canal de contact souhaité (aligné sur `SupportChannel`, front).
enum SupportChannel {
  phone
  email

  @@schema("public")
}

/// Demi-journée d'un créneau de rappel.
enum SupportSlot {
  morning
  afternoon

  @@schema("public")
}

/// Une demande de support à l'activation : le client veut être contacté par
/// l'équipe commerciale. Wallée par `company_id`. Lue par le commercial (la
/// notification e-mail viendra avec l'infra mailer) ; `handled_at` marque le
/// traitement.
model SupportRequest {
  id String @id @default(cuid())

  /// Société concernée, ou NULL : un prospect sans entreprise déclarée doit
  /// pouvoir demander un rappel — la demande porte alors sur la personne.
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  requestedByUserId String @map("requested_by_user_id")
  requestedBy       User   @relation(fields: [requestedByUserId], references: [id])

  channel     SupportChannel
  /// Motif — même vocabulaire que les rendez-vous ; objet du mail si `channel = email`.
  purpose     String         @default("other")
  phoneNumber String         @default("") @map("phone_number")
  asap        Boolean        @default(true)

  // Créneau daté si `asap = false`.
  scheduledDate DateTime?    @map("scheduled_date") @db.Date
  slot          SupportSlot?

  message String @default("")

  handledAt DateTime? @map("handled_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@index([requestedByUserId])
  @@map("support_requests")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Membership — le RATTACHEMENT d'une personne à une société cliente
// ─────────────────────────────────────────────────────────────────────────────

/// Une personne peut n'appartenir à aucune société (elle vient de créer son
/// compte : « Mes entreprises » est vide et propose d'en créer une), à une, ou à
/// plusieurs. C'est pourquoi le rattachement est une table à part et non une
/// colonne `company_id` sur `users` : cette colonne imposait exactement une
/// société, et rendait l'état « aucune » impossible à représenter.
///
/// Le `role` vit ICI, pas sur `users` : on peut être gestionnaire d'une société
/// et simple membre d'une autre.
///
/// ⚠️ Tenancy : le mur reste `company_id`, mais la société d'une requête ne se
/// déduit plus de l'utilisateur — elle doit être **choisie explicitement** et
/// vérifiée contre les memberships du demandeur. Aucun endpoint métier n'est
/// encore muré ; le premier (commandes, adresses) devra porter ce choix.
model Membership {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  role CustomerRole

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Une personne n'est rattachée qu'une fois à une société donnée.
  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// CompanyContact — un interlocuteur ADDITIONNEL de l'entreprise
// ─────────────────────────────────────────────────────────────────────────────

/// Les contacts en plus du contact principal (qui, lui, vit aplati sur `Company`
/// et n'est jamais supprimable). Carnet d'adresses de l'entreprise : ce sont des
/// personnes à joindre, PAS des utilisateurs du logiciel — aucun `auth0_sub`,
/// aucun accès. Inviter un collègue à se connecter est un autre flux (membership).
///
/// Wallé par `company_id` comme tout ce qui appartient à un client.
/// État d'un **mandat de prélèvement SEPA**. `active` seul autorise un
/// prélèvement ; `revoked` est notre geste (retrait du client, ou remplacement),
/// `failed` vient de la banque. Un mandat ne s'efface jamais, il se date.
enum MandateStatus {
  pending
  active
  revoked
  failed

  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// PaymentMandate — l'autorisation de prélever, PAS les coordonnées bancaires
// ─────────────────────────────────────────────────────────────────────────────

/// Un **mandat de prélèvement SEPA** rattaché à une société.
///
/// Agrégat à part, et non des colonnes sur `Company` : un mandat a un cycle de
/// vie propre (accepté, révoqué, remplacé) et on veut en garder l'historique —
/// pouvoir répondre, deux ans plus tard, « sur quelle autorisation avez-vous
/// prélevé le 12 mars ? ». Un mandat révoqué reste donc en base, daté.
///
/// **Aucune coordonnée bancaire ici.** L'IBAN est saisi dans l'iframe Stripe et
/// ne traverse jamais ce backend : on ne garde que des identifiants Stripe, la
/// référence opposable (RUM) et de quoi *reconnaître* le compte (4 derniers
/// chiffres, code banque). Ce qu'on achète à Stripe, c'est précisément de ne pas
/// détenir la donnée bancaire.
model PaymentMandate {
  id String @id @default(cuid())

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Rattachement Stripe. Le `customerId` est réutilisé d'un mandat au suivant
  // pour la même société : un client Stripe par société, pas par autorisation.
  stripeCustomerId String @map("stripe_customer_id")
  paymentMethodId  String @map("payment_method_id")

  // Référence opposable du mandat (RUM), rendue par Stripe. C'est elle qu'on
  // dicte en contestation — pas l'id technique.
  reference String

  // De quoi reconnaître le compte à l'écran, et rien de plus : ces trois champs
  // ne suffisent à débiter personne.
  last4    String @default("")
  bankCode String @default("") @map("bank_code")
  country  String @default("")

  status MandateStatus @default(pending)

  // Date du consentement **déclaré** — celle du mandat papier déjà signé, donc
  // souvent bien antérieure à la saisie (reprise de portefeuille).
  acceptedAt DateTime  @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")

  // Le **mandat signé scanné** : la seule pièce qui prouve le consentement (le
  // RIB ne prouve rien). Rangé dans le stockage objet comme le KBIS ; ici, sa
  // clé et son nom. `null` = mandat sans filet, et la fiche doit le dire.
  proofStorageKey String? @map("proof_storage_key")
  proofFileName   String? @map("proof_file_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Un seul mandat ACTIF par société : index PARTIEL (`status = 'active'`), donc
  // invisible du schéma Prisma — il vit dans la migration
  // `20260811200000_mandat_prelevement`. Les mandats révoqués s'empilent sans
  // se gêner ; c'est tout l'intérêt de garder l'historique.
  @@index([companyId, status])
  @@map("payment_mandates")
  @@schema("public")
}

model CompanyContact {
  id String @id @default(cuid())

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  prenom    String
  nom       String
  fonction  String @default("")
  email     String
  telephone String @default("")

  // Ce que cette personne fait pour la société. NULL sur les contacts créés
  // avant que le rôle existe : « à préciser » à l'écran. Le deviner (« sûrement
  // commandes ») propagerait une valeur inventée qu'on ne saurait plus
  // distinguer d'une vraie.
  role CustomerRole?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Une adresse = un interlocuteur par société. Index unique sur
  // (company_id, lower(email)), posé en SQL dans la même migration : Prisma ne
  // sait pas exprimer d'index sur expression.
  @@index([companyId])
  @@map("company_contacts")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Address — 1 facturation + N livraison, 1 livraison par défaut
// ─────────────────────────────────────────────────────────────────────────────

model Address {
  id String @id @default(cuid())

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  /// Sociétés qui ont fait de cette adresse leur livraison préférée.
  preferredBy Company[] @relation("PreferredDelivery")

  kind  AddressKind
  label String // « Siège », « Boutique Bastille »…

  ligne1     String
  ligne2     String @default("")
  codePostal String @map("code_postal")
  ville      String
  pays       String

  // Adresse de livraison par défaut. Invariant (appliqué en applicatif) :
  // au plus une `livraison` à `true` par company ; exactement une `facturation`.
  isDefault Boolean @default(false) @map("is_default")

  // Consignes de LIVRAISON (note livreurs, créneaux préférés, contact sur place,
  // point GPS) — la forme est le `DeliverySpecs` de `@lfd/contracts`, stockée en
  // JSON car on ne requête jamais par créneau. `null` sur une facturation, et sur
  // une livraison tant qu'aucune consigne n'a été saisie.
  deliverySpecs Json? @map("delivery_specs")

  // Pas de DELETE physique : on archive.
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveredOrders Order[] @relation("OrderDeliveryAddress")

  @@index([companyId, kind])
  @@map("addresses")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Order — une commande, tenant-scoped
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique @map("order_number") // référence humaine

  // Tenancy. `companyId` est OPTIONNEL : une commande « zéro friction » n'appartient
  // qu'au client connecté (`placedByUserId` = LE mur sans entreprise). Elle se
  // rattache à une société plus tard (rapatriement — cf. doc flux commande).
  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])

  // AU NOM DE QUI la commande est passée — toujours un client. Quand l'équipe
  // la saisit au téléphone, c'est le contact du compte qui est porté ici : la
  // commande reste celle du client, et elle apparaît dans « Mes commandes ».
  placedByUserId String @map("placed_by_user_id")
  placedBy       User   @relation(fields: [placedByUserId], references: [id])

  // QUI L'A SAISIE chez LFC, quand ce n'est pas le client lui-même. Nul = le
  // client a commandé seul.
  //
  // Un `StaffUser.id`, mais **pas** une clé étrangère : une commande est une
  // pièce comptable, elle ne doit ni disparaître ni bloquer le jour où on retire
  // du personnel de l'annuaire. Et un identifiant plutôt qu'un instantané du
  // nom — un annuaire corrigé doit corriger l'affichage, pas laisser un ancien
  // nom figé sur la commande (le raisonnement inverse de `handedOverBy`, qui
  // fige le `sub` parce que c'est une ATTESTATION, pas un affichage).
  //
  // Ce n'est pas une nature de commande, c'est une porte d'entrée : avec
  // `fromSubscriptionId`, ces deux colonnes produisent l'`origin` des vues de
  // lecture (self_service | back_office | recurring). Un `kind` discriminé
  // aurait dupliqué la même information dans une troisième forme.
  placedByStaffId String? @map("placed_by_staff_id")

  status OrderStatus @default(placed)

  // Alimente le plan de prod (« à produire pour demain »).
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date

  // Acheminement. `delivery` = **coursier** : `deliveryZoneId` (zone tarifée) +
  // `deliveryAddressSnapshot` (adresse libre FIGÉE, comme les prix). `pickup` =
  // **retrait** : `pickupAddress` (snapshot des champs postaux du labo). La relation
  // `deliveryAddress` (adresse d'entreprise) reste pour l'héritage / le rapatriement.
  fulfillmentMethod FulfillmentMethod @default(delivery) @map("fulfillment_method")

  deliveryZoneId String? @map("delivery_zone_id")

  deliveryAddressId String?  @map("delivery_address_id")
  deliveryAddress   Address? @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id])

  // Adresse de livraison LIBRE figée (coursier sans carnet d'entreprise).
  deliveryAddressSnapshot Json? @map("delivery_address_snapshot")

  pickupAddress Json? @map("pickup_address")

  // L'acheminement CONVENU, figé à la commande, chaque valeur avec sa provenance
  // (défaut du réglage / override) — forme = `OrderFulfillment` de
  // `@lfd/contracts`. Figé comme les prix : le contact d'une adresse, ses heures
  // ou son exigence de signature peuvent changer demain, et un bon déjà imprimé
  // ne doit pas se mettre à dire autre chose que le papier parti en tournée.
  // Ce qui bouge après la commande passe par un AVENANT.
  fulfillment Json?

  // Argent en centimes (snapshot au moment de la commande). Prix marchandises
  // **HT** ; `total` est le **TTC** encaissé = `max(0, subtotal − discount) +
  // deliveryFee + vat`. Remise = point de retrait ; frais = zone ; TVA par taux
  // (5,5 % alimentaire, 20 % livraison).
  subtotalCents      Int    @map("subtotal_cents")
  discountCents      Int    @default(0) @map("discount_cents")
  // L'ajustement (%, ou € fixe) qui a PRODUIT `discountCents`, figé comme les
  // prix : sans lui un document ne peut nommer la remise, seulement la chiffrer.
  discountAdjustment Json?  @map("discount_adjustment")
  deliveryFeeCents   Int    @default(0) @map("delivery_fee_cents")
  vatCents           Int    @default(0) @map("vat_cents")
  totalCents         Int    @map("total_cents")
  currency           String @default("EUR")

  // Règlement. `paymentStatus` est fixé à la passation d'après le terme de la
  // société (cf. enum PaymentStatus). `stripePaymentIntentId` relie la commande
  // à l'intention de paiement Stripe (per_order) — clé de rapprochement du
  // webhook, `@unique` pour l'idempotence. `paidAt` = horodatage d'encaissement.
  paymentStatus         PaymentStatus @default(not_required) @map("payment_status")
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  paidAt                DateTime?     @map("paid_at")

  note String @default("")

  // Origine récurrente : l'abonnement qui a produit cette commande (« récurrent »)
  // et l'écart vs son gabarit pour cette échéance ({ added, removed } — pills +/−).
  // Nuls tant que le planificateur ne génère pas de commandes depuis un abonnement.
  fromSubscriptionId String? @map("from_subscription_id")
  recurringDeltas    Json?   @map("recurring_deltas")

  // Remise en main propre (retrait au labo). `handoverToken` est un secret
  // ALÉATOIRE, pas le numéro de commande : celui-ci est imprimé sur le bon de
  // livraison, donc public, donc sans valeur de preuve. Émis à la passation pour
  // les seules commandes `pickup`. `@unique` = c'est la clé de lecture du scan.
  // Les deux autres colonnes SONT l'attestation : quand, et par qui (le claim
  // `sub` du jeton staff, figé — un annuaire réécrit ne doit pas réécrire une
  // preuve, et le `sub` reste résolvable même après un changement de nom).
  handoverToken String?   @unique @map("handover_token")
  handedOverAt  DateTime? @map("handed_over_at")
  handedOverBy  String?   @map("handed_over_by")

  createdAt DateTime @default(now()) @map("created_at") // = passée le
  updatedAt DateTime @updatedAt @map("updated_at")

  lines OrderLine[]

  @@index([companyId])
  @@index([placedByUserId])
  @@index([placedByStaffId])
  @@index([requestedDeliveryDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([fromSubscriptionId])
  @@map("orders")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// OrderLine — réfère le SKU du PIM (cross-context), snapshot prix/nom/TVA
// ─────────────────────────────────────────────────────────────────────────────

model OrderLine {
  id String @id @default(cuid())

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Référence au catalogue PIM. String, PAS une FK (autre db / bounded context).
  sku String

  // Snapshots au moment de la commande : le prix/nom/TVA du PIM peut changer,
  // la commande garde ce qu'elle a facturé.
  productNameSnapshot String  @map("product_name_snapshot")
  unitPriceCents      Int     @map("unit_price_cents")
  vatRate             Decimal @default(0) @map("vat_rate") @db.Decimal(5, 2) // %, ex. 5.50

  quantity       Int
  lineTotalCents Int @map("line_total_cents")

  /// **La trace de résolution**, figée à la passation — cf.
  /// `documentation/b2b/architecture-resolution-de-prix.md`.
  ///
  /// Elle répond à « pourquoi ce prix ? » six mois plus tard, quand les règles
  /// qui l'ont produit peuvent avoir été retirées. C'est un fait clos, comme le
  /// prix : on ne la recalcule jamais, on la relit.
  ///
  /// `NULL` = commande passée **avant** que la trace n'existe. Ce n'est PAS la
  /// même chose qu'une trace vide : `steps: []` affirme « aucun étage n'a joué »,
  /// `NULL` avoue « on ne sait pas ». Un défaut à `[]` aurait transformé une
  /// ignorance en affirmation, sur les seules commandes qu'on ne peut plus
  /// vérifier.
  basePriceCents Int?     @map("base_price_cents")
  pricingSteps   Json?    @map("pricing_steps")
  /// Quel étage de plancher a mordu, et sur quelles preuves — figé avec le prix.
  /// C'est ce qui rend le plancher DYNAMIQUE tenable : sans la mesure consignée,
  /// un prix qui dépend de l'historique cesse d'être explicable dès que
  /// l'historique bouge. Ne se relit jamais.
  pricingFloor   Json?    @map("pricing_floor")
  /// Le plancher a-t-il relevé ce prix ? Consigné plutôt qu'avalé : un prix
  /// relevé est un prix dont une règle n'a pas produit son effet.
  pricingFloored Boolean? @map("pricing_floored")

  /// L'engagement de volume qui a décidé du palier, et le CUMUL mesuré à cet
  /// instant : `{ id, promisedQuantity, cumulativeQuantity }`.
  ///
  /// Figé pour la même raison que la décision de plancher : un prix qui dépend
  /// de l'historique cesse d'être explicable dès que l'historique bouge. Ne se
  /// relit jamais, ne se recalcule jamais. `NULL` = aucun engagement ne couvrait
  /// cette ligne, le palier s'est joué sur la quantité de la commande.
  pricingCommitment Json? @map("pricing_commitment")

  // Un SKU n'apparaît qu'UNE fois par commande. `place-order` fusionne déjà les
  // quantités du panier ; la contrainte rend la règle structurelle plutôt que
  // conventionnelle. C'est aussi ce qui rend une moyenne par SKU calculable sans
  // question : deux lignes du même produit dans une commande, et « la quantité
  // commandée » n'aurait plus de définition unique.
  @@unique([orderId, sku])
  @@index([orderId])
  @@index([sku]) // agrégation par SKU pour le plan de prod
  @@map("order_lines")
  @@schema("public")
}

// Panier récurrent (abonnement) : un GABARIT de commande qui se répète. Ne
// déclenche pas encore de commande (planificateur différé) ; on capture
// l'intention. Mur = `placed_by_user_id` (comme les commandes perso zéro friction).
// `recurrence`/`status` en String (union validée au bord par zod), dates en Date.
model Subscription {
  id String @id @default(cuid())

  placedByUserId String @map("placed_by_user_id")
  placedBy       User   @relation(fields: [placedByUserId], references: [id])

  // Traçabilité : commande d'origine (celle « transformée en panier récurrent »).
  fromOrderId String? @map("from_order_id")

  recurrence String // weekly | biweekly | monthly
  status     String @default("active") // active | paused

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date // null = sans fin

  // Acheminement figé (comme les commandes) : livraison = adresse libre snapshot ;
  // retrait = id du point (ou null = défaut).
  fulfillmentMethod       FulfillmentMethod @map("fulfillment_method")
  deliveryAddressSnapshot Json?             @map("delivery_address_snapshot")
  pickupAddressId         String?           @map("pickup_address_id")

  note String @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines       SubscriptionLine[]
  occurrences SubscriptionOccurrence[]

  @@index([placedByUserId])
  @@map("subscriptions")
  @@schema("public")
}

model SubscriptionOccurrence {
  id String @id @default(cuid())

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // L'échéance visée (« modifier cette commande uniquement »).
  occurrenceDate DateTime @map("occurrence_date") @db.Date

  // Soit on saute l'échéance, soit on remplace ses lignes pour cette date-là.
  skipped Boolean @default(false)
  lines   Json // [{ sku, quantity }] — remplacement (vide si sautée).
  note    String  @default("")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([subscriptionId, occurrenceDate])
  @@index([subscriptionId])
  @@map("subscription_occurrences")
  @@schema("public")
}

model SubscriptionLine {
  id String @id @default(cuid())

  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  // Référence catalogue PIM (String, pas une FK). Le prix est ré-résolu à l'échéance.
  sku      String
  quantity Int

  @@index([subscriptionId])
  @@map("subscription_lines")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// Points de retrait — adresses GLOBALES de la plateforme
// ─────────────────────────────────────────────────────────────────────────────

/// Un **point de retrait** (laboratoire) — adresse **globale** (pas par entreprise),
/// fallback d'acheminement tant que la livraison n'existe pas. Plusieurs points
/// possibles, un seul `isDefault`. Une commande en retrait fige un snapshot de
/// l'adresse choisie. Cf. `documentation/architecture-activation-configuration-b2b.md`.
model PickupAddress {
  id String @id @default(cuid())

  label      String
  ligne1     String
  ligne2     String @default("")
  codePostal String @map("code_postal")
  ville      String
  pays       String

  // Un seul point par défaut (le préselectionné au checkout). L'invariant « au
  // moins un point » et « un seul défaut » est tenu par le repository.
  isDefault Boolean @default(false) @map("is_default")

  // Remise appliquée au panier en cas de retrait ici. `discountMode` null =
  // aucune remise ; sinon `discountValue` = bp (percent) ou centimes (amount).
  discountMode  CartAdjustmentMode? @map("discount_mode")
  discountValue Int?                @map("discount_value")

  // Quand un pro peut venir : ouverture au public ET créneau réservé aux pros,
  // deux fenêtres NOMMÉES et jamais fusionnées — leur union peut avoir un trou
  // (pros 5h–6h30, public 7h–20h), et l'aplatir inventerait une demi-heure
  // d'ouverture. Forme = `PickupOpening` de `@lfd/contracts`, en JSON car on ne
  // requête jamais par heure.
  opening Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Sociétés qui ont fait de ce point leur retrait préféré (cf. Company).
  preferredBy Company[]

  @@map("pickup_addresses")
  @@schema("public")
}

/// **Heure limite de commande** — une RÈGLE par ligne, jamais une colonne de
/// réglage. Ouvrir un second labo ou décaler le dimanche doit être de la saisie,
/// pas une migration.
///
/// `pickupAddressId` null = règle par défaut de la plateforme ; `weekday` null =
/// tous les jours. La plus spécifique gagne (`resolveOrderCutoff`, côté contrat).
/// La limite se compte en `daysBefore` + `time` depuis la date d'ACHEMINEMENT
/// demandée : « 18 h » seul serait ambigu.
model OrderCutoff {
  id String @id @default(cuid())

  pickupAddressId String? @map("pickup_address_id")

  /// `mon`…`sun` — le même {@link Weekday} que les créneaux de livraison. Deux
  /// représentations du jour dans un seul contrat finiraient décalées d'une unité.
  /// Null = tous les jours.
  weekday String?

  daysBefore Int    @default(1) @map("days_before")
  /// `HH:MM` en heure LOCALE du laboratoire, pas un instant UTC.
  time       String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Une seule règle par couple (point, jour) : deux règles concurrentes rendraient
  // la résolution dépendante de l'ordre de lecture. Postgres traite chaque NULL
  // comme distinct, d'où les index partiels ci-dessous pour couvrir les défauts.
  @@unique([pickupAddressId, weekday])
  @@index([pickupAddressId])
  @@map("order_cutoffs")
  @@schema("public")
}

/// **Zone de livraison** — un secteur de codes postaux (stations éloignées)
/// portant un frais de livraison HT ajouté au panier quand la commande est livrée
/// vers ce secteur. `postalPrefixes` = préfixes couverts (`73150` exact, `731` =
/// secteur) ; le plus long gagne. Config globale. `feeValue` = bp (percent) ou
/// centimes (amount) selon `feeMode`.
model DeliveryZone {
  id             String   @id @default(cuid())
  postalPrefixes String[] @map("postal_prefixes")
  label          String   @default("")

  feeMode  CartAdjustmentMode @map("fee_mode")
  feeValue Int                @map("fee_value")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("delivery_zones")
  @@schema("public")
}

/// Utilisateur **staff** (back-office) — l'annuaire des personnes qui opèrent la
/// suite : identité, **rôle**, et l'état de sa connexion. Source de vérité
/// **locale** : on ne dépend pas d'Auth0 pour administrer sa propre suite.
///
/// Modèle et invariants : `documentation/b2b/architecture-acces-staff.md`.
model StaffUser {
  id String @id @default(cuid())

  firstName String @map("first_name")
  lastName  String @map("last_name")
  email     String @unique

  /// Facultatifs — un annuaire à moitié rempli reste un annuaire utile.
  phone    String @default("")
  jobTitle String @default("") @map("job_title")

  /// Le rôle : le paquet de permissions dont cette personne hérite.
  role StaffRole @default(commercial)

  /// L'état de la connexion. La fiche précède le compte, donc `pending` par
  /// défaut : créer quelqu'un ne lui ouvre aucune porte.
  status StaffStatus @default(pending)

  /// Identité Auth0, liée à la **première connexion** (l'entrée se constate).
  /// Nulle tant que la personne n'est jamais entrée.
  auth0Id String? @unique @map("auth0_id")

  /// Quand le **dernier** lien d'invitation a été émis. Ré-inviter l'écrase :
  /// un ticket est à usage unique, émettre le suivant tue le précédent, donc
  /// seule la dernière date décrit un accès encore réclamable. Nulle tant que
  /// personne n'a invité.
  invitedAt DateTime? @map("invited_at")

  /// Les écarts au rôle, pour cette personne.
  overrides StaffPermissionOverride[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("staff_users")
  @@schema("public")
}

/// Un **écart au rôle**, pour une personne, sur une permission. Une ligne = un
/// écart ; l'absence de ligne vaut « hérite du rôle ».
///
/// `grantedAt`/`grantedBy` rendent l'écart **imputable** : la question « qui a
/// ouvert la compta à Marc, et quand » doit rester répondable dans six mois. Un
/// tableau de scopes sur la personne ne savait rien en dire — c'est la raison
/// première de cette table.
model StaffPermissionOverride {
  id String @id @default(cuid())

  staffUserId String    @map("staff_user_id")
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  resource StaffResource
  action   StaffAction
  effect   StaffOverrideEffect

  /// Le `sub` du staff qui a posé l'écart — un identifiant, pas un nom : il
  /// reste résolvable après un changement de nom ou de rôle.
  grantedBy String   @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  /// Un seul écart par permission : deux lignes contradictoires sur le même
  /// couple seraient une question sans réponse.
  @@unique([staffUserId, resource, action])
  @@map("staff_permission_overrides")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// ActivityEvent — le JOURNAL d'événements (schéma `growth`, isolé)
// ─────────────────────────────────────────────────────────────────────────────

/// Journal **append-only** du module croissance : une ligne = un fait métier
/// observé (`order.placed`, `company.declared`…). C'est de l'**event streaming**
/// (projection analytique/audit), **PAS de l'event sourcing** : la vérité métier
/// reste transactionnelle (schéma `public`), on ne reconstruit JAMAIS l'état
/// depuis ce journal. Ce n'est **pas un agrégat** — de l'infrastructure, un seul
/// invariant : l'immuabilité (jamais d'UPDATE/DELETE).
///
/// Volontairement dans son **propre schéma Postgres `growth`** dès maintenant :
/// le déménagement vers un store dédié (trip-wire (b) du design) est ainsi
/// trivial, et `growth/` ne touche jamais les tables de `public` — il ne consomme
/// que ce contrat d'événements. Partitionnement mensuel + rétention = affaire
/// d'une migration SQL brute ultérieure (non exprimable en Prisma déclaratif).
model ActivityEvent {
  /// ULID (fourni par l'`IdGenerator`, pas de `@default`) : triable par le temps
  /// → pagination stable sur un flux append-only.
  id String @id

  /// Type de l'événement, ex. `order.placed`. Le `payload` en dépend.
  type String

  /// Le `payload` évolue → on le versionne pour lire les vieilles lignes.
  schemaVersion Int @default(1) @map("schema_version")

  /// Temps de l'ÉVÉNEMENT (métier, autorité = `Clock` backend).
  occurredAt DateTime @map("occurred_at")

  /// Temps d'INGESTION (écriture au journal) — ≠ `occurredAt` si tardif/rejoué.
  recordedAt DateTime @default(now()) @map("recorded_at")

  /// Sujet de l'événement : `user` | `company` | `lead`.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  /// Établissement rattaché — posé maintenant (nullable), rempli plus tard par
  /// l'identity resolution (Phase 3). Indexé dès aujourd'hui.
  establishmentId String? @map("establishment_id")

  /// Nature de l'acteur : `customer` | `staff` | `system` (lu du RequestContext).
  actorType String @map("actor_type")

  /// QUI, précisément. `actor_id` est le `sub` staff ou l'id client (nul pour
  /// `system`) ; `actor_name` est un INSTANTANÉ du nom au moment de l'acte —
  /// figé, comme toute trace, parce qu'un journal doit dire ce qui était vrai ce
  /// jour-là. Nuls pour les événements antérieurs à cette trace, et quand
  /// l'annuaire ne connaît pas l'acteur : le journal affiche alors sa nature
  /// (« un membre du staff »), et n'invente pas un nom.
  actorId   String? @map("actor_id")
  actorName String? @map("actor_name")
  /// La FONCTION de l'acteur, en clair (« Commercial »), figée avec son nom et
  /// pour la même raison. Elle ne coûte aucune lecture de plus : c'est une
  /// colonne de la fiche qu'on lisait déjà pour le nom.
  actorRole String? @map("actor_role")

  /// Corrélation bout-en-bout (le `traceId` W3C de la requête).
  traceId String @map("trace_id")

  /// Anti double-comptage : une émission rejouée porte la même clé → refusée.
  idempotencyKey String @unique @map("idempotency_key")

  /// Charge utile typée par `type` (montants en CENTIMES entiers, jamais de float).
  payload Json

  @@index([subjectType, subjectId, occurredAt])
  @@index([type, occurredAt])
  @@index([establishmentId, occurredAt])
  @@map("activity_events")
  @@schema("growth")
}

// ─────────────────────────────────────────────────────────────────────────────
// LeadScore — le READ-MODEL matérialisé du cockpit (schéma `growth`)
// ─────────────────────────────────────────────────────────────────────────────

/// Read-model **matérialisé** de la queue « 5 meilleurs coups du jour » : un lead
/// scoré (0..100) et typé par play. **Dérivé du journal** par un `derive*` pur,
/// **recalculé par cron 3×/jour** (04h/12h/20h, heures creuses) via
/// `POST /admin/recompute` — **jamais** temps réel, **jamais** on-read (rejouer
/// tout le journal à chaque affichage = fondu). Le cockpit **lit ce read-model**,
/// jamais le journal brut.
///
/// Ce n'est **pas un agrégat** (zéro invariant réfutable) : une **projection**
/// intégralement remplacée à chaque recompute (`replaceAll` = wipe + insert). La
/// clé métier est le couple (sujet-type, sujet-id) → une seule ligne par lead.
model LeadScore {
  /// Sujet du lead : `user` (personne) | `company` (dossier d'activation).
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  /// Libellé lisible figé au recompute (e-mail connu, sinon l'identifiant).
  label String

  /// Play recommandée : `lock_in` | `rescue` | `upgrade` | `win_back`.
  play String

  /// Score de priorité, entier 0..100 (fonction pure auditable).
  score Int

  /// Justification courte du score/play, rendue telle quelle au commercial.
  reason String

  /// Trajectoire du rythme si connue (`null` pour un dossier société).
  momentum String?

  /// Total commandé rattaché au lead, en centimes.
  monetaryCents Int @map("monetary_cents")

  /// Jours depuis la dernière activité.
  recencyDays Int @map("recency_days")

  /// Instant du recompute qui a produit cette ligne (fraîcheur de la reco).
  computedAt DateTime @map("computed_at")

  @@id([subjectType, subjectId])
  @@index([score(sort: Desc)])
  @@map("lead_scores")
  @@schema("growth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Lead — l'AGRÉGAT de démarchage (cold), schéma `growth`
// ─────────────────────────────────────────────────────────────────────────────

/// Lead **cold** : un prospect **saisi** par un commercial (sortant), avec un
/// **état de suivi**. Contrairement à hot/mid (projections du journal, zéro
/// invariant), le cold est un **agrégat** : le `status` suit un pipeline explicite
/// qui **ne recule jamais** (converted/lost terminaux). Vit dans le schéma `growth`
/// (donnée owned par le module croissance), pas dans `public`.
///
/// `linkedUserId` porte le **rapprochement** : quand le prospect démarché s'inscrit
/// (match e-mail), le lead est rattaché à son compte et converti. Indexé sur
/// `email` (clé du rapprochement) et `status` (filtrage de la file active).
model Lead {
  /// ULID préfixé `lead_` (fourni par l'IdGenerator).
  id String @id

  /// Raison sociale / nom de l'établissement démarché (seul champ obligatoire).
  businessName String @map("business_name")

  /// Contact chez le prospect, vide si non renseigné.
  contactName String @default("") @map("contact_name")

  /// E-mail du prospect — **clé de rapprochement** à l'inscription. Vide si inconnu.
  email String @default("")

  phone String @default("")

  /// SIRET si connu (identité business), vide sinon.
  siret String @default("")

  /// Étape du pipeline : new | contacted | qualified | negotiating | converted | lost.
  status String @default("new")

  /// Notes libres du commercial.
  notes String @default("")

  /// Compte rapproché (le prospect s'est inscrit), ou null. Pas de FK dure : le
  /// lead vit dans `growth` et ne dépend pas de la table `users` de `public`.
  linkedUserId String? @map("linked_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Dernier contact enregistré, ou null si jamais contacté.
  lastContactedAt DateTime? @map("last_contacted_at")

  @@index([email])
  @@index([status])
  @@map("leads")
  @@schema("growth")
}

// NB — Volontairement HORS de ce schéma :
// - ProductionPlan (« qtés à produire demain ») : c'est de la donnée PRODUCTION
//   (contexte interne/labo), pas du commerce customer-facing. Elle vit côté admin,
//   comme une projection dérivée des Order de ce schéma (calculée par le cron).
// - Cart : reste côté client (localStorage) jusqu'à la validation ; seule la
//   commande (Order) est persistée.
// - Stock : décision « source de vérité » reportée (Shopify vs nous).

// ─────────────────────────────────────────────────────────────────────────────
// Marché ciblé — pénétration par territoire (config commerciale staff)
// ─────────────────────────────────────────────────────────────────────────────

/// Un code NAF ciblé (catégorie d'acteurs professionnels visés). Config globale
/// staff, appliquée à toutes les zones lors du comptage via l'API entreprises.
model MarketNafCode {
  code      String   @id
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("market_naf_codes")
  @@schema("growth")
}

/// Une zone ciblée (code postal) avec le nombre d'acteurs visés STOCKÉ. `addressable`
/// = somme des comptages sur les NAF ciblés au dernier rafraîchissement ; `perNaf` =
/// le détail par code NAF ; `fetchedAt` = null tant qu'on n'a pas redemandé l'API.
model MarketZone {
  codePostal  String    @id @map("code_postal")
  addressable Int       @default(0)
  perNaf      Json      @default("[]") @map("per_naf")
  fetchedAt   DateTime? @map("fetched_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("market_zones")
  @@schema("growth")
}

/// Une **terminaison** de compte (churn), enregistrée à la clôture par le client ou
/// le commercial. `reason` = la catégorie de départ ; `outcome` distingue une
/// **tentative rattrapée** (`recovered`, le compte est resté) d'une **résiliation
/// confirmée** (`confirmed`). Sert au camembert des raisons (confirmées) et au taux
/// de rattrapage (recovered / tentatives), global et par catégorie.
model CompanyTermination {
  id           String    @id
  companyId    String    @map("company_id")
  /// price | competitor | closure | quality | no_need | unresponsive | other.
  reason       String
  /// Sous-raison précise (ex. `delivery_cost`, `catalog_price`), vide si non précisée.
  subReason    String    @default("") @map("sub_reason")
  /// 3ᵉ niveau optionnel (ex. catégorie produit sous `better_price`), vide sinon.
  detail       String    @default("") @map("detail")
  /// client | commercial (qui a enregistré la terminaison).
  initiatedBy  String    @map("initiated_by")
  /// confirmed (résilié) | recovered (rattrapé, compte conservé).
  outcome      String
  /// Pour un `recovered` : `auto` (plateforme) | `sales` (commercial), vide sinon.
  recoveredVia String    @default("") @map("recovered_via")
  /// Instant de l'action qui a rattrapé (délai de réaction), null si non rattrapée.
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([outcome, reason])
  @@map("company_terminations")
  @@schema("growth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Prise de rendez-vous — disponibilité déclarée + rendez-vous, schéma `growth`
// Doc : documentation/architecture-prise-de-rendez-vous.md
// ─────────────────────────────────────────────────────────────────────────────

/// **Règle hebdomadaire** de disponibilité commerciale : « le mardi, 09:00–12:00 ».
///
/// Une règle n'est PAS une liste de créneaux : les créneaux en sont **dérivés au
/// calcul** (`slotsFor`). Deux conséquences voulues — changer un horaire est un
/// `UPDATE` sur une ligne (pas une régénération), et il n'existe aucun créneau
/// persisté qui puisse diverger de l'horaire réel.
///
/// Les heures sont en **heure locale d'Europe/Paris** (`HH:MM`) : c'est ce que le
/// commercial saisit et pense, et la résolution en instant se fait au calcul —
/// donc le changement d'heure ne décale rien.
///
/// Pas de `staff_user_id` : la v1 porte **un agenda d'équipe**. L'identité staff
/// n'est pas dans le jeton aujourd'hui, une colonne qu'on ne saurait pas remplir
/// serait une dette. Extension prévue : la colonne nullable (null = équipe).
model AvailabilityRule {
  /// ULID préfixé `avrule_`.
  id String @id

  /// Jour de la semaine, convention `Date.getDay()` : 0 = dimanche … 6 = samedi.
  weekday Int

  /// Bornes locales `HH:MM`, `start` strictement avant `end` (garanti au contrat).
  startTime String @map("start_time")
  endTime   String @map("end_time")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([weekday])
  @@map("availability_rules")
  @@schema("growth")
}

/// **Exception** datée à la grille hebdomadaire : une fermeture (congés, férié) ou
/// une ouverture ponctuelle (un samedi de salon). Sans bornes, une fermeture ferme
/// la journée entière.
model AvailabilityException {
  /// ULID préfixé `avexc_`.
  id String @id

  /// Jour concerné, `AAAA-MM-JJ` en heure locale — un jour de calendrier, pas un
  /// instant : stocké en `DATE` pour qu'aucun fuseau ne puisse le décaler.
  day DateTime @db.Date

  /// `closed` (fermeture) | `open` (ouverture hors grille).
  kind String

  /// Bornes locales `HH:MM`, ou null pour une fermeture de journée entière.
  startTime String? @map("start_time")
  endTime   String? @map("end_time")

  /// Motif libre, affiché au commercial (« congés », « salon »).
  reason String @default("")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([day])
  @@map("availability_exceptions")
  @@schema("growth")
}

/// Un **rendez-vous** commercial posé sur un créneau.
///
/// `status` suit une machine à états à terminaux **définitifs** (`honored`,
/// `no_show`, `cancelled`) : reprogrammer, c'est annuler puis créer, avec
/// `rescheduled_from_id` pour garder le fil.
///
/// ⚠️ L'**exclusivité du créneau** ne tient pas en code applicatif (deux requêtes
/// concurrentes passeraient la même vérification avant qu'une seule n'écrive).
/// Elle est garantie par un **index unique partiel** posé en SQL brut dans la
/// migration — Prisma ne sait pas modéliser un index conditionnel :
///     CREATE UNIQUE INDEX appointments_slot_unique
///       ON growth.appointments (start_at) WHERE status <> 'cancelled';
/// Un rendez-vous annulé libère donc son créneau ; un rendez-vous actif le
/// verrouille. La violation se traduit en 409, jamais en 500.
///
/// Le **sujet est discriminé et non muré par la société** : un prospect froid
/// (`lead`) ou une personne sans société (`user`) doit pouvoir être reçu — c'est
/// justement la population qu'on cherche à capter. Pas de FK dure pour la même
/// raison que `Lead.linked_user_id` : `growth` ne dépend pas des tables de `public`.
model Appointment {
  /// ULID préfixé `appt_`.
  id String @id

  /// Bornes du rendez-vous, en **UTC** (la vérité ; la lecture locale se dérive).
  startAt DateTime @map("start_at")
  endAt   DateTime @map("end_at")

  /// requested | confirmed | honored | no_show | cancelled.
  status String @default("requested")

  /// phone | visio | onsite.
  channel String

  /// Motif — discover | quote | order | recurring | billing | other.
  purpose String @default("other")

  /// company | lead | user.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  contactName  String @default("") @map("contact_name")
  contactEmail String @default("") @map("contact_email")
  contactPhone String @default("") @map("contact_phone")

  /// Message libre du demandeur.
  message String @default("")

  /// Motif d'annulation — exigé par l'agrégat quand on annule, vide sinon.
  cancelReason String @default("") @map("cancel_reason")

  /// Rendez-vous d'origine si celui-ci le reprogramme, null sinon.
  rescheduledFromId String? @map("rescheduled_from_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startAt])
  @@index([status])
  @@index([subjectType, subjectId])
  @@map("appointments")
  @@schema("growth")
}

/// **Politique de réservation** — les bornes que le commercial pose autour de sa
/// grille. Singleton (une constante fixe en `id` garantit l'unicité), et rangée
/// dans `growth` plutôt que dans `b2b_platform_settings` : `growth` ne doit
/// dépendre d'aucune table de `public`, c'est ce qui rend son extraction possible
/// le jour venu.
model BookingPolicySettings {
  id String @id

  /// Durée d'un rendez-vous, en minutes — aussi le pas de découpe des plages.
  slotMinutes Int @default(30) @map("slot_minutes")

  /// On ne réserve pas dans les N heures qui viennent (délai de prévenance).
  leadTimeHours Int @default(24) @map("lead_time_hours")

  /// On ne réserve pas au-delà de N jours (horizon).
  horizonDays Int @default(30) @map("horizon_days")

  /// Canaux proposés au client : phone | visio | onsite (au moins un).
  channels String[] @default(["phone"])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("booking_policy_settings")
  @@schema("growth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Alertes de compte client — cf. documentation/b2b/architecture-alertes-compte-client.md
// ─────────────────────────────────────────────────────────────────────────────

/// Le réglage **global** d'un type d'alerte : une ligne par type, valable pour
/// tous les comptes tant qu'aucune dérogation ne l'écrase.
///
/// `kind` est la clé, et il est en **String** (union validée au bord par Zod),
/// pas en enum Prisma : ajouter un type de détection ne doit pas coûter une
/// migration. `params` est discriminé par ce même `kind` côté contrat —
/// `thresholdPercent` n'a aucun sens pour « produit jamais pris ».
///
/// Une ligne **absente** = le type n'a jamais été touché : le lecteur retombe
/// alors sur les défauts déclarés dans `ALERT_KINDS`. C'est pour ça que
/// `updated_at` sert de « jamais réglé » à l'écran plutôt qu'une date inventée.
model AlertRuleSetting {
  kind String @id

  enabled Boolean @default(true)

  /// Paramètres du détecteur, forme dictée par `kind` (union discriminée Zod).
  params Json

  /// Canaux : { staffInApp, staffEmail, customerVisible }. Le journal du compte,
  /// lui, est inconditionnel — ces trois-là sont ce qu'on fait EN PLUS.
  delivery Json

  updatedAt DateTime @updatedAt @map("updated_at")
  /// Le `sub` du staff qui a écrit ce réglage. Un identifiant, pas un nom : il
  /// reste résolvable après un changement de nom.
  updatedBy String?  @map("updated_by")

  @@map("alert_rule_settings")
  @@schema("public")
}

/// La **dérogation d'un compte** à une règle globale. Une ligne **seulement si**
/// le compte déroge : l'absence signifie « suit le réglage global », ce qui se
/// lit sans ambiguïté et n'oblige pas à semer une ligne par (compte × type).
///
/// `mode` = `off` (le type ne s'évalue pas ici) ou `custom` (le compte porte sa
/// propre règle). En `custom`, `params`/`delivery` sont **complets** — jamais un
/// diff : un override partiel obligerait à arbitrer ce que devient un champ à
/// moitié dérogé quand le global change, et il n'y a pas de bonne réponse.
model AccountAlertOverride {
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind String

  mode String

  /// Nuls en mode `off` : il n'y a rien à régler quand la règle est éteinte.
  enabled  Boolean?
  params   Json?
  delivery Json?

  updatedAt DateTime @updatedAt @map("updated_at")
  /// Le `sub` du staff qui a posé cette dérogation — « qui a coupé les alertes
  /// sur ce compte » doit rester répondable dans six mois.
  updatedBy String?  @map("updated_by")

  @@id([companyId, kind])
  @@index([companyId])
  @@map("account_alert_overrides")
  @@schema("public")
}

/// Une **alerte déclenchée** : un type, une commande, et les lignes concernées.
///
/// Une ligne par (type × commande), **pas par produit** : un client qui élargit
/// sa gamme sur quinze références produirait quinze alertes, et la première vraie
/// utilisation noierait la liste. Le bruit est ainsi borné par construction.
///
/// `findings` est un **snapshot figé** (quantité, référence, écart, message) : la
/// moyenne d'aujourd'hui ne doit pas réécrire ce qu'on a constaté en mars. Une
/// alerte est un fait daté, pas une requête rejouée à l'affichage.
model AccountAlert {
  /// ULID (fourni par l'`IdGenerator`) : triable par le temps.
  id String @id

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind String

  orderId     String @map("order_id")
  /// Référence humaine figée — c'est elle qu'on dicte au téléphone.
  orderNumber String @map("order_number")

  /// Anti-doublon : `kind:orderId`. Ne porte PAS les seuils — réévaluer après un
  /// ajustement de réglage ne doit pas repeupler l'historique.
  idempotencyKey String @unique @map("idempotency_key")

  /// Temps de l'ÉVÉNEMENT (autorité = `Clock`), distinct de l'écriture.
  occurredAt DateTime @map("occurred_at")

  /// Les constats, figés : [{ sku, productName, quantity, baseline, deviationPercent, message }].
  findings Json

  acknowledgedAt DateTime? @map("acknowledged_at")
  /// Le `sub` staff qui a acquitté — figé, résolvable même après un changement de nom.
  acknowledgedBy String?   @map("acknowledged_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId, occurredAt])
  @@index([companyId, acknowledgedAt])
  @@map("account_alerts")
  @@schema("public")
}

/// La **norme d'un produit** : ce qu'on en commande habituellement, tous comptes
/// confondus. Read-model **matérialisé**, recalculé par cron.
///
/// Pas calculable à la volée : un agrégat cross-comptes sur six mois, par SKU, à
/// chaque commande, c'est la requête qui met une base à genoux le jour où
/// l'historique grossit. Même patron que `LeadScore`.
///
/// `medianQuantity` et non une moyenne : une moyenne se fait déplacer par
/// l'aberration qu'on cherche, donc une faute de frappe passée une fois
/// éteindrait la détection des suivantes.
model ProductNorm {
  /// Référence catalogue (SKU du PIM) — String, pas une FK (autre db).
  sku String @id

  /// Médiane des quantités observées sur la fenêtre. Décimal : la médiane d'un
  /// échantillon pair tombe entre deux entiers.
  medianQuantity Decimal @map("median_quantity") @db.Decimal(12, 2)

  /// Nombre de lignes observées — sous un plancher, il n'y a pas de « norme ».
  sampleLines Int @map("sample_lines")

  /// La fenêtre sur laquelle cette norme a été mesurée, en jours.
  windowDays Int @map("window_days")

  computedAt DateTime @map("computed_at")

  @@map("product_norms")
  @@schema("public")
}

/// Une **notification staff** — la cloche du back-office.
///
/// Socle **générique** : un sujet, une ligne, un lien, un état lu/non-lu. Les
/// alertes de compte en sont le premier consommateur, les rendez-vous et les
/// demandes de contact (J2) le seront ensuite. Une cloche taillée pour les
/// alertes aurait été à refaire au deuxième usage.
///
/// **Commune à l'équipe**, pas par personne : à cette taille d'équipe, « me
/// prévenir » veut dire prévenir la boîte, et une notification traitée par l'un
/// n'a pas à rester en attente chez les autres. `readBy` dit qui s'en est chargé.
model StaffNotification {
  /// ULID (fourni par l'`IdGenerator`) : triable par le temps.
  id String @id

  /// Nature du fait, ex. `alert.account`. Le `payload` n'existe pas : ce qu'il
  /// faut afficher est déjà figé dans `subject` / `body` / `link`.
  kind String

  subject String
  /// Une ligne, pas un rapport : la cloche annonce, l'écran cible explique.
  body    String
  /// Route interne à ouvrir (ex. `/comptes-clients/xxx/alertes`).
  link    String

  /// Anti-doublon : un fait rejoué ne sonne pas deux fois.
  idempotencyKey String @unique @map("idempotency_key")

  /// Temps du FAIT (autorité = `Clock`), distinct de l'écriture.
  occurredAt DateTime @map("occurred_at")

  readAt DateTime? @map("read_at")
  /// Le `sub` staff qui l'a lue — un identifiant, pas un nom.
  readBy String?   @map("read_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([readAt, occurredAt])
  @@map("staff_notifications")
  @@schema("public")
}

/// L'**abonnement d'une installation** aux notifications poussées du back-office.
///
/// Une ligne = un navigateur sur un appareil, pas une personne : le même compte
/// sur le téléphone et sur le poste fait deux abonnements, et c'est voulu — on
/// prévient l'appareil qu'on a sous la main.
///
/// `endpoint` est l'identité, telle que la fabrique le navigateur : c'est l'URL
/// du service de push (Apple, Google, Mozilla) à laquelle nous déposerons le
/// message. Elle est **unique** parce qu'un même navigateur qui se réabonne doit
/// remplacer son abonnement, pas en accumuler.
///
/// Les deux clés sont celles du navigateur, stockées telles quelles : elles
/// chiffrent la charge de bout en bout, de sorte que le service de push
/// transporte sans pouvoir lire.
model StaffPushSubscription {
  /// ULID (fourni par l'`IdGenerator`) : triable par le temps.
  id String @id

  /// L'installation. Longue (jusqu'au millier de caractères chez certains
  /// services), d'où l'index sur un hachage plutôt que sur la valeur.
  endpoint String @unique

  /// Clé publique P-256 du navigateur, en base64url.
  p256dh String
  /// Secret d'authentification, en base64url.
  auth   String

  /// Le `sub` staff qui s'est abonné — un identifiant, pas un nom. Sert à
  /// couper les abonnements de quelqu'un qui part, pas à cibler : la cloche est
  /// commune à l'équipe.
  staffSub String @map("staff_sub")

  createdAt  DateTime  @default(now()) @map("created_at")
  /// Dernier envoi ACCEPTÉ par le service de push. Un abonnement muet depuis
  /// des mois est un téléphone remplacé, pas une panne.
  lastSentAt DateTime? @map("last_sent_at")

  /// Depuis quand le service de push REFUSE nos envois (403), ou `null`.
  ///
  /// Le 403 est ambigu, et c'est toute la raison de cette colonne : il dit « ta
  /// signature ne vaut pas pour cet abonnement », ce qui arrive aussi bien
  /// parce que l'abonnement date d'une paire VAPID révolue que parce que la
  /// paire déployée est la mauvaise. Les deux se ressemblent trait pour trait —
  /// tous les abonnements refusent, tout le temps.
  ///
  /// D'où le **délai de grâce** plutôt qu'un oubli immédiat : une paire mal
  /// posée se répare en quelques heures et ne doit désabonner personne ; un
  /// abonnement orphelin d'une vraie rotation, lui, ne guérit jamais et part au
  /// bout d'une semaine. Remis à `null` au premier envoi accepté.
  failingSince DateTime? @map("failing_since")

  @@index([staffSub])
  @@map("staff_push_subscriptions")
  @@schema("public")
}

/// Le **brouillon** d'une commande saisie par l'équipe — une saisie interrompue,
/// pas une commande incomplète.
///
/// **Un par société** (`companyId` unique), et non un par membre du staff : c'est
/// le compte qu'on sert, et un commercial qui reprend l'appel d'un collègue doit
/// retrouver ce qui a été saisi. La contrepartie est assumée — deux saisies
/// simultanées, la dernière écrase l'autre — d'où `savedByStaffId`, qui dit au
/// moins à qui demander.
///
/// Le contenu est un `Json` validé par `orderDraftPayloadSchema` à l'entrée comme
/// à la sortie : une table à colonnes suivrait chaque évolution de l'écran de
/// saisie pour des données qui ne sont jamais requêtées autrement que par
/// société. Aucun FK sur les lignes non plus — un brouillon référence des SKU,
/// et les prix seront de toute façon ré-résolus à la passation.
model OrderDraft {
  id             String   @id @default(uuid())
  companyId      String   @unique @map("company_id")
  payload        Json
  // La fiche staff qui a enregistré. Nullable : un départ ne doit pas effacer
  // le brouillon d'un client.
  savedByStaffId String?  @map("saved_by_staff_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("order_drafts")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Catalogue REÇU du PIM — cf. documentation/b2b/architecture-catalogue-synchronise.md
//
// Deux tables, et c'est LA décision de structure de ce chantier. Le miroir est
// remplacé en entier à chaque push ; l'override porte les décisions prises ici.
// Les fondre donnerait au push suivant deux issues, toutes deux fausses :
// écraser le travail commercial, ou refuser de s'appliquer.
// ---------------------------------------------------------------------------

/// Une **famille** reçue du PIM. Miroir : jamais éditée ici.
/// **L'historique du tarif canonique** — append-only, une ligne par CHANGEMENT.
///
/// Le prix enregistré est l'**effectif** : la décision B2B quand elle existe,
/// sinon celui du PIM. C'est ce prix-là qui entre dans la résolution, donc le
/// seul dont une relecture datée ait besoin.
///
/// Écrit dans la transaction qui sauve l'article, au seul endroit par lequel les
/// deux chemins passent (`saveMany`). C'est ce qui rend « aucun changement de
/// prix sans sa trace » structurel plutôt que discipliné : un push du PIM comme
/// une décision du back-office y aboutissent, et aucun appelant ne peut
/// l'esquiver.
///
/// Une ligne n'est posée que si le prix effectif **diffère** du dernier
/// enregistré : sans ça, un push de 92 articles inchangés écrirait 92 lignes à
/// chaque synchronisation, et l'historique deviendrait illisible en une semaine.
model CatalogPriceHistory {
  id String @id

  /// Le SKU de la déclinaison — la clé de l'article reçu.
  sku        String
  /// Le SKU du PRODUIT : c'est par lui que la boutique vend, donc par lui qu'on relit.
  productSku String @map("product_sku")

  /// Prix HT en centimes réellement applicable à cet instant.
  priceCents Int    @map("price_cents")
  /// `pim` (le tarif reçu) ou `b2b` (la décision locale l'emporte).
  source     String

  recordedAt DateTime @map("recorded_at")

  @@index([productSku, recordedAt])
  @@index([recordedAt])
  @@map("catalog_price_history")
  @@schema("public")
}

model CatalogCategory {
  id String @id

  name     String
  slug     String
  parentId String? @map("parent_id")
  position Int     @default(0)

  /// Taux de TVA en %, résolu par le PIM depuis le taux **B2B** de la famille.
  /// Reçu plutôt que déduit : la plateforme codait 5,5 % en dur pour tout, y
  /// compris le non-alimentaire — puis a emprunté le taux « à emporter », faute
  /// que la famille en porte un pour le B2B. Elle en porte un depuis le
  /// 2026-08-22, et c'est celui-là qui arrive ici.
  ///
  /// `NULL` = famille **non réglée dans le PIM**. Le catalogue entre quand même :
  /// le prix canonique a de la valeur sans le taux. Ce qui reste interdit, c'est
  /// de VENDRE sans taux — `CatalogReader` écarte ces articles de la boutique
  /// plutôt que d'inventer 5,5 %.
  vatRatePercent Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)

  items CatalogItem[]

  receivedAt DateTime @map("received_at")

  @@map("catalog_categories")
  @@schema("public")
}

/// **L'article vendable** reçu du PIM — une déclinaison, pas un produit.
///
/// La clé est le SKU : c'est lui que porte une ligne de commande, et il survit
/// à tout changement d'identifiant interne côté PIM. `productId` / `productSku`
/// sont conservés pour regrouper à l'écran, pas pour joindre.
model CatalogItem {
  sku String @id

  productId  String @map("product_id")
  productSku String @map("product_sku")
  name       String
  kind       String

  categoryId String          @map("category_id")
  category   CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Prix canonique HT en centimes, tel que le PIM le tarife. **Pré-altération** :
  /// le prix B2B, s'il existe, vit dans `CatalogItemOverride`.
  priceCents  Int     @map("price_cents")
  weightGrams Int?    @map("weight_grams")
  isDefault   Boolean @default(false) @map("is_default")
  position    Int     @default(0)

  /// Taux de TVA en %, **résolu par le PIM pour CET article** et reçu tel quel.
  ///
  /// Porté par l'article et non par la famille : c'est l'article qu'on vend,
  /// c'est lui qui doit savoir se facturer. Le lire sur la famille faisait
  /// dépendre la ligne facturée d'une jointure et d'un rafraîchissement de
  /// famille réussi.
  ///
  /// `NULL` = famille non réglée dans le PIM. L'article entre quand même (le
  /// prix canonique a de la valeur sans le taux) mais n'est pas VENDABLE :
  /// `CatalogReader` l'écarte plutôt que d'inventer 5,5 %.
  vatRatePercent Decimal? @map("vat_rate_percent") @db.Decimal(5, 2)

  /// Les **codes allergènes GS1** déclarés par le PIM pour cet article.
  ///
  /// `Json` et non `String[]`, pour une raison précise : une liste scalaire
  /// Prisma ne peut pas être nulle, elle vaut `[]` par défaut — or il faut
  /// distinguer TROIS états. `null` = aucune fiche réglementaire (rien n'a été
  /// déclaré), `[]` = fiche déclarée SANS allergène (une affirmation), une
  /// liste = les codes. Confondre les deux premiers transformerait un oubli de
  /// saisie en promesse au consommateur.
  ///
  /// Des CODES, jamais des libellés : la projection vers les catégories INCO
  /// (dédup n:1, mise en évidence, langue) appartient à qui affiche.
  allergens Json? @map("allergens")

  /// Quand ce push l'a écrit. Sert à repérer ce qu'un push partiel aurait laissé.
  receivedAt DateTime @map("received_at")

  override CatalogItemOverride?

  @@index([categoryId])
  @@index([productId])
  @@map("catalog_items")
  @@schema("public")
}

/// Ce que **la plateforme** décide, par-dessus ce que le PIM envoie.
///
/// Une ligne n'existe que si quelqu'un a décidé quelque chose : « revenir au
/// prix du PIM » est une SUPPRESSION de ligne, pas une ressaisie. C'est aussi ce
/// qui permet à l'écran de dire « prix PIM 2,40 € · prix B2B 2,10 €, posé par
/// Cécile le 12/08 » au lieu d'un nombre sans provenance.
///
/// Elle **survit au push**, et cette survie tient à UNE règle d'ingestion : les
/// articles maintenus sont **mis à jour**, jamais supprimés puis recréés. Une
/// ingestion en « table rase » cascaderait ici et effacerait tout le travail
/// commercial sans un mot. C'est le piège de cette table ; le test
/// « un push ne perd pas les décisions déjà prises » existe pour le tenir.
///
/// La cascade sert l'autre cas, celui où elle est juste : un article réellement
/// **retiré** du catalogue emporte sa décision, parce qu'un prix négocié ne veut
/// plus rien dire sans l'article qu'il tarifait.
model CatalogItemOverride {
  sku  String      @id
  item CatalogItem @relation(fields: [sku], references: [sku], onDelete: Cascade)

  /// Prix de liste **du canal B2B**, HT en centimes. `NULL` = on garde celui du
  /// PIM. C'est l'ENTRÉE du pipeline de résolution de prix, pas un de ses étages :
  /// mercuriale, dégressif et promotions viendront par-dessus.
  priceCents Int? @map("price_cents")

  /// Retiré du catalogue B2B sans être retiré du PIM.
  isHidden   Boolean @default(false) @map("is_hidden")
  /// Mis en avant dans la boutique.
  isFeatured Boolean @default(false) @map("is_featured")

  /// Qui a décidé, et quand. La question posée six mois plus tard est toujours
  /// « qui a accordé ce prix ».
  decidedBy String?  @map("decided_by")
  decidedAt DateTime @updatedAt @map("decided_at")

  @@map("catalog_item_overrides")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Règles tarifaires — cf. documentation/b2b/architecture-resolution-de-prix.md
// ---------------------------------------------------------------------------

/// Une **règle tarifaire** : un étage, une portée, une audience, une fenêtre.
///
/// Les discriminants (`stage`, `scopeType`, `nature`…) sont des `String` et non
/// des enums Prisma, et c'est délibéré : ils entrent dans une contrainte
/// d'EXCLUSION GiST, où un type énuméré ajoute une dépendance à la classe
/// d'opérateurs de `btree_gist` sans rien apporter. L'union est validée au bord
/// par zod, comme `recurrence` et `status` ailleurs dans ce schéma.
///
/// ⚠️ La garantie qui compte n'est PAS dans ce modèle : c'est la contrainte
/// `price_rules_no_overlap`, posée en SQL par la migration. Deux règles
/// également spécifiques valides au même instant deviennent **impossibles à
/// insérer** — sans elle, le prix dépendrait de l'ordre de tri, donc du hasard.
model PriceRule {
  id String @id @default(cuid())

  /// `mercuriale` | `volume` | `promotion` | `geste` — l'ordre d'application
  /// est déclaré dans le domaine, jamais ici.
  stage String

  /// `replace` pose un prix (engagement en euros) ; `alter` modifie l'entrant.
  nature String

  /// `global` | `category` | `product` | `variant`. `scopeId` est `NULL` **si et
  /// seulement si** `scopeType = 'global'`.
  scopeType String  @map("scope_type")
  scopeId   String? @map("scope_id")

  /// `all` | `segment` | `company`. Même règle de nullité.
  audienceType String  @map("audience_type")
  audienceId   String? @map("audience_id")

  /// Palier de quantité de l'étage volume. `NULL` = aucun seuil.
  minQuantity Int? @map("min_quantity")

  /// `nature = 'replace'` : le prix posé, HT en centimes.
  amountCents Int? @map("amount_cents")

  /// `nature = 'alter'` : sens, unité, grandeur. La grandeur est **toujours
  /// positive** — le sens vit dans `direction`.
  direction String? // increase | decrease
  mode      String? // percent | amount
  value     Int? // bp si percent, cents si amount

  /// Plancher propre à la règle. `NULL` = celui de la plateforme s'applique.
  floorMode  String? @map("floor_mode") // percent | amount
  floorValue Int?    @map("floor_value") // bp du canonique, ou cents

  /// Borne basse **incluse**, borne haute **exclue** : deux règles qui se
  /// succèdent au même instant ne se chevauchent jamais.
  ///
  /// `Timestamptz` et non `timestamp` : sans fuseau, `tstzrange()` dépend du
  /// réglage de session, donc n'est pas `IMMUTABLE`, donc **ne peut pas entrer
  /// dans la contrainte d'exclusion** — Postgres refuse la migration. C'est
  /// aussi le type juste : une fenêtre tarifaire est un fait daté absolu.
  validFrom DateTime  @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(3)

  /// Ce que la trace affichera au client et au service client.
  label String

  /// **Cette règle agit-elle malgré une mercuriale ?**
  ///
  /// Une mercuriale scelle la chaîne : les étages suivants sont transparents.
  /// Ce drapeau est la porte de sortie, et elle est explicite — « oui, cette
  /// promotion vise aussi les comptes au tarif négocié ». `false` par défaut,
  /// y compris sur les règles antérieures au scellement : c'est le comportement
  /// que la maison a décidé, pas celui qu'elle subissait.
  stacksOverMercuriale Boolean @default(false) @map("stacks_over_mercuriale")

  /// Qui a posé cette règle. Sur un tarif négocié, la question posée six mois
  /// plus tard est toujours « qui a accordé ça ».
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  /// **Suspendue.** Elle cesse d'agir et GARDE sa place : la contrainte
  /// d'exclusion la voit toujours, donc personne ne peut poser une jumelle qui
  /// rendrait la reprise impossible.
  pausedAt DateTime? @map("paused_at") @db.Timestamptz(3)
  pausedBy String?   @map("paused_by")

  /// **Archivée.** Terminal : elle cesse d'agir et REND sa place — la contrainte
  /// d'exclusion est partielle, `WHERE archived_at IS NULL`.
  ///
  /// Jamais de `DELETE` : une règle a facturé, elle a fait un prix, et l'effacer
  /// effacerait la réponse à « pourquoi ce prix » alors que la facture, elle,
  /// reste. Le motif est demandé ici et pas à la pause, parce que c'est le geste
  /// qui ne se défait pas.
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedBy    String?   @map("archived_by")
  archiveReason String?   @map("archive_reason")

  @@index([stage])
  @@index([archivedAt])
  @@index([audienceId])
  @@map("price_rules")
  @@schema("public")
}

/// Le **plancher** posé sur une portée : la limite que l'empilement des règles
/// ne franchit pas.
///
/// Il n'a ni étage, ni audience, ni fenêtre — cf. `ScopedPriceFloor` dans le
/// domaine, où chacune de ces trois absences est une décision et non un manque.
/// Reste la portée, résolue comme celle des règles : le plus spécifique gagne,
/// et un plancher d'article **remplace** celui de sa famille.
///
/// ⚠️ Comme pour les règles, l'unicité réelle n'est PAS dans ce modèle :
/// `@@unique([scopeType, scopeId])` laisserait passer deux planchers globaux,
/// Postgres tenant deux `NULL` pour distincts. C'est l'index unique
/// `price_floors_one_per_scope` sur `coalesce(scope_id, '')`, posé en SQL par la
/// migration, qui porte la garantie — même leçon que `coalesce` dans la
/// contrainte d'exclusion des règles.
model PriceFloor {
  id String @id @default(cuid())

  /// `global` | `category` | `product` | `variant`. `scopeId` est `NULL` **si et
  /// seulement si** `scopeType = 'global'`.
  scopeType String  @map("scope_type")
  scopeId   String? @map("scope_id")

  /// **Le mur** — jamais franchi, quoi qu'il arrive.
  ///
  /// `percent` : une fraction du prix canonique, en points de base — elle suit
  /// le tarif quand le PIM augmente. `amount` : une limite absolue en centimes.
  mode  String
  value Int

  /// **La porte** : un plancher plus bas, que le volume déverrouille. `NULL` =
  /// il n'y en a pas, et le mur est la seule limite.
  ///
  /// Les deux conditions ci-dessous doivent être remplies pour l'ouvrir — la
  /// plus stricte gagne. Une condition `NULL` est réputée remplie ; les deux
  /// `NULL` feraient de la porte un mur, ce que l'agrégat refuse.
  dynamicMode            String? @map("dynamic_mode")
  dynamicValue           Int?    @map("dynamic_value")
  /// Quantité minimale **sur la commande** — déterministe au checkout.
  unlockMinQuantity      Int?    @map("unlock_min_quantity")
  /// Ratio de volume **observé** requis, en points de base (`12500` = ×1,25).
  unlockMinVolumeRatioBp Int?    @map("unlock_min_volume_ratio_bp")

  /// Le tarif **représentatif des articles visés**, figé au moment où la limite a
  /// été posée — la médiane de leurs prix canoniques.
  ///
  /// C'est la seule chose qui permette de dire, six mois plus tard, que
  /// l'intention a vieilli : sans référence, on ne peut comparer le tarif
  /// d'aujourd'hui à rien. Médiane et non moyenne — une limite de famille ne doit
  /// pas se juger déplacée parce qu'une pièce montée y côtoie des croissants.
  ///
  /// `NULL` = limite posée avant que cette référence n'existe. L'écran se tait
  /// alors plutôt que d'annoncer « 0 % d'écart », qui ferait passer une absence
  /// de mesure pour une confirmation.
  referenceCanonicalCents Int? @map("reference_canonical_cents")

  /// Qui a posé cette limite. Même raison que sur une règle : la question posée
  /// six mois plus tard est toujours « qui a autorisé de descendre si bas ».
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// **Archivée.** Une limite ne se supprime pas davantage qu'une règle : elle a
  /// arbitré des prix, et savoir qu'elle existait explique des factures.
  ///
  /// Pas de versionnage ici, à la différence des règles : l'identifiant est
  /// DÉRIVÉ de la portée, donc il n'y a jamais qu'une ligne par cible. Une limite
  /// retirée puis re-posée reprend sa ligne, et son histoire vit dans le journal
  /// — l'endroit fait pour ça.
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedBy    String?   @map("archived_by")
  archiveReason String?   @map("archive_reason")

  @@map("price_floors")
  @@schema("public")
}

/// **Le barème de volume** — une échelle, pas N règles.
///
/// « 50+ à −10 % » et « 100+ à −5 % » sont deux règles parfaitement valides
/// prises séparément, et forment ensemble un barème que personne n'a voulu : un
/// client qui passe de 90 à 100 pièces y verrait sa remise fondre. Réunis en
/// échelle, les paliers deviennent UNE décision, et l'agrégat peut refuser ce
/// qu'aucune règle isolée ne pouvait voir.
model VolumeLadder {
  /// ULID opaque : deux barèmes SUCCESSIFS sur la même cible coexistent (celui
  /// d'aujourd'hui, celui de septembre), donc l'identifiant ne peut pas dériver
  /// de la cible. C'est la contrainte d'exclusion qui garantit l'unicité — pas
  /// dans l'absolu, mais À UN INSTANT DONNÉ.
  id String @id

  scopeType String  @map("scope_type")
  scopeId   String? @map("scope_id")

  audienceType String  @map("audience_type")
  audienceId   String? @map("audience_id")

  /// `percent` | `amount` — l'unité de TOUTE l'échelle. Un seul champ pour tous
  /// les paliers : le mélange devient impossible, pas interdit. C'est ce qui rend
  /// la progression vérifiable, deux points de base se comparant sans connaître
  /// l'article.
  unit String

  /// Les paliers, triés par quantité croissante : `[{ minQuantity, value }]`.
  ///
  /// En JSON et non dans une table fille, délibérément : une échelle s'écrit
  /// **entière** ou pas du tout. Une table fille permettrait d'insérer un palier
  /// sans les autres — exactement ce que cet agrégat existe pour empêcher.
  tiers Json

  /// Ce que la trace affichera au client et au service client.
  label String

  /// Borne basse **incluse**, borne haute **exclue** — la convention de tout le
  /// modèle. `Timestamptz` pour la même raison que sur les règles : sans fuseau,
  /// `tstzrange()` dépend du réglage de session, donc n'est pas IMMUTABLE, donc
  /// ne peut pas entrer dans la contrainte d'exclusion.
  validFrom DateTime  @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(3)

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Même cycle de vie qu'une règle : suspendre garde la cible, archiver la rend.
  pausedAt      DateTime? @map("paused_at") @db.Timestamptz(3)
  pausedBy      String?   @map("paused_by")
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedBy    String?   @map("archived_by")
  archiveReason String?   @map("archive_reason")

  @@index([archivedAt])
  @@map("volume_ladders")
  @@schema("public")
}

/// **Un gabarit tarifaire** — la grille qu'un commercial prépare une fois et
/// repose chez plusieurs clients.
///
/// Une seule forme : une liste de paliers portant des PRIX en euros. Le « prix
/// fixe » n'est pas une seconde forme, c'est le gabarit à un seul palier, à
/// partir de 1. Les deux façons de saisir ne changent que la manière d'arriver
/// au prix, jamais ce qui est stocké.
///
/// Posé chez un client, un gabarit devient N règles de l'étage mercuriale à des
/// seuils différents — une forme que le moteur résout déjà, et dont l'unicité
/// est déjà garantie (la contrainte d'exclusion porte sur `min_quantity`).
model PriceTemplate {
  id String @id

  /// `mercuriale` | `devis`. Même contenu, deux usages : l'un se POSE chez un
  /// client, l'autre alimente une estimation sans rien poser.
  kind String

  label String

  /// Les lignes, `[{ sku, tiers: [{ minQuantity, unitPriceCents }] }]`.
  ///
  /// En JSON et non en table fille, pour la même raison que les paliers d'un
  /// barème : une grille s'écrit ENTIÈRE ou pas du tout. Une table fille
  /// permettrait d'insérer une ligne sans les autres, et un gabarit à moitié
  /// enregistré serait posé chez un client sans que personne ne le voie.
  ///
  /// Le tarif catalogue n'y est PAS recopié : il est lu à l'affichage. Un
  /// canonique figé vieillirait en silence et l'écart comparatif serait faux.
  lines Json

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Archivé, jamais supprimé : un gabarit a produit des mercuriales, et les
  /// retrouver six mois plus tard suppose qu'il existe encore.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)

  @@index([kind, archivedAt])
  @@map("price_templates")
  @@schema("public")
}

/// **L'engagement de volume** — un client vise un volume sur une période, et le
/// barème se juge alors sur le CUMUL de la période plutôt que sur la quantité de
/// chaque commande.
///
/// Retenu contre le prix fixe daté, et le motif est dans les conditions de
/// sortie : au volume promis les deux formes donnent le même prix, mais quand la
/// promesse n'est pas tenue, seul le cumul a une réponse arithmétique — le client
/// reste au palier qu'il a réellement atteint, et aucune facture n'est révisée.
///
/// Ce n'est PAS une réservation : rien n'est bloqué, rien n'est dû. Le prix ne
/// dépend que de ce qui a été commandé.
model VolumeCommitment {
  /// ULID opaque, comme le barème : deux engagements successifs sur la même
  /// cible coexistent, donc l'identifiant ne peut pas dériver de la cible.
  id String @id

  /// Un engagement vise TOUJOURS un client nommé : c'est une négociation, pas
  /// une offre. D'où l'absence d'axe « audience » — il n'y a qu'un cas.
  companyId String @map("company_id")

  scopeType String  @map("scope_type")
  scopeId   String? @map("scope_id")

  /// Le volume visé. Il sert au SUIVI, jamais au calcul : c'est le cumul mesuré
  /// qui décide du palier. Un engagement dont la promesse piloterait le prix
  /// serait une remise accordée sur une intention.
  promisedQuantity Int @map("promised_quantity")

  /// Borne basse incluse, borne haute exclue — et la haute est OBLIGATOIRE : un
  /// engagement sans terme est une mercuriale, qui a son propre étage.
  validFrom DateTime @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime @map("valid_to") @db.Timestamptz(3)

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  /// Archivé, jamais suspendu — un engagement ne se met pas en pause : il court
  /// ou il est clos. Le suspendre laisserait une période où le cumul continue
  /// sans que le palier suive, donc un prix que personne n'a décidé.
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(3)
  archivedBy    String?   @map("archived_by")
  archiveReason String?   @map("archive_reason")

  @@index([companyId, archivedAt])
  @@map("volume_commitments")
  @@schema("public")
}

/// **Le journal des actes tarifaires** — append-only.
///
/// Sur un prix négocié, la question posée six mois plus tard n'est jamais
/// « quelle était la règle » mais « qui a décidé ça, et qui l'a arrêté ». L'état
/// courant ne peut pas y répondre : il est précisément ce qui a remplacé la
/// réponse.
///
/// Aucune colonne mutable, aucun `updatedAt`, et aucun port qui expose une mise à
/// jour ou un effacement. Un journal réinscriptible ne prouve rien — le premier
/// jour où il servirait vraiment serait celui où quelqu'un aurait intérêt à le
/// corriger.
model PricingEvent {
  /// ULID : triable par le temps, donc paginable de façon stable sur un flux
  /// qui ne fait que grandir.
  id String @id

  /// `rule` | `floor`. Pas de clé étrangère, volontairement : l'acte doit
  /// survivre à son sujet, et une cascade de suppression emporterait justement
  /// la trace qu'on cherchait à garder.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  /// `posed` | `paused` | `resumed` | `archived` | `confirmed` | `replaced`.
  act String

  /// Le `sub` du membre du staff, ou `system`.
  ///
  /// Le NOM n'est pas figé ici, à la différence des traces client : l'annuaire
  /// staff est à nous et un `sub` est stable. Afficher le nom d'aujourd'hui est
  /// même la réponse utile — on cherche qui aller voir, pas comment il
  /// s'appelait à l'époque.
  actor String

  /// L'instant de l'acte, autorité = l'horloge du backend.
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  /// Ce que l'auteur a écrit quand l'écran le lui a demandé. `NULL` = rien.
  reason String?

  /// **Ce que la décision disait**, en une phrase FIGÉE à l'écriture. Recalculée
  /// à la lecture, elle raconterait l'histoire à l'envers.
  summary String

  @@index([subjectType, subjectId, occurredAt])
  @@index([occurredAt])
  @@map("pricing_events")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// OPS — la mémoire de la carte de santé
// ─────────────────────────────────────────────────────────────────────────────

/// **Une transition de statut**, et rien d'autre.
///
/// Une ligne quand un nœud CHANGE d'état — pas un échantillon périodique. Une
/// mesure toutes les quinze secondes ferait des dizaines de milliers de lignes
/// par jour pour dire quatre-vingt-dix-neuf fois la même chose ; une transition
/// en fait quelques dizaines, et ce sont exactement celles qu'on relit.
///
/// Ce que cette table rend possible, dans l'ordre où ça compte :
///
///  1. **`since` survit au redémarrage.** En mémoire seule, il repartait de
///     l'instant présent à chaque déploiement : « down depuis 6 h » redevenait
///     « down depuis à l'instant », c'est-à-dire un incident rajeuni au moment
///     précis où sa durée était l'information ;
///  2. **les nœuds sans trafic gagnent une histoire.** Tiers, fronts et base
///     n'ont pas de volume à tracer, mais ils ont une frise de disponibilité —
///     et c'est leur vraie métrique ;
///  3. **les alertes deviennent calibrables.** Brancher un canal sans savoir
///     combien de transitions par semaine fabrique du bruit, et un canal
///     bruyant s'ignore.
///
/// Pas de clé étrangère vers quoi que ce soit : `node` est un identifiant du
/// manifeste de topologie, pas une ligne d'une autre table. Une contrainte
/// inventerait une dépendance là où il n'y a qu'un nom.
model NodeStatusLog {
  /// ULID préfixé `nodestatus_` (fourni par l'IdGenerator).
  id String @id

  /// L'identifiant du nœud dans la topologie déclarée (`b2b`, `auth0`, …).
  node String

  /// up | degraded | down | unknown.
  status String

  /// Ce qui a produit ce statut (`probe-failed`, `error-rate`, `deploy-ok`, …).
  reason String

  /// Le constat de la sonde, s'il y en avait un. Vide sinon.
  detail String @default("")

  /// L'instant du CHANGEMENT — c'est lui que `since` rend.
  at DateTime @default(now())

  /// Lecture par nœud, du plus récent au plus ancien : c'est la seule qu'on fait.
  @@index([node, at(sort: Desc)])
  @@map("node_status_log")
  @@schema("ops")
}

/// **Un e-mail parti**, et ce qu'il est devenu.
///
/// `providerId` est l'identifiant Resend : la SEULE clé qui relie un envoi aux
/// événements qui le suivront. Nul en mode à blanc — rien n'est parti, et un
/// identifiant inventé ne se rapprocherait de rien.
///
/// `template` sert de **catégorie** : c'est lui qui permet de dire « les liens
/// d'accès rebondissent, les alertes internes non », qui est la seule forme
/// utile de cette information.
model MailSend {
  /// ULID préfixé `mailsend_`.
  id String @id

  /// Identifiant Resend, unique quand il existe : il dédoublonne l'envoi.
  providerId String? @unique @map("provider_id")

  /// Le gabarit envoyé (`customer.access-opened`, `staff.appointment-booked`…).
  template String

  recipient String

  /// sent | delayed | delivered | complained | bounced.
  status String @default("sent")

  /// Quand ce statut a été constaté — pas quand l'e-mail est parti.
  statusAt DateTime @default(now()) @map("status_at")

  /// Ce que le fournisseur a dit du rejet. Vide quand tout va bien.
  detail String @default("")

  sentAt DateTime @default(now()) @map("sent_at")

  /// La lecture des relevés : par gabarit, sur une fenêtre récente.
  @@index([template, sentAt])
  @@map("mail_send")
  @@schema("ops")
}

/// **Le registre des messages de webhook déjà vus.**
///
/// Les fournisseurs réessaient : le même événement arrive plusieurs fois, et le
/// traiter deux fois compterait deux rebonds pour un seul. L'unicité
/// `(provider, externalId)` est la garantie — portée par la base, pas par une
/// vérification applicative qui perdrait la course à deux requêtes simultanées.
model WebhookEvent {
  /// ULID préfixé `webhookevent_`.
  id String @id

  /// `resend`, et demain `stripe`.
  provider String

  /// L'identifiant du message chez le fournisseur (`svix-id` pour Resend).
  externalId String @map("external_id")

  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, externalId])
  @@map("webhook_event")
  @@schema("ops")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHÉMA `pim` — le référentiel produit.
//
// Il avait sa propre BASE, avec son propre client et son propre historique de
// migrations : c'était l'étape B2, qui fusionnait les processus sans toucher
// aux données. B4 la termine — une seule base, un schéma par besoin, aux côtés
// de `public`, `growth` et `ops`.
//
// La frontière, elle, ne disparaît pas : `PimDatabaseModule` reste NON global,
// et seul `src/pim/` injecte de quoi lire ces tables. Un schéma partagé n'est
// pas une permission partagée.
//
// Conventions héritées du socle catalogue (doc `02-catalogue-items.md`) :
// - identifiants assignés par la COMMANDE (R1) — aucun `@default(uuid())` ;
// - aucun DELETE physique (R3) — archivage par drapeau ;
// - `created_at` / `updated_at` / `updated_by` sont des colonnes SYSTÈME ;
// - textes traduisibles = `Json` `{ fr, en? }` (`fr` obligatoire).
// ─────────────────────────────────────────────────────────────────────────────

enum ProductKind {
  daily
  made_to_order
  resale

  @@schema("pim")
}

enum ProductStatus {
  draft
  published
  archived

  @@schema("pim")
}

enum SkuOwnerType {
  product
  variant

  @@schema("pim")
}

/// Registre des références — garantit l'unicité du SKU dans un espace de noms
/// GLOBAL (produits et déclinaisons confondus, doc 06 invariant 1).
/// Une contrainte d'unicité ne pouvant pas s'étendre à deux tables, c'est ce
/// registre qui porte la garantie : la violation de sa clé primaire est le
/// `23505` traduit en `SkuAlreadyUsedError` par l'adaptateur de dépôt.
model SkuRegistry {
  value     String       @id
  ownerType SkuOwnerType @map("owner_type")
  ownerId   String       @map("owner_id")

  @@index([ownerId])
  @@map("sku_registry")
  @@schema("pim")
}

model Category {
  id         String     @id
  name       Json
  slug       Json
  parentId   String?    @map("parent_id")
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[] @relation("CategoryTree")
  position   Int        @default(0)
  isArchived Boolean    @default(false) @map("is_archived")
  products   Product[]

  /// Canaux de vente hérités par les produits (matrice boutiques × modes).
  /// `{}` sur les lignes antérieures est relu comme « rien vendu » (défensif).
  channelPreset Json @default("{}") @map("channel_preset")

  /// Les taux par contexte de vente. Trois colonnes fixes vivaient ici
  /// (`emporter` / `surPlace` / `b2b`) : ajouter un contexte demandait une
  /// migration et du code dans cinq fichiers. Une ligne suffit désormais.
  contextVat CategoryContextVat[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([parentId])
  @@map("category")
  @@schema("pim")
}

/// Taux de TVA — référence commerciale partagée. Les canaux en dérivent ce
/// dont ils ont besoin : Shopify un handle de collection, la boutique B2B un
/// nombre à facturer. Aucun de ces deux vocabulaires ne vit ici.
/// Un **contexte de vente** — une manière de vendre l'article qui a son propre
/// traitement de TVA (donc sa propre collection `tva-*` côté Shopify).
///
/// Une TABLE et non trois colonnes sur `category` : ajouter « B2B » ou « borne
/// libre-service » doit être une LIGNE, pas une migration plus un déploiement.
/// Les trois colonnes `*_tva_id` de `category` sont l'ancien modèle ; elles
/// tombent au troisième déploiement (étendre → basculer → resserrer).
model SalesContext {
  id    String @id
  /// Identité stable, lue par le code (`emporter`, `surPlace`, `b2b`).
  key   String @unique
  /// Ce qu'un humain lit à l'écran.
  label String

  /// Suffixe de handle Shopify. **Vide pour le contexte par défaut** : le
  /// handle nu protège les URL déjà indexées (cf. C0-bis, write-once SEO).
  handleSuffix String @default("") @map("handle_suffix")

  /// Quel drapeau de `category.channel_preset` autorise ce contexte. Colonne de
  /// TRANSITION, assumée. La matrice est déjà data-driven **par emplacement**
  /// (clé = identifiant) ; ce qui reste fixe, ce sont les **modes** d'un
  /// emplacement (`emporter` / `surPlace`) et le drapeau `b2b`. Le contexte doit
  /// donc dire lequel des trois le porte. Cette colonne disparaît quand un
  /// emplacement vendra des contextes au lieu de deux modes nommés.
  channelKey String @map("channel_key")

  /// Le contexte est-il **en service** ? Un contexte hors service ne se règle
  /// plus à l'écran et ne facture plus. Explicite, jamais implicite : la TVA est
  /// de l'argent, et un contexte activé par accident facture faux.
  active Boolean @default(false)

  /// Shopify en fait-il un produit ? **Distinct de `active`**, et la distinction
  /// n'est pas théorique : le B2B est en service — il facture ses professionnels
  /// — sans que la boutique en ligne ait à porter un second produit par article.
  /// Les confondre activerait des handles `-b2b` le jour où on règle un taux B2B.
  shopifyProjected Boolean @default(false) @map("shopify_projected")

  position Int @default(0)

  categoryVat CategoryContextVat[]
  productVat  ProductContextVat[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_context")
  @@schema("pim")
}

/// Le taux d'une famille **pour un contexte**. Clé composite : une famille ne
/// peut pas porter deux taux pour le même contexte, et c'est structurel.
///
/// **L'absence de ligne est la donnée** : « non réglé » ne s'écrit pas, il ne
/// s'écrit rien (cf. `data-model/04`, motif de la clé partagée).
model CategoryContextVat {
  categoryId String       @map("category_id")
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  contextId  String       @map("context_id")
  context    SalesContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  vatRateId  String       @map("tva_rate_id")
  /// `Restrict` (défaut) : un taux visé par une famille ne peut pas disparaître.
  vatRate    VatRate      @relation(fields: [vatRateId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([categoryId, contextId])
  @@index([vatRateId])
  @@map("category_context_tva")
  @@schema("pim")
}

model VatRate {
  id          String @id
  name        String
  description String @default("")
  /// UNIQUE, et c'est l'invariant fiscal : deux taux au même taux n'ont pas
  /// de sens. L'unicité portait avant sur le `tag` Shopify dérivé du taux — le
  /// référentiel faisait donc tenir une règle comptable par une collision de
  /// handles de canal.
  percent     Float  @unique

  /// Familles qui visent ce taux, **par contexte** — l'autre extrémité de la
  /// jointure. Aucune colonne ajoutée ici ; sert le mur `Restrict` à la
  /// suppression, et le compte d'usages que l'écran affiche avant de proposer
  /// de supprimer.
  contextVat CategoryContextVat[]

  /// Produits qui DÉROGENT à leur famille pour viser ce taux. Comptés eux aussi
  /// dans les usages : un taux visé par une seule fiche ne se supprime pas plus
  /// qu'un taux visé par une famille.
  productVat ProductContextVat[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tva_rate")
  @@schema("pim")
}

/// Un **emplacement** (boutique / point de vente) et ses modes. S'il fait « sur
/// place », il ouvre une grille de tables click & collect (une URL + un QR par
/// table). Contexte `locations` — aucune dépendance au catalogue.
model Location {
  id           String  @id
  name         String
  /// Vente à emporter en ligne.
  clickCollect Boolean @default(false) @map("click_collect")
  /// Consommation sur place — ouvre les tables.
  surPlace     Boolean @default(false) @map("sur_place")
  /// URL de base du click & collect (`baseUrl?table=N&k=token`).
  baseUrl      String  @default("") @map("base_url")

  tables LocationTable[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("emplacement")
  @@schema("pim")
}

/// Une **table** d’un emplacement sur place. Le `number` est verrouillé (identité
/// de l'URL) : clé primaire composite `(location, number)`. Suppression en
/// cascade avec l’emplacement.
model LocationTable {
  locationId String   @map("emplacement_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  number     Int
  qrCreated  Boolean  @default(false) @map("qr_created")
  /// Token rotatif du QR : le régénérer invalide l'ancien code imprimé.
  /// `NULL` = aucun QR généré.
  token      String?

  @@id([locationId, number])
  @@map("emplacement_table")
  @@schema("pim")
}

model Product {
  id         String           @id
  sku        String           @unique
  slug       Json
  kind       ProductKind
  name       Json
  categoryId String           @map("category_id")
  category   Category         @relation(fields: [categoryId], references: [id])
  status     ProductStatus    @default(draft)
  attributes Json             @default("{}")
  variants   ProductVariant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  /// Couche éditoriale — satellite **optionnel** (PK = FK, ADR-13) : la ligne
  /// n'existe que si quelqu'un a écrit quelque chose.
  editorial ProductEditorial?
  media     ProductMedia[]

  /// Les taux propres à CE produit, par contexte. Absence = il hérite.
  contextVat ProductContextVat[]

  /// Où cette fiche se vend, quand elle ne suit PAS sa famille.
  ///
  /// `NULL` = elle hérite, et c'est le cas courant. Une matrice à moitié
  /// redéfinie ne se lit pas — devant une case vide, on ne saurait pas dire si
  /// la fiche n'est pas vendue là ou si sa famille ne l'y vendait pas — d'où le
  /// tout-ou-rien, marqué par le `NULL` lui-même.
  ///
  /// Une colonne `jsonb`, comme `category.channel_preset` : une dérogation doit
  /// avoir exactement la forme de ce qu'elle remplace, et suivre son sort. La
  /// matrice est déjà indexée par emplacement ; seuls ses **modes** restent
  /// nommés en dur (C0-d).
  channelOverride Json? @map("channel_override")

  /// Relations virtuelles — la clé étrangère est portée par le binding (ADR-13).
  shopifyBinding ShopifyProductBinding?
  b2bBinding     B2bChannelBinding?

  @@index([categoryId])
  @@map("product")
  @@schema("pim")
}

/// Le taux qu'un **produit** vise pour un contexte — la dérogation à sa famille.
///
/// Même forme que `category_context_tva`, un cran plus bas, et la même règle :
/// **l'absence de ligne est la donnée**. Pas de ligne = le produit hérite ; une
/// ligne = il déroge, et c'est un fait qu'on peut dater et retirer.
///
/// Ce n'est PAS une colonne sur `product` : trois colonnes fixes sont
/// exactement ce que la famille vient de perdre.
model ProductContextVat {
  productId String       @map("product_id")
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  contextId String       @map("context_id")
  context   SalesContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  vatRateId String       @map("tva_rate_id")
  /// `Restrict` : un taux visé par un produit ne disparaît pas sous lui.
  vatRate   VatRate      @relation(fields: [vatRateId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([productId, contextId])
  @@index([vatRateId])
  @@map("product_context_tva")
  @@schema("pim")
}

model ProductVariant {
  id             String  @id
  productId      String  @map("product_id")
  product        Product @relation(fields: [productId], references: [id])
  sku            String  @unique
  name           Json
  options        Json    @default("{}")
  isDefault      Boolean @default(false) @map("is_default")
  isDiscontinued Boolean @default(false) @map("is_discontinued")
  position       Int     @default(0)
  attributes     Json    @default("{}")

  /// Prix **canonique** de l'unité réellement vendue (R4) — tarif de référence,
  /// HT, en centimes d'euro, **pré-altération**. `NULL` = pas encore tarifé. Les
  /// dégressifs de volume et remises vivent dans la couche pricing B2B, jamais
  /// ici (cf. documentation/architecture-conditionnements-pricing.md).
  priceCents  Int? @map("price_cents")
  /// Poids net de l'unité vendue, en grammes. Fait physique de la déclinaison.
  weightGrams Int? @map("weight_grams")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  /// Conditionnements — les unités de vente en VOLUME qui emballent cette
  /// déclinaison. Rattachés ici et non au produit : « carton de 20 » ne veut
  /// rien dire tant qu'on ne sait pas de quoi (des parts, ou des tartes 6
  /// parts ?). La relation EST l'information — cf. la révision du 2026-08-23
  /// de `documentation/b2b/architecture-conditionnements-pricing.md`, qui
  /// renverse le choix initial de les modéliser en déclinaisons plates.
  packagings ProductPackaging[]

  /// Fiche réglementaire — **optionnelle** (`o|`) : son absence signifie
  /// « pas encore renseigné ». Un 1:1 obligatoire forcerait une ligne vide à la
  /// création, donc affirmerait « aucun allergène » sans vérification. La garde
  /// est ailleurs : pas de publication sans fiche (doc 03).
  nutrition NutritionDeclaration?

  /// Relation **virtuelle** : aucune colonne n'est ajoutée ici. La clé étrangère
  /// physique est portée par `shopify_variant_binding` — le sens imposé par ADR-13
  /// (le socle ne pointe jamais vers un canal). Prisma exige seulement de déclarer
  /// l'autre extrémité.
  shopifyBinding ShopifyVariantBinding?

  @@index([productId])
  @@map("product_variant")
  @@schema("pim")
}

/// Les formes d'emballage vendues en volume.
enum PackagingType {
  carton
  sac
  plateau

  @@schema("pim")
}

/// Le **conditionnement** — une unité de vente en volume qui emballe une
/// déclinaison. Trois faits lui sont propres, et c'est ce qui en fait une
/// entité plutôt qu'un attribut :
///
///  · le poids **BRUT**, emballage inclus. Il ne se déduit PAS du poids net de
///    la déclaration nutritionnelle : un carton de 20 parts pèse 20 × le net,
///    plus le carton, les intercalaires et le film. Sans lui, pas d'expédition.
///  · le **prix canonique**. Un carton de 20 ne vaut pas 20 × l'unité — c'est le
///    principe même de la vente en volume, et un prix dérivé ne saurait pas
///    exprimer la remise de gros qui justifie le conditionnement.
///  · les **canaux**. Un plateau de 6 se vend à emporter ; hériter de la famille
///    rendrait ce cas inexprimable.
///
/// Le libellé n'est PAS stocké : il se dérive de `type` × `quantity`. Le
/// stocker rouvrirait la porte à « Carton 20 » et « carton de 20 » pour la
/// même chose.
model ProductPackaging {
  id        String         @id
  variantId String         @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  /// Le pro commande par référence — elle est donc unique, comme celle d'une
  /// déclinaison.
  sku       String         @unique
  type      PackagingType
  /// Nombre d'unités emballées. Entier > 0 : zéro n'emballe rien (l'invariant
  /// vit dans l'entité, la base ne sait pas l'exprimer).
  quantity  Int

  /// Poids BRUT en grammes, emballage inclus. `NULL` = non renseigné, et donc
  /// non expédiable.
  grossWeightGrams Int?     @map("gross_weight_grams")
  /// Prix canonique HT en centimes, **pré-altération** : le dégressif de volume
  /// et les remises vivent dans la couche pricing B2B, jamais ici.
  priceCents       Int?     @map("price_cents")
  /// Canaux de vente propres. `[]` = aucun, donc invendable.
  channels         String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@index([variantId])
  @@map("product_packaging")
  @@schema("pim")
}

// ---------------------------------------------------------------------------
// Canal Shopify — tables possédées par l'ADAPTATEUR (ADR-13).
// Non event-sourçables : ce sont des états de synchro re-dérivables, pas des
// faits métier. Elles peuvent être perdues et reconstruites par un re-push.
// ---------------------------------------------------------------------------

enum ShopifySyncStatus {
  never_pushed
  up_to_date
  drifted
  failed

  @@schema("pim")
}

/// Le mode du canal au moment d'une poussée — figé dans le snapshot pour qu'on
/// sache *comment* il a été produit (une simulation n'est pas une poussée réelle).
enum ShopifyChannelMode {
  live
  dry_run

  @@schema("pim")
}

/// L'issue d'une poussée telle qu'inscrite dans l'historique.
enum ShopifyPushOutcome {
  pushed
  failed

  @@schema("pim")
}

/// Réglages de l'intégration — ligne unique.
/// ⚠️ Aucun secret ici : le jeton d'API vit dans l'environnement (`AppConfig`).
model ShopifySettings {
  id         String   @id
  shopDomain String   @map("shop_domain")
  apiVersion String   @map("api_version")
  isEnabled  Boolean  @default(false) @map("is_enabled")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("shopify_settings")
  @@schema("pim")
}

/// État de synchro d'un **produit** — Shopify pousse un produit et ses variantes
/// ensemble, donc l'empreinte et le statut vivent à ce niveau. Les *références*,
/// elles, restent sur la déclinaison (R4) : ce sont deux choses différentes.
model ShopifyProductBinding {
  productId String  @id @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  shopifyProductGid String?           @map("shopify_product_gid")
  lastPushedHash    String?           @map("last_pushed_hash")
  lastPushedAt      DateTime?         @map("last_pushed_at")
  syncStatus        ShopifySyncStatus @default(never_pushed) @map("sync_status")
  lastError         String?           @map("last_error")

  /// Le snapshot **head** = le BASE de la réconciliation (la dernière poussée réelle).
  /// `NULL` tant que rien n'a été poussé en `live`.
  headSnapshotId String? @map("head_snapshot_id")

  @@map("shopify_product_binding")
  @@schema("pim")
}

/// Historique **append-only** des poussées réelles d'un `handle` — l'ancêtre commun
/// (BASE) de la réconciliation à trois voies et la matière du rollback. Voir
/// [`publication-reconciliation-3way.md`](../../../documentation/lfc/publication-reconciliation-3way.md).
///
/// Contrairement aux bindings (états de synchro re-dérivables), ceci est un **journal** :
/// le perdre efface l'historique et le retour arrière. Jamais muté après écriture — un
/// rollback ré-écrit une **nouvelle** ligne (une copie d'une version antérieure).
model ShopifyPushSnapshot {
  id        String             @id @default(uuid())
  /// L'unité de réconciliation (identité Shopify) — survit à la bascule fiche×mode.
  handle    String             @map("handle")
  /// Le produit PIM d'où venait la projection (peut projeter N handles à terme).
  productId String             @map("product_id")
  /// Numéro de version monotone par handle (1..n).
  version   Int                @map("version")
  hash      String             @map("hash")
  /// `ShopifyProductPayload` rejouable tel quel — document figé, pas relationnel.
  payload   Json               @map("payload")
  mode      ShopifyChannelMode @map("mode")
  outcome   ShopifyPushOutcome @map("outcome")
  pushedAt  DateTime           @default(now()) @map("pushed_at")

  @@unique([handle, version])
  @@index([handle])
  @@map("shopify_push_snapshot")
  @@schema("pim")
}

/// Ce que Shopify sait d'une **déclinaison** — l'unité réellement vendue (R4).
model ShopifyVariantBinding {
  variantId String         @id @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  /// Référence propre au canal. `NULL` = le SKU interne est poussé tel quel.
  /// L'index unique **est** l'unicité par canal : la table étant le canal, aucun
  /// discriminant n'est nécessaire.
  channelReference  String? @unique @map("channel_reference")
  shopifyVariantGid String? @map("shopify_variant_gid")

  @@map("shopify_variant_binding")
  @@schema("pim")
}

/// Fiche réglementaire d'une **déclinaison** — c'est elle qui est mise sur le
/// marché (doc 03). `variant_id` est PK **et** FK (*shared primary key*) : pas
/// d'identifiant de substitution, donc deux fiches sont structurellement
/// impossibles pour une même déclinaison.
model NutritionDeclaration {
  variantId String         @id @map("variant_id")
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  /// Codes GS1 canoniques. `[]` = déclaration positive « aucun allergène »,
  /// à ne pas confondre avec l'absence de ligne (= non renseigné).
  allergens     Json
  mayContain    Json   @default("[]") @map("may_contain")
  energyKcal    Float? @map("energy_kcal")
  carbsG        Float? @map("carbs_g")
  fatG          Float? @map("fat_g")
  proteinG      Float? @map("protein_g")
  glycemicIndex Float? @map("glycemic_index")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("nutrition_declaration")
  @@schema("pim")
}

// ---------------------------------------------------------------------------
// Couche éditoriale (doc 01). Rythme de vie propre : change à chaque saison,
// là où l'identité ne bouge jamais. D'où une table séparée, pas des colonnes.
// ---------------------------------------------------------------------------

enum MediaRole {
  hero
  gallery
  lifestyle
  thumbnail
  print

  @@schema("pim")
}

model ProductEditorial {
  productId String  @id @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  descriptionShort Json?   @map("description_short")
  descriptionLong  Json?   @map("description_long")
  story            Json?
  pairing          Json?
  brand            String?
  seoTitle         Json?   @map("seo_title")
  seoDescription   Json?   @map("seo_description")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_editorial")
  @@schema("pim")
}

/// Agrégat propre : un visuel a son cycle de vie (upload, CDN) et peut servir
/// plusieurs produits. On stocke le **master** + un point focal ; les tailles
/// dérivées sont calculées par chaque canal, jamais ressaisies.
/// Un visuel. `url` est ce que consomment le front et les canaux ; le reste
/// décrit l'objet, et n'est renseigné que pour ce que NOUS hébergeons.
///
/// Les colonnes techniques sont toutes nullables, et c'est le modèle : une URL
/// saisie à la main (tout ce qui existait avant le stockage média) n'a ni clé,
/// ni type constaté, ni dimensions. `null` veut dire « pas mesuré », jamais
/// « zéro » — un consommateur ne doit pas le coercer en taille.
model MediaAsset {
  id  String @id
  url String
  alt Json

  /// L'étiquette de la bibliothèque — courte, non traduite, faite pour
  /// RETROUVER. Distincte du texte alternatif, qui décrit l'image à qui ne la
  /// voit pas : deux informations, deux publics. Vide tant que personne n'a
  /// nommé le fichier.
  name   String @default("")
  focalX Float? @map("focal_x")
  focalY Float? @map("focal_y")

  /// La clé dans le bucket média — `products/{sha256}.{ext}`. `null` ⇒ l'octet
  /// n'est pas chez nous. C'est par elle qu'un ramassage d'orphelins saura un
  /// jour quel objet R2 plus aucune fiche ne référence.
  storageKey  String? @map("storage_key")
  /// Type MIME **constaté dans les octets** au dépôt, jamais annoncé.
  contentType String? @map("content_type")
  /// Taille intrinsèque, lue dans l'en-tête au dépôt. Sans elle, une galerie ne
  /// peut pas réserver sa place et la fiche saute au chargement des images.
  width       Int?
  height      Int?
  bytes       Int?

  products ProductMedia[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([url])
  @@map("media_asset")
  @@schema("pim")
}

/// Table de liaison dédiée — **pas** de FK polymorphe (`owner_type`/`owner_id`),
/// qui priverait Postgres de toute intégrité référentielle (doc 01).
model ProductMedia {
  productId String     @map("product_id")
  mediaId   String     @map("media_id")
  product   Product    @relation(fields: [productId], references: [id])
  media     MediaAsset @relation(fields: [mediaId], references: [id])
  role      MediaRole
  position  Int        @default(0)

  @@id([productId, mediaId])
  @@index([productId])
  @@map("product_media")
  @@schema("pim")
}

// ---------------------------------------------------------------------------
// Canal **plateforme B2B** — table possédée par l'ADAPTATEUR (ADR-13). Le socle
// ne pointe jamais vers un canal : la clé étrangère est portée ici.
// Re-dérivable par un re-push ; ce n'est pas un fait métier, c'est un état de
// synchro — SAUF la décision de publication elle-même, qui n'existe qu'ici.
// ---------------------------------------------------------------------------

/// L'**appartenance d'un produit au canal B2B** : sa présence dit « vendu aux
/// pros », son absence dit le contraire. Un état de publication (`published`)
/// ne suffirait pas — il confondrait « publié chez Shopify » et « vendu aux
/// pros », et les deux catalogues ne pourraient jamais diverger.
///
/// Dépublier **supprime la ligne**. Le produit disparaîtra du prochain snapshot,
/// et le récepteur le nommera dans son rapport (`removedSkus`) : la nouvelle est
/// portée par le push, pas par un drapeau qu'il faudrait penser à relire.
model B2bChannelBinding {
  productId String  @id @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Quand ce produit a rejoint le canal, et par qui. La question posée six mois
  /// plus tard est toujours « qui a mis ça en vente ».
  publishedAt DateTime @default(now()) @map("published_at")
  publishedBy String?  @map("published_by")

  /// Dernière poussée **réellement acceptée** par la plateforme. `NULL` = publié
  /// mais jamais parti — l'écart que l'écran doit montrer.
  lastPushedAt DateTime? @map("last_pushed_at")

  @@map("b2b_channel_binding")
  @@schema("pim")
}
