{
  "name": "lfd-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "free-port": "lsof -ti:3200 | xargs kill 2>/dev/null; true",
    "start:dev": "pnpm run free-port && nest start --watch",
    "start:debug": "pnpm run free-port && nest start --debug --watch",
    "start:prod": "node dist/main",
    "dev": "pnpm run free-port && nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=6144\" NODE_ENV=test jest --runInBand --forceExit",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=6144\" NODE_ENV=test jest -c jest.unit.cjs",
    "e2e:rebalance": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=6144\" NODE_ENV=test E2E_DURATIONS_OUT=test/e2e-durations.json E2E_WORKERS=1 jest -c jest.e2e.cjs --forceExit",
    "test:e2e": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=2048\" NODE_ENV=test jest -c jest.e2e.cjs --forceExit",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --watch --runInBand",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:fiche": "tsx prisma/seed-fiche.ts",
    "db:test:setup": "tsx test/setup-test-database.ts",
    "db:dev:setup": "tsx prisma/setup-dev-database.ts",
    "db:dev:clone": "tsx prisma/clone-dev.ts",
    "seed:growth": "NODE_ENV=development TS_NODE_TRANSPILE_ONLY=1 node --no-warnings --loader ts-node/esm prisma/seed-growth.ts",
    "seed:growth:reset": "NODE_ENV=development TS_NODE_TRANSPILE_ONLY=1 node --no-warnings --loader ts-node/esm prisma/reset-growth.ts",
    "backfill:naf": "NODE_ENV=development TS_NODE_TRANSPILE_ONLY=1 node --no-warnings --loader ts-node/esm prisma/backfill-naf.ts",
    "seed:temoin": "NODE_ENV=development TS_NODE_TRANSPILE_ONLY=1 node --no-warnings --loader ts-node/esm prisma/seed-temoin-orders.ts",
    "db:pim:seed": "tsx --env-file=.env prisma/pim-seed.ts"
  },
  "dependencies": {
    "@lfd/money": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@lfd/catalog-sync": "workspace:*",
    "@lfd/contracts": "workspace:*",
    "@lfd/endpoints": "workspace:*",
    "@lfd/mailer": "workspace:*",
    "@lfd/ops-contract": "workspace:*",
    "@lfd/pim-contracts": "workspace:*",
    "@lfd/shopify-admin": "workspace:*",
    "@lfd/storage": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/cqrs": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.3",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "stripe": "^22.4.0",
    "ulid": "^2.3.0",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "catalog:",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@types/express": "^5.0.0",
    "@types/jest": "catalog:",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.4.7",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "catalog:",
    "globals": "catalog:",
    "jest": "catalog:",
    "pg": "^8.22.0",
    "prettier": "catalog:",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "catalog:",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "wrangler": "catalog:"
  }
}
