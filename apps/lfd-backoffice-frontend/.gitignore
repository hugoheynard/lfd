# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log

# Angular / build caches
/.angular
.angular/

# IDEs and editors
.idea/
.project
.classpath
.settings/
*.launch
*.sublime-workspace

# Misc
.DS_Store
Thumbs.db

# Playwright (tests e2e navigateur) — artefacts de run, jamais versionnés.
/test-results
/playwright-report
/blob-report

# Coque native (Capacitor) — GÉNÉRÉE, jamais versionnée.
# `pnpm ios:add` la refait à l'identique : l'identifiant et le nom d'app
# viennent de `capacitor.config.ts`, et les icônes de `resources/` via
# `pnpm cap:icons`. Ce qu'un Xcode local y ajoute (équipe de signature, profils)
# est propre à la machine et n'a rien à faire dans le dépôt.
/ios
/android
