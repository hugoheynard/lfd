{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "lfd-backoffice-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss",
              {
                "input": "node_modules/maplibre-gl/dist/maplibre-gl.css",
                "bundleName": "maplibre-gl",
                "inject": false
              }
            ],
            "allowedCommonJsDependencies": ["jsqr", "maplibre-gl"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1250kB",
                  "maximumError": "1300kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "*.pmtiles",
                  "input": "map-tiles",
                  "output": "map-tiles"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/api/api-config.ts",
                  "with": "src/app/api/api-config.dev.ts"
                },
                {
                  "replace": "src/app/dev/dev-tools.ts",
                  "with": "src/app/dev/dev-tools.dev.ts"
                },
                {
                  "replace": "src/app/livraison/map-tiles.config.ts",
                  "with": "src/app/livraison/map-tiles.config.dev.ts"
                }
              ]
            },
            "cloudflare": {
              "outputMode": "static",
              "ssr": false,
              "server": false,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1250kB",
                  "maximumError": "1300kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kB",
                  "maximumError": "10kB"
                }
              ]
            },
            "e2e": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/app/api/api-config.ts",
                  "with": "src/app/api/api-config.dev.ts"
                },
                {
                  "replace": "src/app/auth/auth.env.generated.ts",
                  "with": "src/app/auth/auth.env.e2e.ts"
                },
                {
                  "replace": "src/app/dev/dev-tools.ts",
                  "with": "src/app/dev/dev-tools.dev.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 7317,
            "host": "127.0.0.1",
            "prebundle": {
              "exclude": [
                "@lfd/b2b-ui",
                "@lfd/catalog-ui",
                "@lfd/contracts",
                "@lfd/endpoints",
                "@lfd/front-ops",
                "@lfd/money",
                "@lfd/ops-contract",
                "@lfd/pim-contracts",
                "@lfd/storefront-layout"
              ]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "lfd-backoffice-frontend:build:production"
            },
            "development": {
              "buildTarget": "lfd-backoffice-frontend:build:development"
            },
            "e2e": {
              "buildTarget": "lfd-backoffice-frontend:build:e2e"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "::development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "isolate": true
          }
        }
      }
    }
  }
}
