{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "lfc-ecommerce-frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.scss"],
            "security": {
              "allowedHosts": []
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1350kB",
                  "maximumError": "1600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "14kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/app/auth/dev-flags.ts",
                  "with": "src/app/auth/dev-flags.dev.ts"
                }
              ]
            },
            "cloudflare": {
              "outputMode": "static",
              "ssr": false,
              "server": false,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1050kB",
                  "maximumError": "1400kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kB",
                  "maximumError": "10kB"
                }
              ],
              "baseHref": "/"
            },
            "capacitor": {
              "outputMode": "static",
              "ssr": false,
              "server": false,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1050kB",
                  "maximumError": "1400kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "7kB",
                  "maximumError": "10kB"
                }
              ],
              "baseHref": "/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 7316,
            "host": "127.0.0.1"
          },
          "configurations": {
            "production": {
              "buildTarget": "lfc-ecommerce-frontend:build:production"
            },
            "development": {
              "buildTarget": "lfc-ecommerce-frontend:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "::development",
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "isolate": true,
            "include": ["**/*.spec.ts", "../preview/**/*.spec.ts"]
          }
        }
      }
    },
    "lfc-ecommerce-preview": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "preview",
      "sourceRoot": "preview",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/lfc-ecommerce-preview",
            "index": "preview/index.html",
            "browser": "preview/main.ts",
            "tsConfig": "tsconfig.preview.json",
            "inlineStyleLanguage": "scss",
            "outputMode": "static",
            "ssr": false,
            "server": false,
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "ignore": ["_redirects", "robots.txt", "manifest.webmanifest", "MANIFEST-README.md"]
              },
              {
                "glob": "**/*",
                "input": "preview/public"
              }
            ],
            "styles": ["src/styles.scss", "preview/preview.scss"],
            "security": {
              "allowedHosts": []
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "14kB"
                }
              ],
              "outputHashing": "all",
              "baseHref": "/",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "preview/environments/preview-environment.ts",
                  "with": "preview/environments/preview-environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 7318,
            "host": "127.0.0.1",
            "headers": {
              "Content-Security-Policy": "frame-ancestors http://localhost:7317 http://127.0.0.1:7317"
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "lfc-ecommerce-preview:build:production"
            },
            "development": {
              "buildTarget": "lfc-ecommerce-preview:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
