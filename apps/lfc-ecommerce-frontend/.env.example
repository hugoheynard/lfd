# Config Auth0 PUBLIQUE de la SPA « LFC B2B Platform » — injectée au BUILD.
#
# Dev local  : `cp .env.example .env` puis renseigne (ce .env est git-ignored).
# Déployé    : mets les MÊMES clés en variables de build (GitHub Actions / Cloudflare
#              Pages, dans le scope de CE projet). process.env gagne sur .env.
#
# Ces valeurs ne sont PAS des secrets : elles finissent dans le bundle navigateur.
# (Le seul secret Auth0 — le client secret M2M — vit côté BACKEND, jamais ici.)

# Tenant Auth0, sans https://
AUTH0_DOMAIN=lafoliedouce.eu.auth0.com

# Client ID de l'Application SPA (Auth0 → Applications → ta SPA → Settings)
AUTH0_CLIENT_ID=

# Identifier de l'API B2B Customer (= AUTH0_AUDIENCE du backend, match exact)
AUTH0_AUDIENCE=https://api.b2b.lafoliedouce.com

# Base URL du backend B2B appelé avec le jeton
API_BASE_URL=http://localhost:3200

# Origine de l'app ADMIN, sans barre finale. Sert à fabriquer l'URL qu'un QR de
# retrait encode : le client l'affiche, le staff la scanne, donc elle pointe vers
# le back-office. Vide ⇒ aucun QR affiché (plutôt qu'un code menant nulle part).
ADMIN_BASE_URL=http://127.0.0.1:7317
