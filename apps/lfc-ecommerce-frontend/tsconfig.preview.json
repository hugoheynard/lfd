/* L'application d'aperçu des textes (plan `plan-textes-de-la-boutique.md`, §10 B3).
   Elle compile ses propres fichiers ; les écrans de la boutique qu'elle importe
   suivent par leurs imports. L'inverse n'existe pas : `tsconfig.app.json`
   n'inclut que `src/`, et rien sous `src/` n'importe `preview/`. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["preview/**/*.ts"],
  "exclude": ["preview/**/*.spec.ts"]
}
