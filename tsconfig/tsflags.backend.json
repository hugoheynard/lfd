{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": ["esnext"],
    // TypeScript 6.0 a changé le défaut de `types` en `[]` : le compilateur ne
    // balaie plus `node_modules/@types` tout seul (~30 % du démarrage à froid).
    // Les globales Node (`fetch`, `Response`, `URLSearchParams`, `process`…) ne
    // sont donc plus là par accident — on les déclare, une fois, pour tous les
    // backs. Les configs de test ajoutent `"jest"` par-dessus.
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true
  }
}
